meta {
  name: HLS sessions
  type: http
  seq: 7
}

get {
  url: {{relayApi}}/v3/hlssessions/list
  body: none
  auth: none
}

tests {
  test("answers a list, or 404 where the listener is off", function () {
    if (res.getStatus() === 404) {
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}

docs {
  # HLS sessions

  The HLS readers, with the bytes sent and nothing else.

  A session is segment requests grouped by the relay rather than a connection held open, so there is no round trip, no loss and no drop counter to report.
}
