meta {
  name: MoQ sessions
  type: http
  seq: 8
}

get {
  url: {{relayApi}}/v3/moqsessions/list
  body: none
  auth: none
}

tests {
  test("answers a list, or 404 where the listener is off", function () {
    if (res.getStatus() === 404) {
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}

docs {
  # MoQ sessions

  The Media over QUIC subscribers, with the bytes sent and nothing else.

  The endpoint arrived in MediaMTX v1.20.0, so a relay older than that answers 404 here whatever its configuration says.
}
