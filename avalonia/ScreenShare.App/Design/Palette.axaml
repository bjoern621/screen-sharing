<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Greyscale ramp plus the three hues.
    Keys name roles and never values, so a light variant is a second dictionary rather than an edit in every view.
  -->

  <Color x:Key="Grey900">#141414</Color>
  <Color x:Key="Grey850">#181818</Color>
  <Color x:Key="Grey800">#1C1C1C</Color>
  <Color x:Key="Grey750">#212121</Color>
  <Color x:Key="Grey700">#262626</Color>
  <Color x:Key="Grey650">#2A2A2A</Color>
  <Color x:Key="Grey600">#303030</Color>
  <Color x:Key="Grey550">#3A3A3A</Color>
  <Color x:Key="Grey500">#4A4A4A</Color>
  <Color x:Key="Grey450">#565656</Color>
  <Color x:Key="Grey400">#6E6E6E</Color>
  <Color x:Key="Grey300">#9A9A9A</Color>
  <Color x:Key="Grey200">#C8C8C8</Color>
  <Color x:Key="Grey150">#D0D0D0</Color>
  <Color x:Key="Grey100">#E6E6E6</Color>
  <Color x:Key="Grey050">#F2F2F2</Color>
  <Color x:Key="White">#FFFFFF</Color>

  <!--
    Three hues, one question each (docs/design-language.md, "Palette").
    Never state that is merely on, and never selection, which is inversion.
  -->
  <!-- Broken, or on air. -->
  <Color x:Key="Attention">#E5484D</Color>
  <!-- It runs, and something about it disappoints. Too light for a white label, so a fill of it takes near-black. -->
  <Color x:Key="Caution">#FFB224</Color>
  <!-- The way is clear. -->
  <Color x:Key="Go">#30A46C</Color>

  <!--
    Fluent's accent keys, pointed at the one light surface.
    A slider's fill, a focus ring and a text selection read them, and left alone they paint the platform's blue.
  -->
  <Color x:Key="SystemAccentColor">#F2F2F2</Color>
  <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorDark1">#E6E6E6</Color>
  <Color x:Key="SystemAccentColorDark2">#D0D0D0</Color>
  <Color x:Key="SystemAccentColorDark3">#C8C8C8</Color>

  <!-- Surfaces  -->

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Grey850}" />
  <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource Grey750}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Grey800}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Grey750}" />
  <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource Grey650}" />
  <!--
    Hover and press are this module's decision, not the design's.
    Both are steps of the ramp above, so no value enters the palette,
    and a pressed control reads darker than the surface it lifts off.
  -->
  <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource Grey600}" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource Grey700}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource Grey050}" />
  <!-- Black in a light variant too: video defines its own background. -->
  <SolidColorBrush x:Key="TileBrush" Color="{StaticResource Grey900}" />

  <!-- Lines  -->

  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Grey700}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Grey600}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource Grey550}" />
  <SolidColorBrush x:Key="ChipBorderBrush" Color="{StaticResource Grey500}" />

  <!-- Text  -->

  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource White}" />
  <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource Grey100}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Grey200}" />
  <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource Grey150}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Grey300}" />
  <SolidColorBrush x:Key="HintBrush" Color="{StaticResource Grey400}" />
  <!-- Whole unavailable treatment, here and everywhere: a colour change, nothing else. -->
  <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource Grey450}" />
  <!-- Why something is inert, read off a surface whose own text has gone to the disabled grey. -->
  <SolidColorBrush x:Key="ReasonBrush" Color="{StaticResource Caution}" />
  <SolidColorBrush x:Key="OnSelectedBrush" Color="{StaticResource Grey900}" />

  <!-- Hues -->

  <SolidColorBrush x:Key="AttentionBrush" Color="{StaticResource Attention}" />
  <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource Caution}" />
  <SolidColorBrush x:Key="GoBrush" Color="{StaticResource Go}" />
  <!-- What a label on an amber fill takes, the hue being lighter than the text roles above. -->
  <SolidColorBrush x:Key="OnCautionBrush" Color="{StaticResource Grey900}" />

  <!-- Elevation  -->

  <!--
    One shadow the app draws, for the surface that floats over the window:
    a menu, and the tooltip skinned like one.
    A window's is the platform's, cast around the frame by the compositor.
    BoxShadows rather than a brush, that being the type the setter takes.
  -->
  <BoxShadows x:Key="MenuShadow">0 10 28 0 #8C000000</BoxShadows>

  <!--
    Behind a dialog drawn over the window, dimming what it covers without hiding it:
    the reader keeps the window they came from in view, and every press lands on the dialog.
    Black at 60 percent rather than a grey of the palette, a scrim darkening whatever is under it
    rather than painting a surface of its own.
  -->
  <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />

</ResourceDictionary>
