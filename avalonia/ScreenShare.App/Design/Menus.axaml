<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ti="using:TablerIcons">

  <!--
    One definition for every menu in the product.
    A tile's right-click menu, a rail entry's, and a dropdown's option list are one object.
    The themes are keyed on the types, so a menu wears the design by existing,
    and a view that has to opt in is a view that can forget to.
    Rows read the pseudo-classes MenuItem raises (:icon, :checked, :open) and not bindings against the item,
    which is what lets these themes keep compiled bindings on.
    The option list is the one menu whose rows bind against an item type, and its two setters stay
    where that type is known (Controls/Select/Select.axaml).
  -->

  <!--
    A panel that floats: the panel radius, and the one shadow the design draws.
    The padding keeps a hovered row's fill off the border,
    where a filled box drawn hard against a 1px edge reads as a rendering fault.
  -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="Padding" Value="{StaticResource InsetMenu}" />
    <!-- Only the option list grows long enough to scroll. A right-click menu never reaches this. -->
    <Setter Property="MaxHeight" Value="360" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{StaticResource MenuShadow}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    One row, five columns, drawing the ones it has: a glyph, the words, the key, the state, a submenu's chevron.
    The glyph and key columns close on a row that carries neither rather than reserving an indent nothing fills,
    so what lines up down a menu is the group of rows that agree about carrying one.
    The key is display only.
    Avalonia hands InputGesture to the template and nowhere else, so whatever acts on a key acts on it
    where the menu is closed (Features/Viewer/Tile/View/TileKeys.cs).
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

              <ContentPresenter Name="Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                IsVisible="False" />

              <!--
                ContentTemplate is what an ItemTemplate travels through.
                Without it the presenter holds a view model and no template,
                falls back to ToString, and prints the record's field dump.
              -->
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" />

              <!--
                Hidden rather than empty.
                A hidden control is not measured, and an empty one spends its margin on every row naming no key.
              -->
              <TextBlock Name="Gesture"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture}"
                         IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Margin="18,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource HintBrush}"
                         FontSize="{StaticResource FontSizeSmall}" />

              <ti:TablerIcon Name="Tick"
                             Grid.Column="3"
                             Icon="IconCheck"
                             Margin="12,0,0,0"
                             Brush="{StaticResource ForegroundBrush}"
                             IsVisible="False" />

              <!--
                Drawn by default and taken away by :empty.
                HasSubMenu is a plain CLR property with no notification behind it,
                so a binding on it would be read once and never again.
              -->
              <ti:TablerIcon Name="Chevron"
                             Grid.Column="4"
                             Icon="IconChevronRight"
                             Margin="9,0,0,0"
                             Brush="{StaticResource MutedBrush}" />
            </Grid>
          </Border>

          <!--
            The submenu states its own surface: the theme above draws a MenuFlyoutPresenter,
            and a nested menu is an ItemsPresenter in a popup.
            Both name the same four tokens, so neither drifts to a shape the other has not got.
          -->
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 IsLightDismissEnabled="False"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="5">
            <Border Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}"
                    Padding="{StaticResource InsetMenu}"
                    BoxShadow="{StaticResource MenuShadow}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                            MaxHeight="360">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:empty /template/ ti|TablerIcon#Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:checked /template/ ti|TablerIcon#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--
      One fill for the pointer and for the keyboard,
      so a row under the pointer and a row the arrows reached look alike.
      A row holding its submenu open keeps that fill, which is what says where the submenu came from.
    -->
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>

    <!--
      A refused row keeps its place and greys, since the configuration that would allow it is a neighbouring one
      (docs/field-availability.md, "One option disabled with a reason").
    -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#Icon">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- The key sets its own colour, so a greyed row does not reach it. -->
    <Style Selector="^:disabled /template/ TextBlock#Gesture">
      <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    A figure printed in a menu, and not a row that refused to act.
    Greying is reserved for an action a configuration took away,
    so a reading is inert instead: hint weight, no fill under the pointer, out of the keyboard's path.
  -->
  <ControlTheme x:Key="MenuNote" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="MinHeight" Value="{StaticResource TextRowHeight}" />
    <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </ControlTheme>

  <!-- Inset so the rule stops short of the surface's rounded corners rather than running into them. -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="9,5" />
    <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
