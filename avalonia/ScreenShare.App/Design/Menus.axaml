<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ti="using:TablerIcons">

  <!--
    The menu, as one definition for every menu in the product.

    A right-click menu on a tile, a right-click menu on a rail entry and a dropdown's option
    list are the same object: a floating surface, a run of rows, and a divider between groups.
    There were three of them before this - two wearing Fluent, because nothing had ever
    restyled MenuItem, and one wearing a private copy of the surface in Controls/Select - and
    the three disagreed about padding, radius, hover, and whether a menu casts a shadow at all.

    The themes are keyed on the types, so a menu wears the design by existing. A view that has
    to opt in is a view that can forget to, and the two that forgot are how a Fluent menu
    survived in a product whose design states that it has none.

    The rows read their state from the pseudo-classes MenuItem raises - :icon, :checked, :open -
    rather than from bindings against the item, which is what lets these themes keep compiled
    bindings on. The option list is the one menu whose rows bind against an item type, and its
    two setters stay where that type is known (Controls/Select/Select.axaml).
  -->

  <!--
    The surface. A panel that floats, so it takes the panel radius and the one shadow the
    design draws.

    The padding is what keeps a hovered row's fill off the border: a row lights up as a filled
    rounded box, and a box drawn hard against a 1px edge reads as a rendering fault rather than
    as a highlight.
  -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="Padding" Value="{StaticResource InsetMenu}" />
    <!-- A list long enough to scroll is the option list; a right-click menu never reaches it. -->
    <Setter Property="MaxHeight" Value="360" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{StaticResource MenuShadow}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    One row.

    Five columns, and a row draws only the ones it has: a glyph naming the row, the words, the
    key that does the same thing, the state the row is in, and a submenu's chevron. The glyph
    column closes on a row that has no glyph rather than reserving an indent nothing fills, so
    what lines up down a menu is a group of rows that agree about carrying one, and the key
    column closes the same way.

    The key is printed as a reading rather than as part of the label, in hint weight at the quiet
    end of the row: it answers a question the reader did not open the menu with. It is display
    only. Avalonia hands InputGesture to the template and to nothing else, so whatever acts on the
    key acts on it somewhere the menu is closed (Features/Viewer/Tile/View/TileKeys.cs).

    A row that toggles something keeps its words and shows the state as a tick at the end
    (docs/design-language.md, "Selection"). Rewriting the label to name the inverse action costs
    the reader the one cheap answer a menu can give - which of these are on - and it leaves the
    row unreadable at rest, because "Unmute" on a muted stream and "Mute" on an audible one are
    the same handful of pixels read in opposite directions.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

              <!--
                The glyph names the row and holds still while the row's state moves. A glyph
                that swapped with the state would be a second copy of what the tick already
                says, and it would change the shape a reader navigates the menu by.
              -->
              <ContentPresenter Name="Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                IsVisible="False" />

              <!--
                ContentTemplate is what an ItemTemplate travels through. Without it the
                presenter holds a view model and no template to draw it with, falls back to
                ToString, and the menu prints the record's field dump.
              -->
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" />

              <!--
                The key, on the rows that have one. Hidden rather than empty, because a hidden
                control is not measured and an empty one would spend its margin on every row in
                the product that names no key.
              -->
              <TextBlock Name="Gesture"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture}"
                         IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Margin="18,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource HintBrush}"
                         FontSize="{StaticResource FontSizeSmall}" />

              <ti:TablerIcon Name="Tick"
                             Grid.Column="3"
                             Icon="IconCheck"
                             Margin="12,0,0,0"
                             Brush="{StaticResource ForegroundBrush}"
                             IsVisible="False" />

              <!--
                Drawn by default and taken away by :empty rather than the other way round.
                HasSubMenu is a plain CLR property with no notification behind it, so a
                binding on it would be read once and then never again; the pseudo-class is
                the only form of the fact that moves when a submenu's items arrive.
              -->
              <ti:TablerIcon Name="Chevron"
                             Grid.Column="4"
                             Icon="IconChevronRight"
                             Margin="9,0,0,0"
                             Brush="{StaticResource MutedBrush}" />
            </Grid>
          </Border>

          <!--
            The submenu. Its surface is stated here rather than reached for, because the
            presenter theme above draws a MenuFlyoutPresenter and a nested menu is an
            ItemsPresenter in a popup; both name the same four tokens, so neither can drift to
            a shape the other does not have.
          -->
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 IsLightDismissEnabled="False"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="5">
            <Border Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}"
                    Padding="{StaticResource InsetMenu}"
                    BoxShadow="{StaticResource MenuShadow}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                            MaxHeight="360">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:icon /template/ ContentPresenter#Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:empty /template/ ti|TablerIcon#Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- A checked row states it at the end of the row, and nowhere else. -->
    <Style Selector="^:checked /template/ ti|TablerIcon#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--
      One fill for the pointer and for the keyboard, so the row under the pointer and the row
      the arrow keys reached look the same. A row holding its submenu open keeps it, which is
      what says where an open submenu came from.
    -->
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>

    <!--
      A refused row keeps its place and greys, because the configuration that would allow it is
      a neighbouring one and the greyed row plus its reason says what to change
      (docs/field-availability.md, "One option disabled with a reason").
    -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#Icon">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- The key states its own colour, so the greying of the row does not reach it on its own. -->
    <Style Selector="^:disabled /template/ TextBlock#Gesture">
      <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    A figure printed in a menu: what the relay says a stream is carrying, read where the stream
    is right-clicked.

    Not a row that refused to do anything, which is what these were - disabled rows wearing the
    treatment the design reserves for an action a configuration took away, inviting a reader to
    work out what would bring them back. A figure is a different kind of thing, so it is inert
    rather than disabled: hint weight, no fill under the pointer, and out of the keyboard's path
    entirely.
  -->
  <ControlTheme x:Key="MenuNote" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="MinHeight" Value="{StaticResource TextRowHeight}" />
    <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </ControlTheme>

  <!--
    The divider between groups. One of the three line weights, inset so it stops short of the
    rounded corners rather than running into them.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="9,5" />
    <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
