<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every surface in the app, as one table. Four fills and three edges cover all of it,
    and the reason a screen looks calm is that nothing outside this file invents a fifth.
  -->

  <!-- A content panel: a setup step's form, a broadcast card, a viewer's chip row host. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <!-- A recessed panel: the nav strip when it floats, a callout, a plot frame. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <!-- The title bar and the status bar: one colour, full bleed, no border of their own. -->
  <Style Selector="Border.chromeband">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
  </Style>

  <!-- The nav strip as it ships: docked, square, and ruled off from the body below it. -->
  <Style Selector="Border.navstrip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="{DynamicResource NavStripHeight}" />
  </Style>

  <!-- Video, and the black it sits on in either theme. -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusTile}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- The 1px rule between two regions of one strip. Height is the strip's, not the app's. -->
  <Style Selector="Border.dividerv">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="Border.dividerh">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- A row separator inside a table: one shade quieter than a divider. -->
  <Style Selector="Border.rowrule">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

</Styles>
