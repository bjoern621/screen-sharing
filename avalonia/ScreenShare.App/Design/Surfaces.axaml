<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every fill and every edge in the app.
    Nothing outside this file states one.
  -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
  </Style>

  <Style Selector="Border.chromeband">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
  </Style>

  <Style Selector="Border.navstrip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <!--
      A minimum rather than a fixed height.
      The strip's hint wraps on a window too narrow to hold it, and a fixed height would cut the second line off.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource NavStripHeight}" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusTile}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Between two regions of one strip, so the 18px is the strip's height and not the window's. -->
  <Style Selector="Border.dividerv">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="Border.dividerh">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.rowrule">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

</Styles>
