<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    A tooltip carries the sentence a refused option has no room for beside it (docs/field-availability.md),
    so it is sized for prose rather than for a label.
    Skinned like the menu and taking the same shadow,
    since a tooltip opening over a video tile has nothing else separating it from the picture.
  -->

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Padding" Value="10,7" />
    <!-- Wide enough to hold a clause, short enough that the eye does not track back. -->
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{StaticResource MenuShadow}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
      The wrap is in Design/Text.axaml.
      A tooltip's string content is drawn by a TextBlock the content presenter builds,
      and a ControlTheme carrying the descendant selector that reaches it throws when the theme is built.
    -->
  </ControlTheme>

</ResourceDictionary>
