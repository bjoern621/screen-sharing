<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ScreenShare.App.Controls">

  <!--
    One rule for every control that can be waiting.
    A control that answers a press by going quietly inert is read as a broken one.
    A screen sets controls:Pending.IsActive from the command's own in-flight field,
    and a spinner drawn at a call site would be a second answer to one question.
  -->

  <!--
    The hidden content is still measured, so a pressed button does not resize
    and a row of them does not reflow around the one that is working.
    The ContentTemplate moves rather than the Content, so nothing here writes what the control says.
    The command refuses a second press itself, which leaves the cursor cosmetic.
  -->
  <Style Selector=":is(Button):pending">
    <Setter Property="Cursor" Value="Wait" />
    <Setter Property="ContentTemplate">
      <DataTemplate>
        <Panel>
          <ContentPresenter Content="{Binding}" Opacity="0" IsHitTestVisible="False" />
          <controls:Spinner />
        </Panel>
      </DataTemplate>
    </Setter>
  </Style>

</Styles>
