<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The text roles as one table: a view names the role a line plays and states no size, weight or colour.
    One family carries all of them (Design/Typography.axaml), so a role differs from its neighbour by those three.
    Two weights, Medium and SemiBold.
    Regular is unused, because Inter at 400 on this palette's dark surfaces reads thin enough
    to start losing muted grey copy.
  -->

  <!--
    FontFamily, FontSize and FontWeight inherit down the tree in Avalonia.
    Stating them on the window is what gives the design's face to a control nothing here has restyled.
  -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!--
    No Foreground here.
    This selector also matches the TextBlock a ContentPresenter builds for a button's string content,
    so a colour set at this level would beat the one the button's own theme set.
  -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    A tooltip carries a sentence, so it wraps and does not trim.
    Stated here because the TextBlock it reaches is one a content presenter built,
    and a ControlTheme may not carry a descendant selector.
  -->
  <Style Selector="ToolTip TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightSmall}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
  </Style>

  <Style Selector="TextBlock.disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>

  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
  </Style>

  <!-- An identifier the backend spells: hevc_nvenc, gbrp. Said by colour and position, no second face. -->
  <Style Selector="TextBlock.ident">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="FontFeatures" Value="{DynamicResource FigureFeatures}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.figure">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="FontFeatures" Value="{DynamicResource FigureFeatures}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="TextBlock.promoted">
    <Setter Property="FontSize" Value="{DynamicResource FontSizePromoted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="{DynamicResource FigureFeatures}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!--
    The two lines inside an option card, and what picking or refusing one does to them.
    Stated here rather than beside the card, because reaching into a button's content needs a descendant selector,
    and a ControlTheme carrying one throws when the theme is built.
    The option title takes tabular figures, since an option is sometimes named by its identifier.
  -->
  <Style Selector="TextBlock.optiontitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="{DynamicResource FigureFeatures}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.cardtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.cardbody">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightSmall}" />
  </Style>

  <!-- Picked. The card's fill has already moved, so its text comes up a step to meet it. -->
  <Style Selector="Button.picked TextBlock.optiontitle">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.picked TextBlock.cardtitle">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.picked TextBlock.cardbody">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!--
    A refused dropdown entry is a MenuItem rather than a button, and a role stating a colour
    beats the greying its row's theme sets on Foreground.
    App level rather than beside the dropdown: a flyout is hosted in a popup root,
    out of reach of a style on the view that opened it.
  -->
  <Style Selector="MenuItem:disabled TextBlock.ident">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled TextBlock.cardbody">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>

  <Style Selector="Button:disabled TextBlock.optiontitle">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>
  <Style Selector="Button:disabled TextBlock.cardtitle">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>
  <Style Selector="Button:disabled TextBlock.cardbody">
    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
  </Style>

</Styles>
