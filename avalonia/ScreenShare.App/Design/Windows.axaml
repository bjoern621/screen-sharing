<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome">

  <!--
    The caption a window gets once its client area covers the native one
    (Features/Shell/Model/WindowChrome.cs).

    Extending makes the platform ask the theme for a replacement caption,
    and the stock one paints its own title and buttons over whatever the window drew underneath.
    This one draws nothing: empty decorations content,
    with the geometry parts zeroed so no frame, shadow or caption strip is reserved either.
  -->
  <ControlTheme x:Key="EmptyDecorations" TargetType="chrome:WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="0" />
    <Setter Property="DefaultFrameThickness" Value="0" />
    <Setter Property="DefaultShadowThickness" Value="0" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <chrome:WindowDrawnDecorationsContent />
      </WindowDrawnDecorationsTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
