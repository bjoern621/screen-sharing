<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="False">

  <!--
    A Button with a MenuFlyout and not a ComboBox.
    A ComboBox owns a selection, which is a second copy of a value the resolved form already
    carries: a render pass reassigning it would fight the list, and a list reassigning itself
    would write a setting nobody picked (docs/ipc-api.md).
    A MenuItem closes the flyout when it is invoked and takes keyboard traversal with it, which a
    panel of buttons would not.

    Compiled bindings are off in this file alone.
    An item container theme binds against the item the flyout generated it for, and that item's
    type is known only where the control is used, so there is no x:DataType for a theme to declare.
  -->
  <ControlTheme x:Key="SelectFace" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="{StaticResource ActionHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />

    <!-- Inert is a colour change: the field's own reason is printed under the control. -->
    <Style Selector="^:disabled /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    </Style>

    <!--
      The two columns grey with the face, and the rule cannot live here: reaching content the
      caller supplied takes a descendant selector, which a ControlTheme may not carry.
      Avalonia throws when the theme is built, which is the first time the face is measured.
      The caller states it beside the classes it gave that text.
    -->
  </ControlTheme>

  <!--
    A menu row plus the three facts that make it an option: what picking it does, whether it can be
    picked, and whether picking it is what closes the menu.
    Everything else is the menu's, stated once in Design/Menus.axaml.
    A refused entry greys and keeps its place, and its reason is drawn by the caller's item template:
    a disabled Avalonia control is not hit-testable, so a tooltip on this row never opens
    and the reason line is read where it stands
    (docs/field-availability.md, docs/design-language.md "Status language").
    The menu's height is a minimum for the same reason, an entry carrying a reason being two lines
    tall.

    The disclosure row stays open on the press: it lists the refused entries into the menu the reader
    is standing in, and closing would make reading a reason a second trip (OptionViewModel.cs).
  -->
  <ControlTheme x:Key="SelectMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Command" Value="{Binding Choose}" />
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
    <Setter Property="StaysOpenOnClick" Value="{Binding IsReveal}" />
  </ControlTheme>

</ResourceDictionary>
