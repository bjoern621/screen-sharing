<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ScreenShare.App.Controls"
                    xmlns:ti="using:TablerIcons">

  <!--
    One hue per severity, and the glyph says the same thing without them
    (docs/design-language.md, "Palette").
    Pending and Note stay grey: neither reports on a stream, one having no answer yet and the other
    nothing to complain about.
    Grid rather than StackPanel: the body is the backend's own sentence and a stack measures its
    children against infinite width.
  -->
  <ControlTheme x:Key="{x:Type controls:CheckItem}" TargetType="controls:CheckItem">
    <Setter Property="Template">
      <ControlTemplate>
        <!--
          The whole line is the press to the step that fixes it (CheckItem.OnTapped),
          so the fill covers the sentence as well as the label under it.
          Transparent rather than unset, an unfilled border taking no pointer.
          The padding is the room that fill needs, and the margin takes it back off the layout:
          the badge keeps its column and the rows keep their gap.
        -->
        <Border Name="Row"
                Background="Transparent"
                CornerRadius="{StaticResource RadiusControl}"
                Padding="6,4"
                Margin="-6,-4">
          <Grid ColumnDefinitions="Auto,*">
            <!-- The badge is even, so the 12px glyph's slack splits into whole pixels and the ink lands centred. -->
            <Border Name="Badge"
                    Grid.Column="0"
                    Width="16" Height="16"
                    CornerRadius="{StaticResource RadiusSegment}"
                    Background="{StaticResource ChipBorderBrush}"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    VerticalAlignment="Top"
                    Margin="0,1,0,0">
              <ti:TablerIcon Name="Glyph"
                             Classes="badge"
                             Icon="{Binding $parent[controls:CheckItem].State, Converter={x:Static controls:CheckGlyphConverter.Instance}}"
                             Brush="{StaticResource OnHueBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="5">
              <SelectableTextBlock Name="Body"
                                   Text="{TemplateBinding Text}"
                                   Classes="muted"
                                   LineHeight="{StaticResource LineHeightSmall}" />

              <!-- Where the fault is fixed. Text rather than a control, the press being the line around it. -->
              <TextBlock Name="FixIn"
                         Text="{TemplateBinding FixedInStep}"
                         Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         IsVisible="{Binding $parent[controls:CheckItem].FixedInStep,
                                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- A line leading nowhere draws as text: no cursor, no fill, and the label still says where the fault is fixed. -->
    <Style Selector="^:leads">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="^:leads:pointerover /template/ Border#Row">
      <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    </Style>
    <Style Selector="^:leads:pointerover /template/ TextBlock#FixIn">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style Selector="^[State=Passed] /template/ Border#Badge">
      <Setter Property="Background" Value="{StaticResource GoBrush}" />
    </Style>

    <Style Selector="^[State=Pending] /template/ Border#Badge">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
    </Style>
    <Style Selector="^[State=Pending] /template/ ti|TablerIcon#Glyph">
      <Setter Property="Brush" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="^[State=Note] /template/ Border#Badge">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
    </Style>
    <Style Selector="^[State=Note] /template/ ti|TablerIcon#Glyph">
      <Setter Property="Brush" Value="{StaticResource HintBrush}" />
    </Style>
    <Style Selector="^[State=Note] /template/ SelectableTextBlock#Body">
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>

    <Style Selector="^[State=Warned] /template/ Border#Badge">
      <Setter Property="Background" Value="{StaticResource CautionBrush}" />
    </Style>
    <Style Selector="^[State=Warned] /template/ SelectableTextBlock#Body">
      <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
    </Style>

    <Style Selector="^[State=Blocking] /template/ Border#Badge">
      <Setter Property="Background" Value="{StaticResource AttentionBrush}" />
    </Style>
    <Style Selector="^[State=Blocking] /template/ SelectableTextBlock#Body">
      <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
