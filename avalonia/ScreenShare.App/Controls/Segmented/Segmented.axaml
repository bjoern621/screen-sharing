<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The segmented control. Used for the three destinations in the nav strip, and again for
    any short closed set where every option should stay on screen.

    It is a ListBox theme rather than a control of its own because selection, keyboard
    traversal and item recycling are exactly what a ListBox already is. What the design
    changes is only the skin.

    The unavailable state is a disabled item, and the whole treatment is a colour change:
    no opacity, no strike, no badge. Dimming rather than hiding is deliberate - an expert
    tool should teach its own shape, and a missing destination reads as a bug.
  -->

  <ControlTheme x:Key="SegmentedControlTheme" TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="SegmentItemTheme" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <!--
      Horizontal padding only. The segment is as tall as the track it sits in minus the
      track's own 2px inset, and the label is centred in whatever that leaves; a vertical
      pad on top of that is a second, competing statement about where the text sits, and
      when the two disagree the label rides high inside its pill.
    -->
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSegment}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    </Style>

    <!-- The one light surface in the strip. -->
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Unavailable. A colour change, and nothing else. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
