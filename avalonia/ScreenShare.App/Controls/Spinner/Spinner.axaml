<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ScreenShare.App.Controls">

  <!--
    One arc, three quarters of a circle, turning once a second. The gap is what makes the
    rotation legible: a whole ring turning looks like a ring standing still.

    The stroke takes the inherited Foreground rather than a brush of its own, so the spinner
    on the red commit is the commit's own foreground and the one on a link button is the
    link's - which is also why a disabled treatment that moves Foreground moves this with it.
  -->
  <ControlTheme x:Key="{x:Type controls:Spinner}" TargetType="controls:Spinner">
    <Setter Property="Width" Value="{StaticResource SpinnerSize}" />
    <Setter Property="Height" Value="{StaticResource SpinnerSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Arc Name="Ring"
             Stroke="{TemplateBinding Foreground}"
             StrokeThickness="{StaticResource SpinnerStroke}"
             StrokeLineCap="Round"
             StartAngle="0"
             SweepAngle="270"
             RenderTransformOrigin="50%,50%">
          <Arc.RenderTransform>
            <RotateTransform />
          </Arc.RenderTransform>
        </Arc>
      </ControlTemplate>
    </Setter>

    <!--
      The one piece of motion in the design that runs on its own rather than in answer to a
      pointer. It is a constant rate and not an eased one: an eased turn reads as progress
      towards something, and nothing here knows how far along a control call is.
    -->
    <Style Selector="^ /template/ Arc#Ring">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

</ResourceDictionary>
