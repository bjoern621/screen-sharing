<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plots="using:ScreenShare.App.Features.Broadcast.Plots.View"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.Plots.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.Plots.View.PlotsView"
             x:DataType="vm:PlotsViewModel">

  <UserControl.Styles>
    <!-- The plot frame: a recessed surface with the inner radius, and nothing else. -->
    <Style Selector="Border.plot">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
      <Setter Property="Height" Value="104" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!--
      An in-plot annotation. Without axes it is the only thing that states a scale, so it
      is set in tabular figures: the ceiling this plot is drawn against is re-rendered as
      the traffic moves, and a number that changes width drags its own baseline sideways
      under a line that has not moved.
    -->
    <Style Selector="TextBlock.annotation">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.range">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*">

    <Border Grid.Column="0" Classes="card" Padding="13,12">
      <StackPanel Spacing="{StaticResource GapControl}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="caption" Text="Egress bitrate" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="range" Text="{Binding Window}" VerticalAlignment="Bottom" />
        </Grid>

        <Border Classes="plot">
          <Panel>
            <!--
              The gridline is the encoder's ceiling, and where it sits is the view model's
              answer rather than a number here: the curve is scaled to the run's own peak, so
              a rule at a constant height would mark a ceiling the stream may be nowhere near.
              NaN draws none, which is what a ceiling off the top of the plot comes out as.
            -->
            <plots:Sparkline Points="{Binding Egress}"
                             Extent="{Binding Extent}"
                             Stroke="{StaticResource ForegroundBrush}"
                             GridlineBrush="{StaticResource ChipBorderBrush}"
                             GridlineFraction="{Binding CeilingFraction}">
              <plots:Sparkline.Fill>
                <SolidColorBrush Color="{StaticResource White}" Opacity="0.09" />
              </plots:Sparkline.Fill>
            </plots:Sparkline>

            <!--
              The label states the ceiling whether or not the rule is on screen, so it sits in
              the corner rather than riding a line that is not always drawn.
            -->
            <TextBlock Classes="annotation"
                       Text="{Binding Ceiling}"
                       Margin="7,6,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
          </Panel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Padding="13,12" Margin="10,0,0,0">
      <StackPanel Spacing="{StaticResource GapControl}">
        <Grid ColumnDefinitions="*,Auto">
          <!--
            No window label beside this caption, and that is not an oversight now that the card
            draws something. Its points are relay snapshots and the card beside it counts encoder
            samples, and the two are taken on different intervals - so the span the other card
            states is not this one's, and stating one here would need a period the contract does
            not carry.

            The caption says whose figures these are. They are the worst viewer's at each moment
            and not the stream's, which is a distinction the header makes in a word and this one
            has room to make properly.
          -->
          <TextBlock Grid.Column="0" Classes="caption" Text="Worst viewer: round trip &amp; loss" VerticalAlignment="Bottom" />
        </Grid>

        <Border Classes="plot">
          <Panel>
            <!--
              Loss sits behind round trip: thinner, grey, and drawn first. Round trip is the
              figure a publisher reads first and loss is the one that explains it, so the reading
              order and the drawing order are the same.

              The band the design marks a congestion window with states no start and no width,
              so none is drawn. The relay states its figures as they stand at each poll and marks
              no interval, so a window shaded here would be a detection this side performed and
              called the backend's. It comes back with the detection, from the reading.
            -->
            <plots:Sparkline Points="{Binding Rtt}"
                             Secondary="{Binding Loss}"
                             Extent="{Binding Extent}"
                             Stroke="{StaticResource ForegroundBrush}"
                             SecondaryStroke="{StaticResource MutedBrush}"
                             BandEdgeBrush="{StaticResource OnAirBrush}">
              <plots:Sparkline.BandBrush>
                <SolidColorBrush Color="{StaticResource OnAir}" Opacity="0.1" />
              </plots:Sparkline.BandBrush>
            </plots:Sparkline>

            <Grid ColumnDefinitions="27*,73*">
              <TextBlock Grid.Column="1"
                         Classes="annotation"
                         Foreground="{StaticResource OnAirBrush}"
                         Text="{Binding Band}"
                         Margin="0,6,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top" />
            </Grid>

            <!-- The swatch is the em dash itself, in the series colour. No separate key. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource GapPanel}"
                        Margin="7,0,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">
              <TextBlock Classes="annotation" Foreground="{StaticResource ForegroundBrush}" Text="— rtt" />
              <TextBlock Classes="annotation" Text="— loss" />
            </StackPanel>
          </Panel>
        </Border>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
