<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plots="using:ScreenShare.App.Features.Broadcast.Plots.View"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.Plots.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.Plots.View.PlotsView"
             x:DataType="vm:PlotsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.plot">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
      <Setter Property="Height" Value="104" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!--
      Tabular figures: an annotation re-renders as the traffic moves, and proportional digits
      would shift the label sideways under a rule that has not moved.
    -->
    <Style Selector="TextBlock.annotation">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.range">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*">

    <Border Grid.Column="0" Classes="card" Padding="13,12">
      <StackPanel Spacing="{StaticResource GapControl}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="caption" Text="Egress bitrate" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="range" Text="{Binding Window}" VerticalAlignment="Bottom" />
        </Grid>

        <Border Classes="plot">
          <Panel>
            <plots:Sparkline Points="{Binding Egress}"
                             Extent="{Binding Extent}"
                             Stroke="{StaticResource ForegroundBrush}"
                             GridlineBrush="{StaticResource ChipBorderBrush}"
                             GridlineFraction="{Binding CeilingFraction}">
              <plots:Sparkline.Fill>
                <SolidColorBrush Color="{StaticResource White}" Opacity="0.09" />
              </plots:Sparkline.Fill>
            </plots:Sparkline>

            <TextBlock Classes="annotation"
                       Text="{Binding Ceiling}"
                       IsVisible="{Binding HasEgress}"
                       Margin="7,6,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

            <TextBlock Classes="hint"
                       Text="{Binding EgressNotice}"
                       IsVisible="{Binding !HasEgress}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="{StaticResource InsetSection}" />
          </Panel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Padding="13,12" Margin="10,0,0,0">
      <StackPanel Spacing="{StaticResource GapControl}">
        <Grid ColumnDefinitions="*,Auto">
          <!--
            No span label beside this caption: these points are relay snapshots, and the poll
            interval they arrive on is not on the contract.
          -->
          <TextBlock Grid.Column="0" Classes="caption" Text="Worst viewer: round trip &amp; loss" VerticalAlignment="Bottom" />
        </Grid>

        <Border Classes="plot">
          <Panel>
            <!--
              Band brushes and no band: nothing states a congestion interval, so no start and no
              width are bound and the band stays undrawn. Shading one from this side would be a
              detection the shell performed.
            -->
            <plots:Sparkline Points="{Binding Rtt}"
                             Secondary="{Binding Loss}"
                             Extent="{Binding Extent}"
                             Stroke="{StaticResource ForegroundBrush}"
                             SecondaryStroke="{StaticResource MutedBrush}"
                             BandEdgeBrush="{StaticResource AttentionBrush}">
              <plots:Sparkline.BandBrush>
                <SolidColorBrush Color="{StaticResource Attention}" Opacity="0.1" />
              </plots:Sparkline.BandBrush>
            </plots:Sparkline>

            <Grid ColumnDefinitions="27*,73*">
              <TextBlock Grid.Column="1"
                         Classes="annotation"
                         Foreground="{StaticResource AttentionBrush}"
                         Text="{Binding Band}"
                         Margin="0,6,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top" />
            </Grid>

            <!-- The dash in each label is the swatch, so the two foregrounds track the series strokes. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource GapPanel}"
                        Margin="7,0,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding HasLatency}">
              <TextBlock Classes="annotation" Foreground="{StaticResource ForegroundBrush}" Text="— rtt" />
              <TextBlock Classes="annotation" Text="— loss" />
            </StackPanel>

            <TextBlock Classes="hint"
                       Text="{Binding LatencyNotice}"
                       IsVisible="{Binding !HasLatency}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="{StaticResource InsetSection}" />
          </Panel>
        </Border>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
