<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.Nudge.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.Nudge.View.NudgeView"
             x:DataType="vm:NudgeViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.end">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="{StaticResource InsetPanel}">
    <StackPanel Spacing="{StaticResource GapControl}">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="caption" Text="Live quality nudge" VerticalAlignment="Center" />
        <!--
          Bound rather than spelled in: the caveat and the track's reason are one table, and a
          sentence written here cannot be read beside the one it has to agree with.
        -->
        <TextBlock Grid.Column="1"
                   Classes="hint"
                   FontSize="{StaticResource FontSizeSmall}"
                   Text="{Binding Caveat}"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="end" Text="Smoother" />
        <Slider Grid.Column="1"
                Minimum="0"
                Maximum="100"
                Margin="11,0"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsEnabled}"
                Value="{Binding Sharpness, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="end" Text="Sharper" />
      </Grid>

      <TextBlock Classes="figure" Foreground="{StaticResource HintBrush}" Text="{Binding Estimate}" />

      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Text="{Binding Reason}"
                 IsVisible="{Binding !IsEnabled}" />

    </StackPanel>
  </Border>
</UserControl>
