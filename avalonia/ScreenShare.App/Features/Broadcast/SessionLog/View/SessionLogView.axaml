<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:model="using:ScreenShare.App.Features.Broadcast.Model"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.SessionLog.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.SessionLog.View.SessionLogView"
             x:DataType="vm:SessionLogViewModel">

  <UserControl.Styles>
    <!-- Warning last: it matches .level at equal specificity, so declaration order decides. -->
    <Style Selector=":is(TextBlock).stamp">
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).level">
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).message">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).warn">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="13,12">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="caption" Text="Session log" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Open full log"
                VerticalAlignment="Center"
                Command="{Binding OpenFullLogCommand}"
                controls:Pending.IsActive="{Binding OpenFullLogCommand.IsRunning}" />
      </Grid>

      <TextBlock DockPanel.Dock="Top"
                 Classes="hint"
                 Text="{Binding Notice}"
                 IsVisible="{Binding !HasLines}"
                 TextWrapping="Wrap" />

      <!-- Newest line first, so the scroll opens where the reader is going anyway. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Lines}" VerticalAlignment="Top">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:LogLine">
              <!--
                A grid and not a horizontal stack, and a floor rather than a height: what a line carries
                is a failure as prose, and a stack measures against infinite width, so the sentence
                would run off the card's edge instead of wrapping into the row.

                Top and not centre, on all three: a message runs to several lines, and a stamp centred
                against the block of them sits beside its middle line, reading as a stamp for something
                other than the row it belongs to.

                The stamp and the level take the transcript face along with the message, though this
                screen wrote both: a row is read as one line, and a face changing halfway across it
                reads as two.
              -->
              <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="{StaticResource GapTight}"
                    MinHeight="{StaticResource TextRowHeight}">
                <SelectableTextBlock Grid.Column="0"
                                     Classes="transcript stamp"
                                     Text="{Binding Time}"
                                     VerticalAlignment="Top" />
                <SelectableTextBlock Grid.Column="1"
                                     Classes="transcript level"
                                     Classes.warn="{Binding IsWarning}"
                                     Text="{Binding Level}"
                                     VerticalAlignment="Top" />
                <SelectableTextBlock Grid.Column="2"
                                     Classes="transcript message"
                                     Text="{Binding Message}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Top" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
  </Border>
</UserControl>
