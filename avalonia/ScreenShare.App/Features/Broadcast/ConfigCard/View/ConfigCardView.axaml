<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:ScreenShare.App.Features.Broadcast.Model"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.ConfigCard.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.ConfigCard.View.ConfigCardView"
             x:DataType="vm:ConfigCardViewModel">

  <UserControl.Styles>
    <!--
      A key is a word a person wrote and its value is what the pipeline answered,
      so the key is muted at the body size against the value's identifier role.
    -->
    <Style Selector="TextBlock.key">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="{StaticResource InsetPanel}">
    <DockPanel>

      <!--
        The link is the one escape hatch out of a read-only card,
        and the whole of what keeps setup the owner of configuration (docs/design-language.md, "Ownership").
      -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,11">
        <TextBlock Grid.Column="0"
                   Classes="caption"
                   Text="Active configuration"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Theme="{StaticResource LinkButton}"
                Content="Edit in setup"
                VerticalAlignment="Center"
                Command="{Binding EditInSetupCommand}" />
      </Grid>

      <Border DockPanel.Dock="Bottom"
              Margin="0,11,0,0"
              Padding="10,9"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusButton}">
        <TextBlock Classes="hint"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="{Binding ReadOnly}" />
      </Border>

      <!-- Stands in until the rows arrive. -->
      <TextBlock DockPanel.Dock="Top"
                 Classes="hint"
                 Text="{Binding Notice}"
                 IsVisible="{Binding !HasRows}"
                 TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Top">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="model:ConfigRow">
            <!-- No separator, no striping, no hover: no row here is a target. -->
            <Grid ColumnDefinitions="*,Auto" Height="{StaticResource TextRowHeight}">
              <TextBlock Grid.Column="0" Classes="key" Text="{Binding Key}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="ident" Text="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </DockPanel>
  </Border>
</UserControl>
