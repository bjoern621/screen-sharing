<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:ScreenShare.App.Features.Broadcast.Model"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.ConfigCard.ViewModel"
             x:Class="ScreenShare.App.Features.Broadcast.ConfigCard.View.ConfigCardView"
             x:DataType="vm:ConfigCardViewModel">

  <UserControl.Styles>
    <!--
      A config key. Muted at the body size against the value's identifier role: the key is
      a word a person wrote, the value is what the pipeline answered.
    -->
    <Style Selector="TextBlock.key">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="12">
    <DockPanel>

      <!--
        The section title takes the row and pushes the link to its right end. That link is
        the single escape hatch out of a read-only card, and the entire fix for setup and
        broadcast both owning configuration.
      -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,11">
        <TextBlock Grid.Column="0"
                   Classes="caption"
                   Text="Active configuration"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Theme="{StaticResource LinkButton}"
                Content="Edit in setup"
                VerticalAlignment="Center"
                Command="{Binding EditInSetupCommand}" />
      </Grid>

      <!-- Why the card is read-only, said once, where the reader is when they wonder. -->
      <Border DockPanel.Dock="Bottom"
              Margin="0,11,0,0"
              Padding="10,9"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusButton}">
        <TextBlock Classes="hint"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="{Binding ReadOnly}" />
      </Border>

      <!-- What stands in for the rows while nothing is publishing. Composed all along, drawn now. -->
      <TextBlock DockPanel.Dock="Top"
                 Classes="hint"
                 Text="{Binding Notice}"
                 IsVisible="{Binding !HasRows}"
                 TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Top">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="model:ConfigRow">
            <!-- No separators, no striping, no hover: nothing here is a target. -->
            <Grid ColumnDefinitions="*,Auto" Height="{StaticResource TextRowHeight}">
              <TextBlock Grid.Column="0" Classes="key" Text="{Binding Key}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="ident" Text="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </DockPanel>
  </Border>
</UserControl>
