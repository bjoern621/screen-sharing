<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:ScreenShare.App.Features.Broadcast.Preview.Model"
             xmlns:vm="using:ScreenShare.App.Features.Broadcast.Preview.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             x:Class="ScreenShare.App.Features.Broadcast.Preview.View.PreviewView"
             x:DataType="vm:PreviewViewModel">

  <UserControl.Styles>
    <!--
      Tabular figures: the resolution and the frame rate then hold still over moving video
      instead of shifting width with each redraw.
    -->
    <Style Selector="TextBlock.overlay">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="7">

    <!-- 16:9 at the left column's fixed 396px. Avalonia carries no aspect ratio, so it is stated. -->
    <Border Classes="tile" Height="223">
      <Panel>

        <tiles:StreamTile Source="{Binding Tile}" />

        <!--
          Selectable, because this carries the backend's own refusal for the end-to-end preview,
          naming the stream's format and the protocols that would have carried it.
          A reader gets that sentence out of the app by selecting it,
          and the style wraps rather than trims so the characters they came for are still there.
        -->
        <SelectableTextBlock Classes="hint"
                             FontSize="{StaticResource FontSizeBody}"
                             Text="{Binding Placeholder}"
                             IsVisible="{Binding HasPlaceholder}"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="24" />

        <Border BorderBrush="{StaticResource AttentionBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource RadiusTile}"
                IsVisible="{Binding IsSharing}" />

        <Border Background="{StaticResource AttentionBrush}"
                CornerRadius="{StaticResource RadiusControl}"
                Padding="9,3"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsVisible="{Binding IsSharing}">
          <TextBlock Classes="caption" Foreground="{StaticResource ForegroundBrush}" Text="Sharing" />
        </Border>

        <!--
          The pointer travels beside the picture rather than in it, so the preview's frames carry none
          and the marker is drawn here (docs/capture-architecture.md, "The pointer").
          The offsets are in this card's own pixels.
        -->
        <Canvas IsVisible="{Binding HasPointer}" ClipToBounds="True">
          <Path Classes="pointer"
                Canvas.Left="{Binding PointerLeft}"
                Canvas.Top="{Binding PointerTop}" />
        </Canvas>

        <Panel Margin="8" VerticalAlignment="Bottom">
          <Border Background="{StaticResource TileBrush}"
                  Opacity="0.62"
                  CornerRadius="{StaticResource RadiusControl}" />
          <!--
            No level meter beside the figures: nothing measures a level on this path, and bars at fixed
            heights are a meter's shape with no reading behind it (avalonia/README.md).
          -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="9,5">
            <TextBlock Grid.Column="0" Classes="overlay" Text="{Binding Encoded}" />
            <TextBlock Grid.Column="1" Classes="overlay" Text="{Binding Quality}" Margin="9,0,0,0" />
            <TextBlock Grid.Column="2"
                       Classes="overlay"
                       Text="{Binding Leg}"
                       IsVisible="{Binding HasLeg}"
                       Margin="9,0,0,0" />
          </Grid>
        </Panel>

      </Panel>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Classes="hint"
                 Text="{Binding RouteChoice}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,9,0" />

      <ListBox Grid.Column="1"
               Theme="{StaticResource SegmentedControlTheme}"
               ItemContainerTheme="{StaticResource SegmentItemTheme}"
               Height="{StaticResource ControlHeight}"
               ItemsSource="{Binding Routes}"
               SelectedItem="{Binding SelectedRoute, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="model:PreviewRouteTab">
            <!--
              Read back off the container: the app states a Foreground on every TextBlock, so
              plain inheritance loses to it and every segment comes out one colour.
            -->
            <TextBlock Text="{Binding Label}"
                       Foreground="{Binding $parent[ListBoxItem].Foreground}"
                       FontWeight="{Binding $parent[ListBoxItem].FontWeight}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <TextBlock Classes="hint" Text="{Binding Cost}" TextWrapping="Wrap" />

  </StackPanel>
</UserControl>
