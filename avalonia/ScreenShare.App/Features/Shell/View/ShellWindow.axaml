<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:ScreenShare.App.Features.Shell.ViewModel"
        xmlns:titlebar="using:ScreenShare.App.Features.Shell.TitleBar.View"
        xmlns:navstrip="using:ScreenShare.App.Features.Shell.NavStrip.View"
        xmlns:statusbar="using:ScreenShare.App.Features.Shell.StatusBar.View"
        xmlns:settings="using:ScreenShare.App.Features.Shell.Settings.View"
        xmlns:setup="using:ScreenShare.App.Features.Setup.View"
        xmlns:setupVm="using:ScreenShare.App.Features.Setup.ViewModel"
        xmlns:insights="using:ScreenShare.App.Features.Insights.View"
        xmlns:insightsVm="using:ScreenShare.App.Features.Insights.ViewModel"
        xmlns:viewer="using:ScreenShare.App.Features.Viewer.View"
        xmlns:viewerVm="using:ScreenShare.App.Features.Viewer.ViewModel"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:model="using:ScreenShare.App.Features.Shell.Model"
        x:Class="ScreenShare.App.Features.Shell.View.ShellWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding TitleBar.Title}"
        Width="{x:Static model:WindowSize.Opening}"
        Height="{x:Static model:WindowSize.OpeningHeight}"
        MinWidth="{x:Static model:WindowSize.Floor}"
        MinHeight="{x:Static model:WindowSize.FloorHeight}"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource ControlForegroundBrush}">

  <!--
    This theme and the client-area extension are applied together from the code-behind,
    and only where this app draws the caption (Features/Shell/Model/WindowChrome.cs).
    Where the desktop draws the frame, on Linux, neither is applied,
    and above the nav strip is whatever that desktop puts there, which on a tiling session is nothing.

    Decorations stay Full with the client area extended over them, rather than BorderOnly.
    BorderOnly drops the caption from the native frame,
    and on Win32 the caption is what the compositor animates:
    no open, close, minimise or restore transition, and a top edge widened to the bare resize frame.
    Extending keeps the frame whole and paints underneath it,
    so the platform's animations, snap and shadow survive.

    The cost is hit-testing.
    With the caption present and invisible, every part of the band below has to name the caption element it
    stands in for, which is what the WindowDecorationProperties.ElementRole marks in TitleBarView do,
    and what puts the Windows 11 snap-layout flyout back under the maximise button.

    Extending also makes the platform ask the theme for a replacement caption,
    and the stock one paints its own title and buttons over the band below.
    This theme draws nothing instead: empty decorations content,
    with the geometry parts zeroed so no frame, shadow or caption strip is reserved either.
  -->
  <Window.Resources>
    <ControlTheme x:Key="EmptyDecorations" TargetType="chrome:WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="0" />
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <chrome:WindowDrawnDecorationsContent />
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.KeyBindings>
    <!--
      A filled window draws no rail, no band and no menu, so the keyboard is the way out of it.
      The command names the state rather than toggling one,
      so the key changes nothing on any other screen (Features/Viewer/Model/TileIntent.cs).
    -->
    <KeyBinding Gesture="Escape" Command="{Binding Viewer.LeaveFullscreen}" />
  </Window.KeyBindings>

  <!--
    How a destination becomes a screen: the shell picks the view model and the template picks the view,
    so nothing in the shell names a view type.
  -->
  <Window.DataTemplates>
    <DataTemplate DataType="setupVm:SetupViewModel" x:DataType="setupVm:SetupViewModel">
      <setup:SetupView />
    </DataTemplate>
    <DataTemplate DataType="insightsVm:InsightsViewModel" x:DataType="insightsVm:InsightsViewModel">
      <insights:InsightsView />
    </DataTemplate>
    <DataTemplate DataType="viewerVm:ViewerViewModel" x:DataType="viewerVm:ViewerViewModel">
      <viewer:ViewerView />
    </DataTemplate>
  </Window.DataTemplates>

  <!--
    Auto rows, each band stating its own height and a band that is not drawn taking none,
    which gives a filled window to the body.
    The bands whose prose wraps state a minimum rather than a fixed height.

    Each band's visibility is bound to a fact the shell owns rather than written by whoever moved it:
    a picture filling the window under a strip is the app filling the screen instead of the stream
    (Features/Shell/ViewModel/ShellViewModel.cs).

    Maximised, Windows hangs the frame's resize border off every edge of the work area,
    and the client area goes with it, so an unpadded band sits under the screen edge.
    OffScreenMargin is that overhang, read continuously, so restoring gives it back to zero.
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto"
        Margin="{Binding $parent[Window].OffScreenMargin}">

    <!--
      A band's own data context is its view model, so visibility is read off the window's instead:
      the fact is the shell's and no band holds a copy of it.
    -->
    <titlebar:TitleBarView Grid.Row="0"
                           IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).HasCaption}"
                           DataContext="{Binding TitleBar}" />

    <navstrip:NavStripView Grid.Row="1"
                           IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).HasChrome}"
                           DataContext="{Binding Nav}" />

    <ContentControl Grid.Row="2"
                    Content="{Binding Body}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

    <statusbar:StatusBarView Grid.Row="3"
                             IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).HasChrome}"
                             DataContext="{Binding StatusBar}" />

    <!--
      Over every band and the body alike, which is what a dialog about the app rather than about one screen
      covers.
      Last child and spanning every row: a settings dialog under the strip that opened it would leave
      the strip pressable while it stood.
      Whether it is drawn is its own state, so nothing here reads it (Settings/ViewModel/AppSettingsViewModel.cs).
    -->
    <settings:AppSettingsView Grid.Row="0"
                              Grid.RowSpan="4"
                              DataContext="{Binding AppSettings}" />
  </Grid>
</Window>
