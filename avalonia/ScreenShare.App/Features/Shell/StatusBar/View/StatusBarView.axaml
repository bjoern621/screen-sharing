<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Shell.StatusBar.ViewModel"
             xmlns:sys="using:System"
             xmlns:controls="using:ScreenShare.App.Controls"
             x:Class="ScreenShare.App.Features.Shell.StatusBar.View.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

  <!--
    Grouped by spacing alone, with no rule and no separators, so a run of figures does not read as a table.

    Inset written out: GapPanel holds the same 12, and a Thickness has no token to name.

    A minimum height rather than a fixed one, because the trailing sentence wraps where a desktop hands the
    window less than its stated minimum width.
  -->
  <Border Classes="chromeband"
          MinHeight="{StaticResource StatusBarHeight}"
          Padding="12,0">

    <Grid ColumnDefinitions="Auto,*,Auto">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapSection}"
                  VerticalAlignment="Center">

        <!--
          The build, in every destination.
          The app's own fact rather than one screen's, and the one band drawn on every platform:
          the title bar is the app's on Windows and macOS alone (avalonia/README.md).
        -->
        <TextBlock Classes="muted"
                   Text="{Binding Version}"
                   IsVisible="{Binding ShowsVersion}"
                   VerticalAlignment="Center" />

        <!-- Tighter spacing inside than the panel's own: the figures read as one group. -->
        <ItemsControl ItemsSource="{Binding Load}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource GapPanel}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Classes="figure"
                         Text="{Binding}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!--
        Held against the far edge by the star column rather than by a spacer: the column is what the figures
        leave over, so a window too narrow for both wraps the sentence instead of drawing it past the edge.
        The left margin keeps a wrapped line clear of the figures.
      -->
      <TextBlock Grid.Column="1"
                 Classes="muted"
                 Text="{Binding Hint}"
                 IsVisible="{Binding ShowsHint}"
                 TextWrapping="Wrap"
                 TextAlignment="Right"
                 HorizontalAlignment="Right"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center" />

      <!--
        The send-logs corner: the outcome beside the button that produced it.
        Selectable, because a refusal is what a reader carries into a message to the operator,
        and it wraps rather than trimming for the same reason.
        The width bound keeps a long refusal from pushing the figures off the band.
      -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapPanel}"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center">
        <SelectableTextBlock Classes="muted"
                             Classes.danger="{Binding SendFailed}"
                             Text="{Binding SendOutcome}"
                             IsVisible="{Binding ShowsSendOutcome}"
                             TextWrapping="Wrap"
                             MaxWidth="420"
                             VerticalAlignment="Center" />
        <Button Content="Send logs"
                Padding="8,2"
                VerticalAlignment="Center"
                Command="{Binding SendLogs}"
                ToolTip.Tip="Sends the newest run logs and this machine's facts to the relay operator. The group key stays on this machine."
                controls:Pending.IsActive="{Binding SendLogs.IsRunning}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
