<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Shell.StatusBar.ViewModel"
             xmlns:sys="using:System"
             x:Class="ScreenShare.App.Features.Shell.StatusBar.View.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

  <!--
    Grouped by spacing alone, with no rule and no separators, so a run of figures does not read as a table.

    Inset written out: GapPanel holds the same 12, and a Thickness has no token to name.

    A minimum height rather than a fixed one, because the trailing sentence wraps where a desktop hands the
    window less than its stated minimum width.
  -->
  <Border Classes="chromeband"
          MinHeight="{StaticResource StatusBarHeight}"
          Padding="12,0">

    <Grid ColumnDefinitions="Auto,*">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapSection}"
                  VerticalAlignment="Center">

        <!--
          One slot for the release, in every destination.
          The build is the app's own fact rather than one screen's, and this is the one band drawn on every
          platform: the title bar is the app's on Windows and macOS alone (avalonia/README.md).
          What a check found stands here instead of the build, so the band never says the same thing twice,
          and the tip keeps the build a hover away for a bug report.

          A button rather than a label, the slot being what asks for a check and what opens the dialog.
          It keeps the muted face either way, so a band of figures does not grow a control
          that competes with the one on the far side.
          Where this copy checks nothing the button is disabled and its tip says why,
          which is the whole of what a reader can do about it.
        -->
        <Button Theme="{StaticResource LinkButton}"
                Foreground="{DynamicResource MutedBrush}"
                Margin="-7,0,-7,0"
                Content="{Binding Release}"
                IsVisible="{Binding ShowsRelease}"
                Command="{Binding Updates.Press}"
                ToolTip.Tip="{Binding ReleaseHint}"
                VerticalAlignment="Center" />

        <!--
          A failing check takes that same slot as text rather than as a control:
          it is the string a bug report carries
          (CLAUDE.md, "Every error message is selectable and copyable").
        -->
        <SelectableTextBlock Classes="muted danger"
                             Text="{Binding Updates.Line}"
                             IsVisible="{Binding Updates.ShowsPlainLine}"
                             TextWrapping="Wrap"
                             MaxWidth="420"
                             VerticalAlignment="Center" />

        <!-- Tighter spacing inside than the panel's own: the figures read as one group. -->
        <ItemsControl ItemsSource="{Binding Load}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource GapPanel}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Classes="figure"
                         Text="{Binding}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!--
        Held against the far edge by the star column rather than by a spacer: the column is what the figures
        leave over, so a window too narrow for both wraps the sentence instead of drawing it past the edge.
        The left margin keeps a wrapped line clear of the figures.
      -->
      <TextBlock Grid.Column="1"
                 Classes="muted"
                 Text="{Binding Hint}"
                 IsVisible="{Binding ShowsHint}"
                 TextWrapping="Wrap"
                 TextAlignment="Right"
                 HorizontalAlignment="Right"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
