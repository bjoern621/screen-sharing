<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Shell.StatusBar.ViewModel"
             xmlns:sys="using:System"
             xmlns:controls="using:ScreenShare.App.Controls"
             x:Class="ScreenShare.App.Features.Shell.StatusBar.View.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

  <!--
    Grouped by spacing alone, with no rule and no separators, so a run of figures does not read as a table.

    Inset written out: GapPanel holds the same 12, and a Thickness has no token to name.

    A minimum height rather than a fixed one, because the trailing sentence wraps where a desktop hands the
    window less than its stated minimum width.
  -->
  <Border Classes="chromeband"
          MinHeight="{StaticResource StatusBarHeight}"
          Padding="12,0">

    <Grid ColumnDefinitions="Auto,*">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapSection}"
                  VerticalAlignment="Center">

        <!--
          The build, in every destination.
          The app's own fact rather than one screen's, and the one band drawn on every platform:
          the title bar is the app's on Windows and macOS alone (avalonia/README.md).

          A button rather than a label, the version being what asks for a release check.
          It keeps the muted face either way, so a band of figures does not grow a control
          that competes with the one on the far side.
          Where this copy checks nothing the button is disabled and its tip says why,
          which is the whole of what a reader can do about it.
        -->
        <Button Theme="{StaticResource LinkButton}"
                Foreground="{DynamicResource MutedBrush}"
                Margin="-7,0,-7,0"
                Content="{Binding Version}"
                IsVisible="{Binding ShowsVersion}"
                Command="{Binding Updates.Check}"
                ToolTip.Tip="{Binding Updates.CheckHint}"
                controls:Pending.IsActive="{Binding Updates.Check.IsRunning}"
                VerticalAlignment="Center" />

        <!--
          What the check found, beside the version that asked for it.
          Two controls for two kinds of line: one a reader acts on, and one they copy.
          A found release is a button opening the dialog,
          and a failure is selectable text, that being the string a bug report carries
          (CLAUDE.md, "Every error message is selectable and copyable").
        -->
        <Button Theme="{StaticResource LinkButton}"
                Margin="-7,0,-7,0"
                Content="{Binding Updates.Line}"
                IsVisible="{Binding Updates.OpensDialog}"
                Command="{Binding Updates.Open}"
                VerticalAlignment="Center" />

        <SelectableTextBlock Classes="muted"
                             Classes.danger="{Binding Updates.IsFailure}"
                             Text="{Binding Updates.Line}"
                             IsVisible="{Binding Updates.ShowsPlainLine}"
                             TextWrapping="Wrap"
                             MaxWidth="420"
                             VerticalAlignment="Center" />

        <!-- Tighter spacing inside than the panel's own: the figures read as one group. -->
        <ItemsControl ItemsSource="{Binding Load}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource GapPanel}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Classes="figure"
                         Text="{Binding}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!--
        Held against the far edge by the star column rather than by a spacer: the column is what the figures
        leave over, so a window too narrow for both wraps the sentence instead of drawing it past the edge.
        The left margin keeps a wrapped line clear of the figures.
      -->
      <TextBlock Grid.Column="1"
                 Classes="muted"
                 Text="{Binding Hint}"
                 IsVisible="{Binding ShowsHint}"
                 TextWrapping="Wrap"
                 TextAlignment="Right"
                 HorizontalAlignment="Right"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
