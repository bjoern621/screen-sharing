<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Shell.Go.ViewModel"
             x:Class="ScreenShare.App.Features.Shell.Go.View.GoView"
             x:DataType="vm:GoViewModel">

  <!--
    The commit and its menu, glued at a shared edge like every paired control.
    The 1px gap is the strip showing through, the pair having no border to separate them.
  -->
  <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">

    <!--
      The command and the word are the model's answer for the state the stream is in, so the press ends
      a stream running the draft and commits otherwise, off one reading (ViewModel/GoViewModel.cs).
      The class carries the hue of that effect, and both halves take it: a green chevron beside a red
      commit would read as two controls.

      The stop glyph takes the mark stroke, the ladder's own line reading thin beside a solid dot
      (Design/Icons.axaml).

      Both marks take the button's own Foreground, which the disabled treatment moves:
      content naming a brush of its own would stay bright on a locked button.
    -->
    <Button Theme="{StaticResource GoButton}"
            Classes.stop="{Binding ShowsStop}"
            CornerRadius="{StaticResource RadiusButtonLeading}"
            Command="{Binding Press}"
            controls:Pending.IsActive="{Binding Press.IsRunning}"
            ToolTip.Tip="{Binding BlockedTip}">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}" VerticalAlignment="Center">
        <Ellipse Width="{StaticResource DotSize}"
                 Height="{StaticResource DotSize}"
                 Fill="{Binding $parent[Button].Foreground}"
                 IsVisible="{Binding !ShowsStop}"
                 VerticalAlignment="Center" />
        <ti:TablerIcon Classes="button mark"
                       Icon="IconPlayerStop"
                       Brush="{Binding $parent[Button].Foreground}"
                       IsVisible="{Binding ShowsStop}"
                       VerticalAlignment="Center" />
        <TextBlock Text="{Binding PressLabel}" />
      </StackPanel>
    </Button>

    <Button x:Name="MenuButton"
            Theme="{StaticResource GoButton}"
            Classes.stop="{Binding ShowsStop}"
            CornerRadius="{StaticResource RadiusButtonTrailing}"
            Padding="7,0"
            Click="OnMenuPressed">
      <ti:TablerIcon Icon="IconChevronDown" Brush="{Binding $parent[Button].Foreground}" />
    </Button>
  </StackPanel>
</UserControl>
