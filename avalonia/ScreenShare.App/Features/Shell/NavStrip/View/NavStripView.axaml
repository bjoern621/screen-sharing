<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:vm="using:ScreenShare.App.Features.Shell.NavStrip.ViewModel"
             xmlns:shell="using:ScreenShare.App.Features.Shell.ViewModel"
             x:Class="ScreenShare.App.Features.Shell.NavStrip.View.NavStripView"
             x:DataType="vm:NavStripViewModel">

  <!-- Inset written out: GapPanel holds the same 12, and a Thickness has no token to name. -->
  <Border Classes="navstrip" Padding="12,0">
    <Grid ColumnDefinitions="Auto,*,Auto">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <!-- Height pinned to the control token: a segment sized by its text face measures per platform. -->
        <ListBox Theme="{StaticResource SegmentedControlTheme}"
                 ItemContainerTheme="{StaticResource SegmentItemTheme}"
                 Height="{StaticResource ControlHeight}"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}">

          <ListBox.Styles>
            <!-- On the container, not inside the item: the theme's :disabled selector watches the container. -->
            <Style Selector="ListBoxItem" x:DataType="shell:DestinationTab">
              <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="shell:DestinationTab">
              <!--
                Read back off the container: a TextBlock foreground is stated app-wide, so inheritance loses
                to it and every segment state comes out one colour.
              -->
              <TextBlock Text="{Binding Label}"
                         Foreground="{Binding $parent[ListBoxItem].Foreground}"
                         FontWeight="{Binding $parent[ListBoxItem].FontWeight}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!--
        In the star column and wrapping: sized to its own text, the hint pushes the sharing pill off a narrow
        window.
      -->
      <TextBlock Grid.Column="1"
                 Classes="hint"
                 Text="{Binding Hint}"
                 IsVisible="{Binding ShowsHint}"
                 TextWrapping="Wrap"
                 Margin="10,0"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <controls:StatusPill Label="{Binding SharingLabel}"
                             Detail="{Binding SharingTimer}"
                             IsVisible="{Binding ShowsSharing}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
