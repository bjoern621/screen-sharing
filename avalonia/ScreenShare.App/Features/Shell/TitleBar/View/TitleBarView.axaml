<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Shell.TitleBar.ViewModel"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="ScreenShare.App.Features.Shell.TitleBar.View.TitleBarView"
             x:DataType="vm:TitleBarViewModel">

  <!--
    The caption shapes as Windows draws them, in the 10x10 box Design/Icons.axaml maps onto pixels one to one.

    Coordinates land on halves because a 1px stroke centres on the line it is given: x.5 fills pixel column x,
    an integer splits over two columns at half strength.

    Restore is the two-window shape: an 8x8 front for the size the window returns to, and behind it the part
    of the maximised one that front no longer covers.
  -->
  <UserControl.Resources>
    <StreamGeometry x:Key="CaptionMinimise">M0,5.5 H10</StreamGeometry>
    <StreamGeometry x:Key="CaptionMaximise">M0.5,0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="CaptionRestore">M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5</StreamGeometry>
    <StreamGeometry x:Key="CaptionClose">M0.5,0.5 L9.5,9.5 M0.5,9.5 L9.5,0.5</StreamGeometry>
  </UserControl.Resources>

  <!--
    Left inset written out: GapPanel holds the same 12, and a Thickness has no token to name.

    The band stands in for the native caption the window extended itself over, so it claims the TitleBar role:
    drag, double-click to maximise and the right-click window menu stay the platform's rather than a handler's.
  -->
  <Border Classes="chromeband"
          Height="{StaticResource TitleBarHeight}"
          Padding="12,0,0,0"
          chrome:WindowDecorationProperties.ElementRole="TitleBar">

    <Grid ColumnDefinitions="Auto,*,Auto">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource GapControl}"
                  VerticalAlignment="Center">

        <!--
          The app mark, in the palette's one red.
          Its 12px has no metric token, so the radius takes the smallest one the design states.
        -->
        <Border Width="12"
                Height="12"
                CornerRadius="{StaticResource RadiusSegment}"
                Background="{StaticResource AttentionBrush}"
                VerticalAlignment="Center" />

        <TextBlock Classes="title"
                   Text="{Binding Title}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!--
        The platform's caption shapes rather than the app's icon set: these stand in for the buttons Windows
        hid when the client area was extended over the caption, and a reader compares them with every other
        window on the screen.

        Stroke read off the button, because Path.caption's own brush would not follow the button's state.

        Each role names the caption button it stands in for. On Win32 that is HTMINBUTTON, HTMAXBUTTON and
        HTCLOSE, which restore the system's minimise and restore animations and the snap-layout flyout under
        maximise. Elsewhere the role is inert and the command does the work.
      -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">

        <Button Theme="{StaticResource WindowControlButton}"
                Command="{Binding MinimiseCommand}"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                ToolTip.Tip="Minimise">
          <Path Classes="caption"
                Data="{StaticResource CaptionMinimise}"
                Stroke="{Binding $parent[Button].Foreground}" />
        </Button>

        <!--
          One button and two glyphs, as Windows has it: maximise while the window is normal, restore while it
          is maximised. Both are present and the bound state picks, so no handler writes the shape.
        -->
        <Button Theme="{StaticResource WindowControlButton}"
                Command="{Binding MaximiseCommand}"
                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                ToolTip.Tip="{Binding MaximiseLabel}">
          <Panel>
            <Path Classes="caption"
                  Data="{StaticResource CaptionMaximise}"
                  Stroke="{Binding $parent[Button].Foreground}"
                  IsVisible="{Binding !IsMaximised}" />
            <Path Classes="caption"
                  Data="{StaticResource CaptionRestore}"
                  Stroke="{Binding $parent[Button].Foreground}"
                  IsVisible="{Binding IsMaximised}" />
          </Panel>
        </Button>

        <Button Theme="{StaticResource WindowControlButton}"
                Command="{Binding CloseCommand}"
                chrome:WindowDecorationProperties.ElementRole="CloseButton"
                ToolTip.Tip="Close">
          <Path Classes="caption"
                Data="{StaticResource CaptionClose}"
                Stroke="{Binding $parent[Button].Foreground}" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
