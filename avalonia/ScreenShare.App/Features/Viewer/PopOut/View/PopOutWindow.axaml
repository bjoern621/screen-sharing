<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
        xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
        xmlns:view="using:ScreenShare.App.Features.Viewer.View"
        x:Class="ScreenShare.App.Features.Viewer.PopOut.View.PopOutWindow"
        x:DataType="tile:TileViewModel"
        Title="{Binding Title}"
        Width="640" Height="360"
        MinWidth="240" MinHeight="160"
        Background="{StaticResource TileBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding LeaveFullscreen}" />
  </Window.KeyBindings>

  <!--
    One tile through the grid's own solver,
    letterboxed at its stream's shape in whatever shape this window is dragged to
    (Features/Viewer/Model/TileLayout.cs).

    Maximised, Windows hangs the frame's resize border off every edge of the work area, and the client area goes
    with it, so an unpadded picture loses its edges under the screen edge.
    OffScreenMargin is that overhang, read continuously, so restoring gives it back to zero.
  -->
  <view:TileGrid Margin="{Binding $parent[Window].OffScreenMargin}">
    <tiles:TileCard view:TileGrid.Aspect="{Binding Aspect}" />
  </view:TileGrid>

</Window>
