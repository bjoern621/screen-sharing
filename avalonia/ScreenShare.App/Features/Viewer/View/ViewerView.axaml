<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.ViewModel"
             xmlns:view="using:ScreenShare.App.Features.Viewer.View"
             xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             xmlns:watch="using:ScreenShare.App.Features.Viewer.WatchSettings.View"
             x:Class="ScreenShare.App.Features.Viewer.View.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Background="{StaticResource SurfaceBrush}">

  <UserControl.Styles>
    <!-- A path the relay knows about but nothing is publishing to reads as absent, not broken. -->
    <Style Selector="TextBlock.idle">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.watched">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
      The live dot: one shape, on or off, rather than a word per entry. Its size is the design's
      dot rather than a number chosen here.
    -->
    <Style Selector="Ellipse.live">
      <Setter Property="Width" Value="{StaticResource DotSize}" />
      <Setter Property="Height" Value="{StaticResource DotSize}" />
      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.live.on">
      <Setter Property="Fill" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!--
      One rail entry. The action inside it appears on hover or while the stream is in the grid, so
      a rail of eight streams is eight names rather than eight buttons.
    -->
    <Style Selector="Border.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="7,3,3,3" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    </Style>
    <Style Selector="Border.entry:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.entry Button.action">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.entry:pointerover Button.action, Border.entry Button.action.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <!--
    A rail beside a grid. The rail is what the relay is carrying and what this machine has open on
    it; the grid is the streams the reader asked to see, drawn from the GPU memory the backend
    decoded them into (docs/viewer-architecture.md, "The frame channel").

    Beside rather than above, which is the whole of the change from the table this replaces: a
    list stacked over the grid made the two compete for height, and the grid is the thing being
    watched.

    The arrangement is this shell's whole business and nothing about it crosses the contract: the
    backend describes decodes, and a decode is not a tile (docs/ipc-api.md).

    No title bar, no nav strip and no status bar - the shell owns all three, and a second copy
    would be a second definition of where the reader is.
  -->
  <Grid ColumnDefinitions="Auto,*,Auto">

    <!-- === The rail ============================================================== -->

    <Border Grid.Column="0"
            Width="{Binding RailWidth}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="{StaticResource InsetControl}">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="caption" Text="{Binding ShowingLabel}"
                     VerticalAlignment="Center" Margin="7,0,0,0"
                     IsVisible="{Binding !IsRailCollapsed}" />

          <!--
            The settings that govern how this machine receives, opened beside the tiles they
            govern rather than buried in the wizard for what it sends
            (Features/Fields/Model/GroupPlacement.cs).
          -->
          <Button Grid.Column="1" Theme="{StaticResource LinkButton}"
                  Command="{Binding ToggleWatchSettings}"
                  ToolTip.Tip="{Binding WatchSettingsTip}">
            <ti:TablerIcon Icon="IconSettings" />
          </Button>

          <Button Grid.Column="2" Theme="{StaticResource LinkButton}"
                  Command="{Binding ToggleRail}"
                  ToolTip.Tip="{Binding RailToggleTip}">
            <ti:TablerIcon Icon="{Binding RailGlyph}" />
          </Button>
        </Grid>

        <!-- The backend's own sentence when it refused to open or close something, shown as it stands. -->
        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Text="{Binding Refusal}" TextWrapping="Wrap"
                   IsVisible="{Binding HasRefusal}" Margin="2,10,2,0" />

        <!-- Why the list is empty, which separates an unread relay from an idle one. -->
        <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Notice}" TextWrapping="Wrap"
                   IsVisible="{Binding HasNotice}" Margin="2,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Streams}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamRowViewModel">

                <!--
                  One entry per relay path: the name, whether anything is publishing to it, and
                  the action that puts it in the grid. Everything else the relay says about it -
                  tracks, rate, readers - is in the entry's own menu, because those are
                  diagnostics and this list is navigation.
                -->
                <Border Classes="entry" Margin="0,1" ToolTip.Tip="{Binding Detail}">

                  <Border.ContextFlyout>
                    <MenuFlyout>
                      <!--
                        One item per leg the backend offered. Whether a leg can carry this stream
                        is the backend's answer when the viewer is opened, not a greying decided
                        here: the relay snapshot can be older than the stream, so refusing from a
                        stale format would block a viewer that would have worked.
                      -->
                      <MenuItem Header="Open in player" ItemsSource="{Binding Legs}">
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:WatchLegViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="Command" Value="{Binding Toggle}" />
                            <Setter Property="ToggleType" Value="CheckBox" />
                            <Setter Property="IsChecked" Value="{Binding IsOpen, Mode=OneWay}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="{Binding Tracks}" IsEnabled="False" />
                      <MenuItem Header="{Binding Detail}" IsEnabled="False" />
                      <MenuItem Header="{Binding Readers}" IsEnabled="False" />
                    </MenuFlyout>
                  </Border.ContextFlyout>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapTight}">
                    <Ellipse Grid.Column="0" Classes="live" Classes.on="{Binding IsReady}" />

                    <TextBlock Grid.Column="1" Classes="ident" Text="{Binding Name}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding $parent[UserControl].((vm:ViewerViewModel)DataContext).IsRailCollapsed, Converter={x:Static BoolConverters.Not}}"
                               Classes.idle="{Binding !IsReady}" Classes.watched="{Binding IsWatched}" />

                    <!--
                      The watch action. One control and not one per leg, because which protocol a
                      tile receives on is a setting the backend resolves and not a choice this
                      entry offers (docs/viewer-architecture.md, "Two legs, two protocols").

                      A button rather than a toggle: there is no themed toggle here, and a bare one
                      arrives wearing Fluent beside controls that wear the design
                      (avalonia/README.md, "one button and one of every input"). What it is doing
                      is said by its glyph and by the entry it sits in, which already draws watched
                      streams differently.
                    -->
                    <Button Grid.Column="2" Classes="action"
                            Classes.on="{Binding IsTiled}"
                            Theme="{StaticResource LinkButton}"
                            Command="{Binding Show}"
                            ToolTip.Tip="{Binding WatchLabel}"
                            controls:Pending.IsActive="{Binding Show.IsRunning}">
                      <ti:TablerIcon Icon="{Binding WatchGlyph}" />
                    </Button>
                  </Grid>
                </Border>

              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <!-- === The grid ============================================================== -->

    <!--
      No summary and no hint in here. The shell's status band already prints both, off this same
      view model, and a second copy on the screen the band describes is two places one fact is
      written (Features/Shell).
    -->
    <DockPanel Grid.Column="1" Margin="{StaticResource InsetPanel}">

      <!--
        Each tile is a composition surface rather than a native child window, which is what lets
        the chrome over the picture stay over it: a native window would draw above every Avalonia
        control (avalonia/README.md, "What is not settled yet").

        The panel arranges; the arrangement itself is computed by a pure solver that is tested
        without a window (Features/Viewer/Model/TileLayout.cs).
      -->
      <ScrollViewer Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <view:TileGrid Mode="{Binding Mode}"
                             Viewport="{Binding #GridScroll.Bounds.Height}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="tile:TileViewModel">
              <!--
                The two facts the panel arranges by, declared on the container rather than read
                out of anybody's data context: the shape of the stream, and whether this is the
                focused tile.
              -->
              <Setter Property="view:TileGrid.Aspect" Value="{Binding Aspect}" />
              <Setter Property="view:TileGrid.IsStaged" Value="{Binding IsFocused}" />
            </ControlTheme>
          </ItemsControl.ItemContainerTheme>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tile:TileViewModel">
              <tiles:TileCard />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

    <!-- === The settings panel ==================================================== -->

    <!--
      How this machine receives, beside the tiles it governs. A fixed width for the reason the
      setup rail has one: a column that reflowed would move the controls under the reader's hand.

      It is a column of its own rather than a flyout because a reader changes a leg and watches
      what the next tile does with it, and a panel that closed on every click would make that two
      motions instead of one.
    -->
    <Border Grid.Column="2"
            Width="330"
            Padding="{StaticResource InsetPanel}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding IsWatchSettingsOpen}">
      <watch:WatchSettingsView DataContext="{Binding Watch}" />
    </Border>

    <!--
      The fullscreen tile. It is drawn over every column rather than inside the grid, because
      fullscreen is a property of this window and not an arrangement of tiles: the chrome goes,
      the rail goes, and one stream has the window.
    -->
    <Panel Grid.Column="0" Grid.ColumnSpan="3"
           Background="{StaticResource SurfaceBrush}"
           IsVisible="{Binding HasFullscreen}">
      <ContentControl Content="{Binding FullscreenTile}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="tile:TileViewModel">
            <tiles:TileCard />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>

  </Grid>

</UserControl>
