<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.ViewModel"
             xmlns:members="using:ScreenShare.App.Features.Viewer.Members.View"
             xmlns:view="using:ScreenShare.App.Features.Viewer.View"
             xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             xmlns:watch="using:ScreenShare.App.Features.Viewer.WatchSettings.View"
             x:Class="ScreenShare.App.Features.Viewer.View.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Background="{StaticResource SurfaceBrush}">

  <UserControl.Styles>
    <!-- A path nothing is publishing to reads as absent, not broken. -->
    <Style Selector="TextBlock.idle">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.watched">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Ellipse.live">
      <Setter Property="Width" Value="{StaticResource DotSize}" />
      <Setter Property="Height" Value="{StaticResource DotSize}" />
      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.live.on">
      <Setter Property="Fill" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!--
      The action shows on hover, while its stream is in the grid, and while a press is being answered.
      The third case is not spare: a press makes the row's command unavailable,
      an unavailable control takes no pointer, and the entry would hide the spinner as it started turning.
    -->
    <Style Selector="Button.entry Button.action">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.entry:pointerover Button.action, Button.entry Button.action.on, Button.entry Button.action:pending">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <!--
    A rail of what the relay carries, beside a grid of what the reader asked to see.
    No title bar, no nav strip and no status band, the shell owning all three.
  -->
  <Grid ColumnDefinitions="Auto,*">

    <Border Grid.Column="0"
            Width="{Binding RailWidth}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="{StaticResource InsetControl}">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="caption" Text="{Binding ShowingLabel}"
                     VerticalAlignment="Center" Margin="7,0,0,0"
                     IsVisible="{Binding ShowsRailNames}" />

          <!--
            Opens the watch group, drawn by this screen and not by the publish wizard
            (Features/Fields/Model/GroupPlacement.cs).
          -->
          <Button Grid.Column="1" Theme="{StaticResource IconButton}"
                  Command="{Binding WatchColumn.Toggle}"
                  ToolTip.Tip="{Binding WatchColumn.ToggleTip}">
            <ti:TablerIcon Classes="button" Icon="IconSettings" />
          </Button>

          <!--
            Offered while the window has the width for the names.
            Narrower than that the rail is already down to its dots, and a control that changes nothing
            reads as broken (docs/design-language.md, "Narrow windows").
          -->
          <Button Grid.Column="2" Theme="{StaticResource IconButton}"
                  IsVisible="{Binding ShowsRailToggle}"
                  Command="{Binding ToggleRail}"
                  ToolTip.Tip="{Binding RailToggleTip}">
            <ti:TablerIcon Classes="button" Icon="{Binding RailGlyph}" />
          </Button>
        </Grid>

        <!--
          Who else is in the group, above the list of what they are sending.
          Gone with the names when the rail is collapsed: a member list is names,
          and a column narrowed to its dots has none left to draw.
        -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                    IsVisible="{Binding ShowsRailNames}">
          <members:MembersView DataContext="{Binding Members}" />
          <Border Classes="dividerh" Margin="0,10,0,0" />
        </StackPanel>

        <!--
          Backend's own sentence for a refused open or close, shown as it arrived.
          Red without a condition: a refusal is a failure and nothing else lands here
          (docs/design-language.md, "Palette").
        -->
        <SelectableTextBlock DockPanel.Dock="Bottom" Classes="hint danger" Text="{Binding Refusal}"
                             IsVisible="{Binding HasRefusal}" Margin="2,10,2,0" />

        <!--
          What the relay answered, the reader's only account of an unreachable one.
          Red for the backend's own sentence alone: a relay carrying nothing answered.
        -->
        <SelectableTextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Notice}"
                             Classes.danger="{Binding NoticeIsFailure}"
                             IsVisible="{Binding HasNotice}" Margin="2,0" />

        <!--
          Left-aligned rather than centred: it belongs to the line above it and not to the empty grid.
          The arc takes that line's hue, and the line it turns under is the failure one:
          a notice about the relay has nothing being dialled behind it.
        -->
        <Border DockPanel.Dock="Top"
                Background="Transparent"
                HorizontalAlignment="Left"
                Margin="2,6,2,0"
                IsVisible="{Binding IsDialling}"
                ToolTip.Tip="{x:Static copy:Cards.Redialling}">
          <controls:Spinner Foreground="{StaticResource AttentionBrush}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Streams}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamRowViewModel">

                <Button Classes="entry" Theme="{StaticResource RowButton}" Margin="0,1"
                        Command="{Binding Show}">

                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <!--
                        One item per leg the catalog offered, none greyed.
                        Whether a leg carries this stream is answered against the stream when the viewer opens,
                        and the relay snapshot can be older than the stream.
                      -->
                      <MenuItem Header="Open in player" ItemsSource="{Binding Legs}">
                        <MenuItem.Icon>
                          <ti:TablerIcon Icon="IconPlayerPlay" />
                        </MenuItem.Icon>
                        <!--
                          The tick reads whether the leg is open.
                          A ToggleType would write its own IsChecked on the click, reporting a call the backend
                          has yet to answer.
                        -->
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:WatchLegViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="Command" Value="{Binding Toggle}" />
                            <Setter Property="IsChecked" Value="{Binding IsOpen, Mode=OneWay}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>

                      <!--
                        A roster of its own, the legs a browser reaches not being the legs a player does.
                        No tick on these rows: a tab belongs to the browser, so this side can neither read
                        whether it is open nor close it.
                        The row names an action where every other row here names a state.
                      -->
                      <MenuItem Header="Open in browser" ItemsSource="{Binding BrowserLegs}">
                        <MenuItem.Icon>
                          <ti:TablerIcon Icon="IconBrowser" />
                        </MenuItem.Icon>
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:BrowserLegViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="Command" Value="{Binding Open}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>

                      <Separator />

                      <!--
                        Printed rather than offered.
                        A greyed row in this product reads as an action some configuration took away.
                      -->
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Tracks}" />
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Detail}" />
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Readers}" />
                    </MenuFlyout>
                  </Button.ContextFlyout>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapTight}">
                    <Ellipse Grid.Column="0" Classes="live" Classes.on="{Binding IsReady}" />

                    <TextBlock Grid.Column="1" Classes="ident" Text="{Binding Label}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding $parent[UserControl].((vm:ViewerViewModel)DataContext).ShowsRailNames}"
                               Classes.idle="{Binding !IsReady}" Classes.watched="{Binding IsWatched}" />

                    <!--
                      One control and not one per leg:
                      which protocol a tile receives on is a setting the backend resolves,
                      not a choice this entry offers.

                      Runs the entry's own command, so a press landing beside the glyph does the same thing.
                      What it owns alone is the wait.

                      A button rather than a toggle, a bare toggle arriving wearing Fluent beside controls
                      that wear the design (avalonia/README.md).
                    -->
                    <Button Grid.Column="2" Classes="action"
                            Classes.on="{Binding IsTiled}"
                            Theme="{StaticResource IconButton}"
                            Command="{Binding Show}"
                            ToolTip.Tip="{Binding WatchLabel}"
                            controls:Pending.IsActive="{Binding Show.IsRunning}">
                      <ti:TablerIcon Classes="button" Icon="{Binding WatchGlyph}" />
                    </Button>
                  </Grid>
                </Button>

              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <!--
      The grid, and the settings panel beside it or over it (docs/design-language.md, "Narrow windows").
      The panel measures against the rail as well as the tiles, the three standing on one window.
    -->
    <controls:SideColumnPanel Grid.Column="1"
                              Beside="{Binding WatchColumn.IsBeside}"
                              SideOnLeft="{Binding WatchColumn.IsOnLeft}"
                              SideWidth="{Binding WatchColumn.Width}">

    <!-- No summary and no hint here: the shell's status band prints both off this same view model. -->
    <DockPanel Margin="{StaticResource InsetPanel}">

      <ScrollViewer Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <view:TileGrid Mode="{Binding Mode}"
                             Viewport="{Binding #GridScroll.Bounds.Height}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="tile:TileViewModel">
              <Setter Property="view:TileGrid.Aspect" Value="{Binding Aspect}" />
              <Setter Property="view:TileGrid.IsFocusedTile" Value="{Binding IsFocused}" />
            </ControlTheme>
          </ItemsControl.ItemContainerTheme>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tile:TileViewModel">
              <!--
                The one host that draws the plate.
                A stream whose picture went elsewhere keeps its slot here, popped out or fullscreen,
                so which of the two a card draws is the host's to state
                (Features/Viewer/Tile/View/TileCard.axaml.cs).
              -->
              <tiles:TileCard PictureElsewhere="{Binding PictureElsewhere}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

    <!--
      A fixed width beside the grid: a column that reflowed would move the controls under the reader's hand.
      A column rather than a flyout: a leg is changed while the next tile is watched,
      and a flyout would close on every click.
    -->
    <Border Padding="{StaticResource InsetPanel}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding WatchColumn.IsShowing}">
      <watch:WatchSettingsView DataContext="{Binding Watch}" />
    </Border>

    </controls:SideColumnPanel>

    <!--
      The stream filling this window, over every column rather than inside the grid: fullscreen is a property
      of the window and not an arrangement of tiles, so the rail and the grid go and the shell takes its bands
      off the window too (Features/Shell/ViewModel/ShellViewModel.cs).

      A TileGrid of one card letterboxes the picture, rather than a second definition of a letterbox living
      here (Features/Viewer/Model/TileLayout.cs).
    -->
    <Panel Grid.Column="0" Grid.ColumnSpan="2"
           Background="{StaticResource TileBrush}"
           IsVisible="{Binding HasFullscreen}">
      <ContentControl Content="{Binding FullscreenTile}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="tile:TileViewModel">
            <view:TileGrid>
              <tiles:TileCard view:TileGrid.Aspect="{Binding Aspect}" />
            </view:TileGrid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>

  </Grid>

</UserControl>
