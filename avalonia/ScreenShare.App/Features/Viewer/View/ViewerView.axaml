<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.ViewModel"
             xmlns:view="using:ScreenShare.App.Features.Viewer.View"
             xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             xmlns:watch="using:ScreenShare.App.Features.Viewer.WatchSettings.View"
             x:Class="ScreenShare.App.Features.Viewer.View.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Background="{StaticResource SurfaceBrush}">

  <UserControl.Styles>
    <!-- A path nothing is publishing to reads as absent, not broken. -->
    <Style Selector="TextBlock.idle">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.watched">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Ellipse.live">
      <Setter Property="Width" Value="{StaticResource DotSize}" />
      <Setter Property="Height" Value="{StaticResource DotSize}" />
      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.live.on">
      <Setter Property="Fill" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!--
      The action shows on hover, while its stream is in the grid, and while a press is being
      answered. The third case is not spare: a press makes the row's command unavailable, an
      unavailable control takes no pointer, and the entry would hide the spinner as it started
      turning.
    -->
    <Style Selector="Button.entry Button.action">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.entry:pointerover Button.action, Button.entry Button.action.on, Button.entry Button.action:pending">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <!--
    A rail of what the relay carries, beside a grid of what the reader asked to see. The
    arrangement crosses no contract: the backend describes decodes, and a decode is not a tile
    (docs/ipc-api.md).

    No title bar, no nav strip and no status band, because the shell owns all three.
  -->
  <Grid ColumnDefinitions="Auto,*,Auto">

    <Border Grid.Column="0"
            Width="{Binding RailWidth}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="{StaticResource InsetControl}">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="caption" Text="{Binding ShowingLabel}"
                     VerticalAlignment="Center" Margin="7,0,0,0"
                     IsVisible="{Binding !IsRailCollapsed}" />

          <!--
            Opens the watch group, which this screen draws and the publish wizard does not
            (Features/Fields/Model/GroupPlacement.cs).
          -->
          <Button Grid.Column="1" Theme="{StaticResource IconButton}"
                  Command="{Binding ToggleWatchSettings}"
                  ToolTip.Tip="{Binding WatchSettingsTip}">
            <ti:TablerIcon Classes="button" Icon="IconSettings" />
          </Button>

          <Button Grid.Column="2" Theme="{StaticResource IconButton}"
                  Command="{Binding ToggleRail}"
                  ToolTip.Tip="{Binding RailToggleTip}">
            <ti:TablerIcon Classes="button" Icon="{Binding RailGlyph}" />
          </Button>
        </Grid>

        <!-- The backend's own sentence for a refused open or close, shown as it arrived. -->
        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Text="{Binding Refusal}" TextWrapping="Wrap"
                   IsVisible="{Binding HasRefusal}" Margin="2,10,2,0" />

        <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Notice}" TextWrapping="Wrap"
                   IsVisible="{Binding HasNotice}" Margin="2,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Streams}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamRowViewModel">

                <Button Classes="entry" Theme="{StaticResource RowButton}" Margin="0,1"
                        Command="{Binding Show}" ToolTip.Tip="{Binding Detail}">

                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <!--
                        One item per leg the backend offered, none of them greyed by a format:
                        whether a leg carries this stream is answered against the stream when the
                        viewer opens, and the relay snapshot can be older than the stream.
                      -->
                      <MenuItem Header="Open in player" ItemsSource="{Binding Legs}">
                        <MenuItem.Icon>
                          <ti:TablerIcon Icon="IconPlayerPlay" />
                        </MenuItem.Icon>
                        <!--
                          The tick reads whether the leg is open. A ToggleType would write its own
                          IsChecked on the click, reporting a call the backend has yet to answer.
                        -->
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:WatchLegViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <!--
                              The whole leg as the header, so a leg with no player keeps its place
                              and carries its reason in the row: a disabled row takes no pointer,
                              and a tip on it never opens (docs/field-availability.md).
                            -->
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="HeaderTemplate">
                              <DataTemplate x:DataType="vm:WatchLegViewModel">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Label}" />
                                  <TextBlock Classes="hint"
                                             MaxWidth="260"
                                             TextWrapping="Wrap"
                                             TextTrimming="None"
                                             IsVisible="{Binding HasReason}"
                                             Text="{Binding Reason}" />
                                </StackPanel>
                              </DataTemplate>
                            </Setter>
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            <Setter Property="Command" Value="{Binding Toggle}" />
                            <Setter Property="IsChecked" Value="{Binding IsOpen, Mode=OneWay}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>

                      <!--
                        A roster of its own, since the legs a browser reaches are not the legs a
                        player does. No tick on these rows: a tab belongs to the browser, so this
                        side can neither read whether it is open nor close it, and the row names
                        an action where every other row here names a state.
                      -->
                      <MenuItem Header="Open in browser" ItemsSource="{Binding BrowserLegs}">
                        <MenuItem.Icon>
                          <ti:TablerIcon Icon="IconBrowser" />
                        </MenuItem.Icon>
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="vm:BrowserLegViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="Command" Value="{Binding Open}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>

                      <Separator />

                      <!--
                        Printed rather than offered. A greyed row in this product is an action
                        some configuration took away, which is not what these are.
                      -->
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Tracks}" />
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Detail}" />
                      <MenuItem Theme="{StaticResource MenuNote}" Header="{Binding Readers}" />
                    </MenuFlyout>
                  </Button.ContextFlyout>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapTight}">
                    <Ellipse Grid.Column="0" Classes="live" Classes.on="{Binding IsReady}" />

                    <TextBlock Grid.Column="1" Classes="ident" Text="{Binding Name}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding $parent[UserControl].((vm:ViewerViewModel)DataContext).IsRailCollapsed, Converter={x:Static BoolConverters.Not}}"
                               Classes.idle="{Binding !IsReady}" Classes.watched="{Binding IsWatched}" />

                    <!--
                      One control and not one per leg: which protocol a tile receives on is a
                      setting the backend resolves, not a choice this entry offers.

                      It runs the entry's own command, so a press that lands beside the glyph does
                      the same thing. What it owns alone is the wait.

                      A button rather than a toggle, because a bare toggle arrives wearing Fluent
                      beside controls that wear the design (avalonia/README.md).
                    -->
                    <Button Grid.Column="2" Classes="action"
                            Classes.on="{Binding IsTiled}"
                            Theme="{StaticResource IconButton}"
                            Command="{Binding Show}"
                            ToolTip.Tip="{Binding WatchLabel}"
                            controls:Pending.IsActive="{Binding Show.IsRunning}">
                      <ti:TablerIcon Classes="button" Icon="{Binding WatchGlyph}" />
                    </Button>
                  </Grid>
                </Button>

              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <!--
      No summary and no hint here: the shell's status band prints both off this same view model.
    -->
    <DockPanel Grid.Column="1" Margin="{StaticResource InsetPanel}">

      <ScrollViewer Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <view:TileGrid Mode="{Binding Mode}"
                             Viewport="{Binding #GridScroll.Bounds.Height}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="tile:TileViewModel">
              <!-- What the panel arranges by. It reads attached values, never a data context. -->
              <Setter Property="view:TileGrid.Aspect" Value="{Binding Aspect}" />
              <Setter Property="view:TileGrid.IsStaged" Value="{Binding IsFocused}" />
            </ControlTheme>
          </ItemsControl.ItemContainerTheme>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tile:TileViewModel">
              <!--
                The one host that draws the plate. A popped-out stream keeps its slot here and its
                picture is in the window it went to, so which of the two a card draws is the host's
                to state (Features/Viewer/Tile/View/TileCard.axaml.cs).
              -->
              <tiles:TileCard PictureElsewhere="{Binding IsPoppedOut}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

    <!--
      A fixed width, because a column that reflowed would move the controls under the reader's
      hand; a column rather than a flyout, because a leg is changed while the next tile is watched
      and a flyout would close on every click.
    -->
    <Border Grid.Column="2"
            Width="330"
            Padding="{StaticResource InsetPanel}"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding IsWatchSettingsOpen}">
      <watch:WatchSettingsView DataContext="{Binding Watch}" />
    </Border>

    <!--
      The stream filling this window, over every column rather than inside the grid: fullscreen is
      a property of the window and not an arrangement of tiles, so the rail and the grid go and the
      shell takes its bands off the window too (Features/Shell/ViewModel/ShellViewModel.cs).

      A TileGrid of one card letterboxes the picture, rather than a second definition of a
      letterbox living here (Features/Viewer/Model/TileLayout.cs).
    -->
    <Panel Grid.Column="0" Grid.ColumnSpan="3"
           Background="{StaticResource TileBrush}"
           IsVisible="{Binding HasFullscreen}">
      <ContentControl Content="{Binding FullscreenTile}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="tile:TileViewModel">
            <view:TileGrid>
              <tiles:TileCard view:TileGrid.Aspect="{Binding Aspect}" />
            </view:TileGrid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>

  </Grid>

</UserControl>
