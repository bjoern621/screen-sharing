<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.WatchSettings.ViewModel"
             x:Class="ScreenShare.App.Features.Viewer.WatchSettings.View.WatchSettingsView"
             x:DataType="vm:WatchSettingsViewModel">

  <!--
    How this machine receives, beside the tiles it governs. It is the same group of the same
    resolved form the setup wizard used to draw as a step, rendered by the same generic
    renderer - what moved is which screen places it, which is the shell's own business
    (Features/Fields/Model/GroupPlacement.cs).

    The panel scrolls on its own and the commit sits under it, so the button stays reachable
    however many controls the group carries - the same arrangement the setup rail has, and for
    the same reason.

    Three rows, because the panel is dismissed from its own edge as well as from the rail that
    opened it. A column that could only be closed by the button that opened it sends the reader
    back across the window for a control they are not looking at, and the panel covers the side
    of the grid their pointer is already on.
  -->

  <Grid RowDefinitions="Auto,*,Auto">

    <!--
      The dismissal, and nothing beside it. The heading is the group card's own a few pixels
      below (Features/Fields/View/FieldGroupView.axaml), so a second one here would be the same
      word printed twice.
    -->
    <Button Grid.Row="0"
            HorizontalAlignment="Right"
            Margin="0,0,0,6"
            Theme="{StaticResource IconButton}"
            Command="{Binding CloseCommand}"
            ToolTip.Tip="{Binding CloseTip}">
      <ti:TablerIcon Classes="button" Icon="IconX" />
    </Button>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <fields:FieldGroupView DataContext="{Binding Group}" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="{StaticResource GapTight}">

      <!--
        That the controls above are not what a decode would open on. It sits over the button
        that fixes it rather than over the fields, because it is about the whole group and the
        press is the answer to it.
      -->
      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 IsVisible="{Binding IsUnkept}"
                 Text="{Binding UnkeptNotice}" />

      <!-- What the backend said about the last save, in its own words. -->
      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 IsVisible="{Binding HasNotice}"
                 Text="{Binding Notice}" />

      <Button Theme="{StaticResource PrimaryButton}"
              Height="{StaticResource FooterButtonHeight}"
              HorizontalAlignment="Stretch"
              Content="Keep these settings"
              Command="{Binding SaveCommand}"
              controls:Pending.IsActive="{Binding SaveCommand.IsRunning}"
              ToolTip.Tip="{Binding SaveTip}" />
    </StackPanel>

  </Grid>

</UserControl>
