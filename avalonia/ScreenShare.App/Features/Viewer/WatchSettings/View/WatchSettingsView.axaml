<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.WatchSettings.ViewModel"
             x:Class="ScreenShare.App.Features.Viewer.WatchSettings.View.WatchSettingsView"
             x:DataType="vm:WatchSettingsViewModel">

  <!--
    One group of the resolved form, drawn by the renderer every wizard step shares.
    Which screen places a group is the shell's own business (Features/Fields/Model/GroupPlacement.cs).

    Controls scroll and the commit is pinned under them, so the button stays reachable whatever the group carries.

    The dismissal repeats on this edge: the rail that opened the panel sits across the window,
    and the panel already covers the side of the grid the pointer is on.
  -->

  <Grid RowDefinitions="Auto,*,Auto">

    <!--
      No heading beside it: the group card carries its own (Features/Fields/View/FieldGroupView.axaml),
      and a second would print one word twice.
    -->
    <Button Grid.Row="0"
            HorizontalAlignment="Right"
            Margin="0,0,0,6"
            Theme="{StaticResource IconButton}"
            Command="{Binding CloseCommand}"
            ToolTip.Tip="{Binding CloseTip}">
      <ti:TablerIcon Classes="button" Icon="IconX" />
    </Button>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <fields:FieldGroupView DataContext="{Binding Group}" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="{StaticResource GapTight}">

      <!--
        Over the button rather than over the fields: the sentence is about the whole group,
        and the press answers it.
      -->
      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 IsVisible="{Binding IsUnkept}"
                 Text="{Binding UnkeptNotice}" />

      <!-- Backend's own sentence about the last save, unrewritten. -->
      <SelectableTextBlock Classes="hint"
                           IsVisible="{Binding HasNotice}"
                           Text="{Binding Notice}" />

      <Button Theme="{StaticResource PrimaryButton}"
              Height="{StaticResource FooterButtonHeight}"
              HorizontalAlignment="Stretch"
              Content="Keep these settings"
              Command="{Binding SaveCommand}"
              controls:Pending.IsActive="{Binding SaveCommand.IsRunning}"
              ToolTip.Tip="{Binding SaveTip}" />
    </StackPanel>

  </Grid>

</UserControl>
