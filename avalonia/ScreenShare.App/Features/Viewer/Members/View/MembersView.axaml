<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:model="using:ScreenShare.App.Features.Viewer.Members.Model"
             xmlns:vm="using:ScreenShare.App.Features.Viewer.Members.ViewModel"
             x:Class="ScreenShare.App.Features.Viewer.Members.View.MembersView"
             x:DataType="vm:MembersViewModel">

  <UserControl.Styles>
    <Style Selector=":is(TextBlock).member">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).member.own">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="{StaticResource GapTight}">

    <TextBlock Classes="caption" Text="{Binding Title}" Margin="7,0,0,0" />

    <!--
      A row per member: what they go by, whether the relay carries a stream from them, and which row is
      this machine.
      Nothing about what anybody is watching, which the group does not state and this card could not
      draw.
    -->
    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="model:MemberRow">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource GapTight}"
                  MinHeight="{StaticResource TextRowHeight}"
                  Margin="7,0">
              <TextBlock Grid.Column="0" Classes="ident member" Classes.own="{Binding IsSelf}"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

              <TextBlock Grid.Column="1" Classes="hint"
                         Text="{Binding Detail}"
                         IsVisible="{Binding HasDetail}"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Classes="rowrule" Margin="7,0" IsVisible="{Binding !IsLast}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Why the list is empty: unread, outside the group, or a group nobody is in. -->
    <SelectableTextBlock Classes="hint" Text="{Binding Notice}" TextWrapping="Wrap"
                         IsVisible="{Binding !HasRows}" Margin="2,0" />

    <!--
      One action, the one this machine is not already in the state of.
      A group is left by the machine in it and by nobody else, so no row here affords anything.
    -->
    <Button Content="{Binding JoinLabel}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            IsVisible="{Binding CanJoin}"
            Command="{Binding Join}"
            controls:Pending.IsActive="{Binding Join.IsRunning}" />

    <Button Content="{Binding LeaveLabel}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            IsVisible="{Binding CanLeave}"
            Command="{Binding Leave}"
            controls:Pending.IsActive="{Binding Leave.IsRunning}" />

    <!-- Why this machine is outside the group, in the words of whichever side stated it. -->
    <SelectableTextBlock Classes="hint danger" Text="{Binding Refusal}" TextWrapping="Wrap"
                         IsVisible="{Binding HasRefusal}" Margin="2,0" />

  </StackPanel>

</UserControl>
