<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ti="using:TablerIcons"
             xmlns:model="using:ScreenShare.App.Features.Viewer.Tile.Model"
             xmlns:tile="using:ScreenShare.App.Features.Viewer.Tile.ViewModel"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             x:Class="ScreenShare.App.Features.Viewer.Tile.View.TileCard"
             x:DataType="tile:TileViewModel"
             Classes.filling="{Binding IsFullscreen}">

  <!--
    One tile for every host that draws one: a grid cell, the stage of the focus arrangement, a window
    of its own, a filled screen.
    Defined once rather than per host, so the menu, the meter and the badge cannot drift apart between
    them.

    Chrome waits for the pointer.
    Names left standing over the pictures turn a grid into a diagnostic screen instead of something to
    watch.

    Nothing is measured over the picture.
    A decode is diagnosed in one place, the stats overlay, no pinned copy of the chrome: it reads its
    own state and stays up wherever the pointer goes.
  -->

  <UserControl.Styles>
    <!-- Hover chrome. Faded in rather than snapped, hit-testable only once up. -->
    <Style Selector="Border.chrome">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="tiles|TileCard:pointerover Border.chrome">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Tile's shape, and what stands behind a picture that has not arrived. -->
    <Style Selector="tiles|TileCard Border.frame">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}" />
    </Style>

    <!--
      On a filled screen the card is picture and nothing besides.
      The host letterboxes it to the stream's shape, so a rounded corner would bite into the frame
      instead of shaping a cell in a grid, and what surrounds the picture is the black a stream sits
      on.
    -->
    <Style Selector="tiles|TileCard.filling Border.frame">
      <Setter Property="Background" Value="{StaticResource TileBrush}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--
      Picture or plate.
      Decided here rather than on the elements, the answer belonging to the host: while a stream is
      popped out its grid slot draws the plate and the window it went to draws the picture, both
      reading the one tile.

      Clearing the source makes the plate cost nothing.
      A source that is gone ends the subscription and gives the pool back
      (Features/Viewer/Tile/View/StreamTile.cs).
    -->
    <Style Selector="tiles|TileCard tiles|StreamTile" x:DataType="tile:TileViewModel">
      <Setter Property="Source" Value="{Binding}" />
    </Style>
    <Style Selector="tiles|TileCard[PictureElsewhere=True] tiles|StreamTile">
      <Setter Property="Source" Value="{x:Null}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="tiles|TileCard Border.plate">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="tiles|TileCard[PictureElsewhere=True] Border.plate">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <!--
    Right-click carries everything a tile affords, in one menu rather than a row of hover buttons,
    and defined here rather than per host, since what a tile affords does not change with the window
    it is in.

    Grouped by subject, in the order a reader reaches for them: where the stream is drawn, how loud
    it is, what happens to its range, what is printed over it.
    The dividers are the grouping; an unbroken run of equal rows makes the reader sort them on every
    open.

    Each row prints its key at the quiet end, the volume row the pair that moves it, and the
    tone-map row none.
    A menu is where a reader learns what a tile affords, so it is also where they learn what to press
    instead.
    A key acts on the tile under the pointer, the tile they were pointing at to open this menu
    (Features/Viewer/Tile/View/TileKeys.cs).

    A row names a state, never a transition, and shows whether that state holds as a tick at its end.
    Words and glyph hold still, so the menu reads as which of these are on rather than as a list of
    verbs (docs/design-language.md, "Menus").
    That also makes a row idempotent: "Focus" is somewhere the tile can be, and pressing it twice is a
    round trip.

    No row states a ToggleType, a decision rather than an omission.
    A toggling MenuItem writes its own IsChecked on click, putting a second author on the fact and
    letting the tick move before the thing it describes has: Mute is a call the backend can refuse, so
    the row would claim what the click asked for and then withdraw it.
    Bound one way, the tick is a read of the state and nothing besides.
    It costs the rows their checkable role for a screen reader.

    MenuItem and MenuFlyoutPresenter are themed by type, so nothing here asks for a look
    (Design/Menus.axaml).
  -->
  <UserControl.ContextFlyout>
    <MenuFlyout>
      <MenuItem Header="Focus" Command="{Binding ToggleFocus}"
                InputGesture="{x:Static tiles:TileKeys.Focus}"
                IsChecked="{Binding IsFocused, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconLayoutDistributeHorizontal" />
        </MenuItem.Icon>
      </MenuItem>

      <MenuItem Header="Own window" Command="{Binding TogglePopOut}"
                InputGesture="{x:Static tiles:TileKeys.PopOut}"
                IsChecked="{Binding IsPoppedOut, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconExternalLink" />
        </MenuItem.Icon>
      </MenuItem>

      <MenuItem Header="Fullscreen" Command="{Binding ToggleFullscreen}"
                InputGesture="{x:Static tiles:TileKeys.Fullscreen}"
                IsChecked="{Binding IsFullscreen, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconMaximize" />
        </MenuItem.Icon>
      </MenuItem>

      <Separator />

      <!--
        Mute and the volume are one state and stand together.
        A stream without an audio track greys both, a different fact from silence: there is nothing
        there to be loud.
      -->
      <MenuItem Header="Mute" Command="{Binding ToggleMute}" IsEnabled="{Binding HasAudio}"
                InputGesture="{x:Static tiles:TileKeys.Mute}"
                IsChecked="{Binding Muted, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconVolumeOff" />
        </MenuItem.Icon>
      </MenuItem>

      <!--
        A slider inside a menu is what StaysOpenOnClick is for: without it the first press dismisses
        the flyout and the drag never starts.
        The code-behind marks the pointer events handled for the same reason, a drag reaching the
        menu reading as a click on the row.

        This row holds a control instead of a state, so it holds no tick either: the slider's
        position is the reading.

        Its keys print inside the row rather than in the key column, which holds one gesture while
        this row is moved by two. They wear that column's weight and sit at the same quiet end, so
        scanning down the menu still finds every key in one place
        (Features/Viewer/Tile/View/TileKeys.cs).
      -->
      <MenuItem StaysOpenOnClick="True" IsEnabled="{Binding HasAudio}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconVolume" />
        </MenuItem.Icon>
        <MenuItem.Header>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapControl}" MinWidth="190">
            <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    Name="VolumeSlider"
                    Minimum="0" Maximum="1"
                    TickFrequency="{Binding VolumeStep}"
                    IsSnapToTickEnabled="True"
                    SmallChange="{Binding VolumeStep}"
                    LargeChange="{Binding VolumeStep}"
                    Value="{Binding Volume, Mode=TwoWay}"
                    PointerPressed="OnVolumePressed"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="hint" Text="+ / -"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </MenuItem.Header>
      </MenuItem>

      <Separator />

      <!--
        Tone mapping, the single thing a viewer decides about an HDR stream.
        It rebuilds the decode instead of writing a value into a running one, so the tick returns
        through the decode's own state as the mute does, and a machine with nothing to convert with
        greys the row and names what is missing.
      -->
      <MenuItem Command="{Binding ToggleToneMap}"
                IsEnabled="{Binding CanToneMap}"
                IsChecked="{Binding ToneMapped, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconSunLow" />
        </MenuItem.Icon>
        <MenuItem.Header>
          <StackPanel MaxWidth="260">
            <TextBlock Text="Roll HDR down to this display" />
            <TextBlock Classes="hint" Text="{Binding ToneMapNote}" TextWrapping="Wrap"
                       IsVisible="{Binding ToneMapNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </MenuItem.Header>
      </MenuItem>

      <Separator />

      <MenuItem Header="Stats overlay" Command="{Binding ToggleStats}"
                InputGesture="{x:Static tiles:TileKeys.Stats}"
                IsChecked="{Binding ShowStats, Mode=OneWay}">
        <MenuItem.Icon>
          <ti:TablerIcon Icon="IconChartBar" />
        </MenuItem.Icon>
      </MenuItem>
    </MenuFlyout>
  </UserControl.ContextFlyout>

  <!-- Fill and corner come from the styles, so the filled-screen case can restate them. -->
  <Border Classes="frame" ClipToBounds="True">
    <Panel>

      <!--
        The picture, and where it comes from.
        The styles above set both, a card drawing the plate carrying no source at all rather than a
        hidden one.
      -->
      <tiles:StreamTile />

      <!-- Why the tile is dark: nothing decoding, connecting, or a handle this renderer cannot open. -->
      <SelectableTextBlock Classes="hint" Text="{Binding Notice}"
                           IsVisible="{Binding HasNotice}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="{StaticResource InsetSection}" />

      <!-- The plate. The slot holds its place at this stream's shape, so nothing reflows. -->
      <Border Classes="plate" Background="{StaticResource SurfaceBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{StaticResource GapTight}">
          <ti:TablerIcon Icon="IconExternalLink" Brush="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" />
          <TextBlock Classes="hint" Text="In a window of its own" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Classes="chrome" VerticalAlignment="Top" HorizontalAlignment="Left"
              Margin="{StaticResource InsetTight}">
        <TextBlock Classes="ident" Text="{Binding Title}" />
      </Border>

      <!--
        The badge: what is being done here about a range wider than this display's.

        Drawn unasked instead of as hover chrome, which is the whole of what makes the choice
        discoverable: an HDR stream drawn as it arrives is not visibly wrong, it is a picture at the
        wrong brightness, and a reader with nothing to read blames the stream.

        Low rather than high, the top right being where the stats overlay opens.
      -->
      <Border Classes="chrome" VerticalAlignment="Bottom" HorizontalAlignment="Right"
              Margin="7,7,7,12"
              IsVisible="{Binding HasColourNote}">
        <TextBlock Classes="hint" Text="{Binding ColourNote}" />
      </Border>

      <!--
        The stats overlay: the panel turned on for the one stream being diagnosed.

        Reading its own state rather than the hover chrome, the whole difference between the two.
        Something that vanished when the pointer left would be useless for what this is for.

        It scrolls, and is sized against the tile rather than against its own contents. A decode
        answers with more than fits on any tile - the encoded stream, the decoded picture, the
        chain, the sink's counters, the transport's own - so a panel grown to hold them would cover
        the picture it describes on a small tile and still be cut off on a large one.
        The width is fixed for the reason a column of settings is: one that resized as figures landed would shift
        the row under the reader's eye once a second.

        Each row carries a tip saying what a reading of it is evidence of, which is what separates a
        diagnostic from a wall of numbers (docs/tooltips.md). The words live in Copy/Counters.cs,
        keyed on the identifiers the backend sends.

        The inset belongs to the wrapper and not to the panel, which is what makes the ceiling
        right: the panel's height is bound to what it stands in, so its own margin would push it
        past the bottom of the tile by that much and lose the last row behind the frame's clip.
      -->
      <Panel IsVisible="{Binding ShowStats}" Margin="{StaticResource InsetTight}">
        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                MaxHeight="{Binding $parent[Panel].Bounds.Height}"
                Width="286"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="{StaticResource InsetControl}">
            <StackPanel Spacing="{StaticResource GapControl}">

              <TextBlock Classes="ident" Text="{Binding Title}" TextWrapping="Wrap" />

              <!--
                A block per stage of the pipeline, ordered as the frames pass through it.
                A stage a decode answers nothing for is missing rather than empty: a stream without
                sound has no audio block, and a leg whose elements count nothing has no counter
                block (Features/Viewer/Tile/Model/TileStats.cs).
              -->
              <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="model:StatSection">
                    <StackPanel Margin="0,0,0,9">
                      <TextBlock Classes="caption"
                                 Text="{Binding Heading}"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding Tip}"
                                 Margin="0,0,0,3" />

                      <!--
                        Label left, figure right.
                        The label takes what its text needs and the figure wraps into the rest, the
                        only way round these two can be sized: the labels are a fixed vocabulary and
                        the readings are not, so a reading the length of "Graphics card, Direct3D 11
                        - driver's colour" taking its width first would leave its label a column one
                        letter wide.

                        The tip belongs to the label and not to the row, opening over whatever it
                        stands on while the readings are the half a reader watches change.
                      -->
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="model:StatLine">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="{StaticResource GapControl}">
                              <TextBlock Grid.Column="0" Classes="hint" Text="{Binding Label}"
                                         ToolTip.Tip="{Binding Tip}" />
                              <TextBlock Grid.Column="1" Classes="figure" Text="{Binding Value}"
                                         TextWrapping="Wrap" TextAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Panel>

      <!--
        The meter, along the bottom edge.
        Present whenever the decode carries audio and flat while that audio is silent; gone entirely
        without an audio track, which is the other fact.

        Not chrome, and it does not hide on hover: the one figure worth seeing unasked.
        Measured ahead of the volume element, so a muted stream still shows itself making noise.
      -->
      <Border VerticalAlignment="Bottom" Height="3" IsVisible="{Binding HasAudio}"
              Background="{StaticResource DividerBrush}">
        <Border Name="Level" Height="3" HorizontalAlignment="Left"
                Background="{StaticResource ForegroundBrush}"
                IsVisible="{Binding HasLevel}" />
      </Border>

    </Panel>
  </Border>

</UserControl>
