<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Fields.View.FieldGroupView"
             x:DataType="vm:FieldGroupViewModel">

  <!--
    One group of the resolved form, drawn generically. Which controls appear, what they are
    called, which are greyed and why all arrive in the message, and this file decides how a
    control kind looks and where it sits (docs/ipc-api.md).
  -->

  <!--
    Nothing is skinned here. The option row is the design's OptionCard and the picked
    treatment travels with it (Design/Buttons.axaml). The text roles inside the card are in
    Design/Text.axaml, because reaching into a button's content needs a descendant selector
    and a ControlTheme may not carry one.
  -->

  <Border Classes="card" Padding="16,14" IsVisible="{Binding IsResolved}">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="heading" VerticalAlignment="Center" Text="{Binding Title}" />
        <Button Grid.Column="1"
                Theme="{StaticResource OutlineButton}"
                VerticalAlignment="Center"
                IsVisible="{Binding HasAction}"
                Content="{Binding Action.Label}"
                Command="{Binding Action.Command}"
                ToolTip.Tip="{Binding Action.Tip}" />
      </Grid>

      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Margin="0,3,0,16"
                 IsVisible="{Binding HasHelp}"
                 Text="{Binding Help}" />

      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FieldViewModel">
            <StackPanel Spacing="6" Margin="0,0,0,18">

              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="hint"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding AppliesLive}"
                           Text="{Binding LiveNotice}" />
                <TextBlock Grid.Column="2" Classes="figure" IsVisible="{Binding HasUnit}" Text="{Binding Unit}" />
              </Grid>

              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         IsVisible="{Binding HasHelp}"
                         Text="{Binding Help}" />

              <!--
                Written on losing focus and not per keystroke. A half-typed value resolves to
                a form about settings nobody asked for, and in an applied group it is stored
                and acted on a character at a time: the backend would dial every prefix of the
                relay's hostname in turn.
              -->
              <TextBox IsVisible="{Binding IsText}"
                       IsEnabled="{Binding IsEnabled}"
                       Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

              <!--
                The effect a screen offers for this setting, absent on every number no screen
                offered one for (Features/Fields/Model/FieldAction.cs). It is a button and not
                a figure that fills itself in because it uploads a real payload, takes seconds,
                and is refused outright while a stream publishes.

                Why the press is refused stands under the row rather than in the button's tip,
                which a disabled control in Avalonia never opens.
              -->
              <StackPanel IsVisible="{Binding IsNumber}" Spacing="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <NumericUpDown IsEnabled="{Binding IsEnabled}"
                                 Value="{Binding Number, Mode=TwoWay}"
                                 Minimum="{Binding NumberMinimum}"
                                 Maximum="{Binding NumberMaximum}"
                                 Increment="{Binding NumberStep}"
                                 FormatString="0"
                                 MinWidth="160" />

                  <Button Margin="8,0,0,0"
                          IsVisible="{Binding HasAction}"
                          Content="{Binding Action.Label}"
                          Command="{Binding Action.Command}"
                          controls:Pending.IsActive="{Binding Action.Command.IsRunning}"
                          ToolTip.Tip="{Binding Action.Tip}" />
                </StackPanel>

                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           IsVisible="{Binding HasActionNotice}"
                           Text="{Binding ActionNotice}" />
              </StackPanel>

              <!--
                Box and ladder write one setting, which is what the glued edge says
                (Controls/NumberSelect). The caret carries no value of its own: what is held
                is in the box to its left, and a face repeating it would print one figure
                twice.
              -->
              <StackPanel Orientation="Horizontal"
                          IsVisible="{Binding IsNumberSelect}"
                          HorizontalAlignment="Left">
                <NumericUpDown Theme="{StaticResource NumberSelectInput}"
                               IsEnabled="{Binding IsEnabled}"
                               Value="{Binding Number, Mode=TwoWay}"
                               Minimum="{Binding NumberMinimum}"
                               Maximum="{Binding NumberMaximum}"
                               Increment="{Binding NumberStep}"
                               FormatString="0"
                               MinWidth="160" />
                <Button Theme="{StaticResource NumberSelectCaret}"
                        IsEnabled="{Binding IsEnabled}">
                  <ti:TablerIcon Icon="IconChevronDown" Brush="{StaticResource MutedBrush}" />
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Options}"
                                ItemTemplate="{StaticResource SelectEntry}"
                                ItemContainerTheme="{StaticResource SelectMenuItem}"
                                Placement="BottomEdgeAlignedRight" />
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSlider}">
                <Slider Grid.Column="0"
                        IsEnabled="{Binding IsEnabled}"
                        Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        TickFrequency="{Binding Step}"
                        Value="{Binding Slide, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           Classes="figure"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Readback}" />
              </Grid>

              <!--
                A flag is the switch and never a CheckBox. One domain concept rendered two
                ways is the defect the shared control exists to prevent
                (docs/design-language.md, "Selection").
              -->
              <ToggleButton IsVisible="{Binding IsToggle}"
                            Theme="{StaticResource SwitchTheme}"
                            IsEnabled="{Binding IsEnabled}"
                            IsChecked="{Binding Flag, Mode=TwoWay}" />

              <TextBlock Classes="figure"
                         IsVisible="{Binding IsReadonly}"
                         Text="{Binding Readback}" />

              <!--
                One list for both option kinds: the two differ in whether an entry carries a
                paragraph, and an entry with none renders without one.

                The wrapper is what carries the refusal. A disabled control in Avalonia takes
                no pointer events, so a tooltip on the card itself would open only on the
                entries that need none; the enabled border behind it is what the pointer
                lands on.
              -->
              <ItemsControl IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" IsEnabled="{Binding IsEnabled}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionViewModel">
                    <Border Background="Transparent" Margin="0,0,0,4" ToolTip.Tip="{Binding Refusal}">
                      <Button Theme="{StaticResource OptionCard}"
                              Classes.picked="{Binding IsSelected}"
                              IsEnabled="{Binding IsEnabled}"
                              Command="{Binding Choose}">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="optiontitle" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Classes="figure" IsVisible="{Binding HasNote}" Text="{Binding Note}" />
                          </Grid>
                          <TextBlock Classes="cardbody"
                                     IsVisible="{Binding HasReason}"
                                     Text="{Binding Reason}" />
                          <TextBlock Classes="cardbody"
                                     IsVisible="{Binding HasDetail}"
                                     Text="{Binding Detail}" />
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         IsVisible="{Binding HasReason}"
                         Text="{Binding Reason}" />

              <!--
                A note, not a third treatment of inapplicability: the field is live and the
                value does reach the encoder (docs/field-availability.md, "The treatments").
              -->
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         IsVisible="{Binding HasNote}"
                         Text="{Binding Note}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>

</UserControl>
