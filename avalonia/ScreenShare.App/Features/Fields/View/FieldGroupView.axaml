<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Fields.ViewModel"
             x:Class="ScreenShare.App.Features.Fields.View.FieldGroupView"
             x:DataType="vm:FieldGroupViewModel">

  <!--
    One group of the resolved form, drawn generically.
    Which controls appear, what they are called, which are greyed and why all arrive in the message,
    and this file decides where a control sits (docs/ipc-api.md).
    What one control looks like is the shared row (FieldRow.axaml).
  -->

  <Border Classes="card" Padding="16,14" IsVisible="{Binding IsResolved}">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="heading" VerticalAlignment="Center" Text="{Binding Title}" />
        <Button Grid.Column="1"
                Theme="{StaticResource OutlineButton}"
                VerticalAlignment="Center"
                IsVisible="{Binding HasAction}"
                Content="{Binding Action.Label}"
                Command="{Binding Action.Command}"
                ToolTip.Tip="{Binding Action.Tip}" />
      </Grid>

      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Margin="0,3,0,16"
                 IsVisible="{Binding HasHelp}"
                 Text="{Binding Help}" />

      <ItemsControl ItemsSource="{Binding Floor}" ItemTemplate="{StaticResource FieldRow}" />

      <!-- The step's fold: what the floor leaves out, behind a closed disclosure (Setup/Model/FloorLayout.cs). -->
      <Button Theme="{StaticResource LinkButton}"
              HorizontalAlignment="Left"
              IsVisible="{Binding Fold.HasAny}"
              Command="{Binding Fold.ToggleCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ti:TablerIcon Icon="{Binding Fold.Glyph}" Brush="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{x:Static copy:Fields.AdvancedTitle}" VerticalAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding Fold.Count}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <ItemsControl ItemsSource="{Binding Folded}"
                    ItemTemplate="{StaticResource FieldRow}"
                    IsVisible="{Binding Fold.Shown}"
                    Margin="0,12,0,0" />
    </StackPanel>
  </Border>

</UserControl>
