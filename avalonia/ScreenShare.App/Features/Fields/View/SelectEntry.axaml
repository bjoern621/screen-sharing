<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
                    xmlns:ti="using:TablerIcons">

  <!--
    One row of an opened dropdown, written against the form's option type.

    Sits here rather than in Controls/Select, not being part of the control: the select's themes name no item
    type, so a dropdown is a dropdown whatever it lists, and a generic control naming this type would point the
    design system at a screen.

    One template rather than one per caller, every list of options being the same row and copies of it drifting.

    Merged into the application's resources (App.axaml) rather than included per caller: a template resolves
    against the scope above the control it is instantiated on, and every caller reaches it from inside a
    DataTemplate, so the application's is the only scope above them all.
  -->

  <DataTemplate x:Key="SelectEntry" x:DataType="fields:OptionViewModel">
    <StackPanel MinWidth="260" MaxWidth="380" Spacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!--
          The mark rides beside the name rather than in the note column, which carries what an entry
          was derived from and is filled on the same rows.
        -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="ident"
                     Text="{Binding Label}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="mark"
                     Text="Recommended"
                     IsVisible="{Binding IsRecommended}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <ti:TablerIcon Grid.Column="1"
                       Icon="IconCheck"
                       Brush="{StaticResource ForegroundBrush}"
                       Margin="8,0,0,0"
                       IsVisible="{Binding IsSelected}"
                       VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Classes="figure"
                   Foreground="{StaticResource HintBrush}"
                   Margin="16,0,0,0"
                   IsVisible="{Binding HasNote}"
                   Text="{Binding Note}"
                   VerticalAlignment="Center" />
      </Grid>
      <SelectableTextBlock Classes="reason"
                           IsVisible="{Binding HasReason}"
                           Text="{Binding Reason}" />
      <TextBlock Classes="cardbody"
                 IsVisible="{Binding HasDetail}"
                 Text="{Binding Detail}" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
