<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ScreenShare.App.Features.Fields.ViewModel"
                    xmlns:controls="using:ScreenShare.App.Controls"
                    xmlns:ti="using:TablerIcons">

  <!--
    One control of the resolved form.
    Which controls appear, what they are called, which are greyed and why all arrive in the message,
    and this template decides how a control kind looks (docs/ipc-api.md).

    One template rather than one per caller: the whole group renders it and so does the advanced part of the
    quality group, and a second copy is the one that stops matching.

    Merged into the application's resources (App.axaml) rather than included per caller: a template resolves
    against the scope above the control it is instantiated on, and every caller reaches it from inside a
    DataTemplate, so the application's is the only scope above them all.

    Nothing is skinned here.
    The option row is the design's OptionCard and the picked treatment travels with it (Design/Buttons.axaml).
    The text roles inside the card sit in Design/Text.axaml, reaching into a button's content needing a
    descendant selector a ControlTheme may not carry.
  -->

  <DataTemplate x:Key="FieldRow" x:DataType="vm:FieldViewModel">
    <StackPanel Spacing="6" Margin="0,0,0,18">

      <!--
        Unit beside the name and not over the control: it names what the figure is counted in, a fact about the
        setting, and an Auto column is as wide as the word rather than as wide as a column suiting every row.
      -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Classes="secondary"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   VerticalAlignment="Center"
                   Text="{Binding Label}" />
        <TextBlock Grid.Column="1"
                   Classes="hint"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   IsVisible="{Binding AppliesLive}"
                   Text="{Binding LiveNotice}" />
        <TextBlock Grid.Column="2"
                   Classes="figure"
                   Foreground="{StaticResource HintBrush}"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasUnit}"
                   Text="{Binding Unit}" />
      </Grid>

      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 IsVisible="{Binding HasHelp}"
                 Text="{Binding Help}" />

      <!--
        Written on losing focus and not per keystroke.
        A half-typed value resolves to a form about settings nobody asked for,
        and in an applied group it is stored and acted on a character at a time:
        the backend would dial every prefix of the relay's hostname in turn.
      -->
      <TextBox IsVisible="{Binding IsText}"
               IsEnabled="{Binding IsEnabled}"
               Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

      <NumericUpDown IsVisible="{Binding IsNumber}"
                     IsEnabled="{Binding IsEnabled}"
                     Value="{Binding Number, Mode=TwoWay}"
                     Minimum="{Binding NumberMinimum}"
                     Maximum="{Binding NumberMaximum}"
                     Increment="{Binding NumberStep}"
                     FormatString="0"
                     MinWidth="180"
                     HorizontalAlignment="Left" />

      <!--
        Box and ladder write one setting, which is what the glued edge says (Controls/NumberSelect).
        The caret carries no value of its own: what is held is in the box to its left,
        and a face repeating it would print one figure twice.
      -->
      <StackPanel Orientation="Horizontal"
                  IsVisible="{Binding IsNumberSelect}"
                  HorizontalAlignment="Left">
        <!--
          The entry standing where the box would be, for a value the range does not reach:
          a spinner handed one coerces it to its own floor and writes the floor back,
          which is the answer the entry exists to reach (form.proto, CONTROL_KIND_NUMBER_SELECT).
          The caret beside it is unchanged, so the way out is the way in.
        -->
        <Border Theme="{StaticResource NumberSelectHeld}"
                IsVisible="{Binding IsEntryOutsideBand}"
                MinWidth="180">
          <SelectableTextBlock VerticalAlignment="Center"
                               FontFeatures="{StaticResource FigureFeatures}"
                               Text="{Binding PickedLabel}" />
        </Border>

        <NumericUpDown Theme="{StaticResource NumberSelectInput}"
                       IsVisible="{Binding IsNumberBox}"
                       IsEnabled="{Binding IsEnabled}"
                       Value="{Binding Number, Mode=TwoWay}"
                       Minimum="{Binding NumberMinimum}"
                       Maximum="{Binding NumberMaximum}"
                       Increment="{Binding NumberStep}"
                       FormatString="0"
                       MinWidth="180" />
        <Button Theme="{StaticResource NumberSelectCaret}"
                IsEnabled="{Binding IsEnabled}">
          <ti:TablerIcon Icon="IconChevronDown" Brush="{StaticResource MutedBrush}" />
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding MenuRows}"
                        ItemTemplate="{StaticResource SelectEntry}"
                        ItemContainerTheme="{StaticResource SelectMenuItem}"
                        Placement="BottomEdgeAlignedRight" />
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!--
        The thumb stops where the form does and nowhere between: the setting under it is a whole figure,
        so a sweep landing between two stops would write a value rounded behind the reader's back.
        The keys carry the same distance, a shorter move snapping back to the stop it left.

        Ticks over TickFrequency, a frequency counting its grid off the floor and stepping over it
        (Features/Fields/ViewModel/FieldViewModel.cs).
        The frequency stays as what a range holding no stop of its own is swept in.
      -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSlider}">
        <controls:SweepSlider Grid.Column="0"
                IsEnabled="{Binding IsEnabled}"
                Minimum="{Binding Minimum}"
                Maximum="{Binding Maximum}"
                Ticks="{Binding Ticks}"
                TickFrequency="{Binding Step}"
                IsSnapToTickEnabled="True"
                SmallChange="{Binding Step}"
                LargeChange="{Binding PageStep}"
                Sweeping="{Binding IsSweeping}"
                Value="{Binding Slide, Mode=TwoWay}" />
        <TextBlock Grid.Column="1"
                   Classes="figure"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding Readback}" />
      </Grid>

      <!--
        A flag is the switch and never a CheckBox.
        One domain concept rendered two ways is the defect the shared control exists to prevent
        (docs/design-language.md, "Selection").
      -->
      <ToggleButton IsVisible="{Binding IsToggle}"
                    Theme="{StaticResource SwitchTheme}"
                    IsEnabled="{Binding IsEnabled}"
                    IsChecked="{Binding Flag, Mode=TwoWay}" />

      <TextBlock Classes="figure"
                 IsVisible="{Binding IsReadonly}"
                 Text="{Binding Readback}" />

      <!--
        One list for both option kinds: the two differ in whether an entry carries a paragraph,
        and an entry with none renders without one.

        A refused entry states its reason on the card, so nothing opens over it
        (docs/tooltips.md, "An availability note is a line").
      -->
      <StackPanel IsVisible="{Binding IsChoice}">
        <ItemsControl ItemsSource="{Binding Shown}" IsEnabled="{Binding IsEnabled}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OptionViewModel">
              <Button Theme="{StaticResource OptionCard}"
                      Classes.picked="{Binding IsSelected}"
                      Margin="0,0,0,4"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding Choose}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Beside the title, for the reason a dropdown row carries it there (SelectEntry.axaml). -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="optiontitle" Text="{Binding Label}" />
                      <TextBlock Classes="mark"
                                 Text="Recommended"
                                 IsVisible="{Binding IsRecommended}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="figure" IsVisible="{Binding HasNote}" Text="{Binding Note}" />
                  </Grid>
                  <SelectableTextBlock Classes="reason"
                                       IsVisible="{Binding HasReason}"
                                       Text="{Binding Reason}" />
                  <TextBlock Classes="cardbody"
                             IsVisible="{Binding HasDetail}"
                             Text="{Binding Detail}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          Outside the list's greying: an inert control is still one a reader arrives at looking for what is
          missing, and reading is not picking.
        -->
        <Button Theme="{StaticResource LinkButton}"
                HorizontalAlignment="Left"
                Margin="0,2,0,0"
                IsVisible="{Binding HasRefused}"
                Command="{Binding RevealCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ti:TablerIcon Icon="{Binding RefusedGlyph}"
                           Brush="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            <TextBlock Classes="secondary" Text="{Binding RefusedTitle}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding RefusedCount}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!--
        The effect a screen offers for this setting, drawn under whichever control kind holds it rather than
        inside one kind's branch (Features/Fields/Model/FieldAction.cs).
        A button and not a figure filling itself in: it reaches another machine, takes seconds,
        and is refused outright in the states the backend names.
      -->
      <StackPanel IsVisible="{Binding HasAction}" Spacing="6">
        <Button HorizontalAlignment="Left"
                Content="{Binding Action.Label}"
                Command="{Binding Action.Command}"
                controls:Pending.IsActive="{Binding Action.Command.IsRunning}"
                ToolTip.Tip="{Binding Action.Tip}" />

        <SelectableTextBlock Classes="hint"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             IsVisible="{Binding HasActionNotice}"
                             Text="{Binding ActionNotice}" />
      </StackPanel>

      <SelectableTextBlock Classes="reason"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           IsVisible="{Binding HasReason}"
                           Text="{Binding Reason}" />

      <!--
        A note, not a third treatment of inapplicability: the field is live and the value does reach the encoder
        (docs/field-availability.md, "The treatments").
      -->
      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 IsVisible="{Binding HasNote}"
                 Text="{Binding Note}" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
