<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="using:ScreenShare.App.Features.Setup.ViewModel"
             xmlns:strip="using:ScreenShare.App.Features.Setup.StepStrip.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.StepStrip.View.StepStripView"
             x:DataType="setup:SetupViewModel">

  <!--
    The strip is navigation, progress and configuration summary at once: each chip carries
    the value its step settled on, so nobody has to walk the seven in order to find out what
    is set. Every chip is clickable in every state, which is what makes it non-linear.

    The chip lives here rather than in Controls/ because nothing outside this flow has a
    step to draw.
  -->

  <UserControl.Resources>
    <!--
      A step is the design's card button with the strip's own four states on it. It takes
      the shape and the skin from Design/Buttons.axaml and states only what a step adds:
      the shell's card fill, and the walked, current and terminal treatments. The template
      is not restated - a chip that carried its own copy would stop tracking the button
      every other surface draws the moment either moved.
    -->
    <ControlTheme x:Key="StepChipTheme" TargetType="Button" BasedOn="{StaticResource CardButton}">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <!-- Walked. Raised, so the covered ground reads as solid. -->
      <Style Selector="^.done /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
      </Style>

      <!-- Here. The one light surface on the screen, so the eye finds it without a legend. -->
      <Style Selector="^.current /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
      </Style>

      <!--
        Terminal. Drawn a shade brighter at the edge than an upcoming step so it reads as
        the end of the strip rather than as one more form.
      -->
      <Style Selector="^.terminal /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
      </Style>
      <Style Selector="^.current:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The chip's interior. Base is the upcoming state; each other state overrides it. -->
    <Style Selector="Border.chipbadge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSegment}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
    </Style>
    <Style Selector="Button.done Border.chipbadge">
      <Setter Property="Background" Value="{StaticResource ChipBorderBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.current Border.chipbadge">
      <Setter Property="Background" Value="{StaticResource OnSelectedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock.chipglyph">
      <Setter Property="FontSize" Value="{StaticResource FontSizeMinor}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.done TextBlock.chipglyph">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style Selector="Button.current TextBlock.chipglyph">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <!--
      The tick has no state of its own to answer for: it is drawn on the walked chip and
      nowhere else, so one brush covers it.
    -->
    <Style Selector="ti|TablerIcon.chipglyph">
      <Setter Property="Brush" Value="{StaticResource ForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.chiplabel">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="Button.done TextBlock.chiplabel">
      <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
    </Style>
    <Style Selector="Button.current TextBlock.chiplabel">
      <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}" />
    </Style>

    <!--
      The value line is a machine value: one step down from the label, in the faintest role,
      and in tabular figures so a strip of seven chips lines its numbers up down the row.
    -->
    <Style Selector="TextBlock.chipvalue">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
      <Setter Property="FontFeatures" Value="{StaticResource FigureFeatures}" />
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
    </Style>
    <Style Selector="Button.done TextBlock.chipvalue">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.current TextBlock.chipvalue">
      <Setter Property="Foreground" Value="{StaticResource ChipBorderBrush}" />
    </Style>

    <!-- Lit up to and including the connector leaving the current step. -->
    <Style Selector="Border.connector">
      <Setter Property="Width" Value="{StaticResource GapSection}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    </Style>
    <Style Selector="Border.connector.lit">
      <Setter Property="Background" Value="{StaticResource ControlBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <ItemsControl ItemsSource="{Binding Steps}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="strip:StepChipViewModel">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0"
                  Classes="connector"
                  Classes.lit="{Binding IsConnectorLit}"
                  IsVisible="{Binding HasConnector}" />

          <Button Grid.Column="1"
                  Theme="{StaticResource StepChipTheme}"
                  Command="{Binding Select}"
                  Classes.done="{Binding IsDone}"
                  Classes.current="{Binding IsCurrent}"
                  Classes.terminal="{Binding IsTerminal}">
            <!-- The value sits under the label, not under the badge, so the two lines read as one column. -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <!--
                The number, or the tick that replaces it once the step is walked. Two
                controls rather than one string: the tick is a Tabler icon, and the number
                is text.
              -->
              <Border Grid.Row="0" Grid.Column="0" Classes="chipbadge">
                <Panel>
                  <TextBlock Classes="chipglyph"
                             Text="{Binding Badge}"
                             IsVisible="{Binding !IsDone}" />
                  <ti:TablerIcon Classes="badge chipglyph"
                                 Icon="IconCheck"
                                 IsVisible="{Binding IsDone}"
                                 HorizontalAlignment="Center" />
                </Panel>
              </Border>
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Classes="chiplabel"
                         Margin="7,0,0,0"
                         VerticalAlignment="Center"
                         Text="{Binding Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Classes="chipvalue"
                         Margin="7,3,0,0"
                         Text="{Binding Value}" />
            </Grid>
          </Button>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
