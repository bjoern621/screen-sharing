<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:vm="using:ScreenShare.App.Features.Setup.AdvancedDrawer.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.AdvancedDrawer.View.AdvancedDrawerView"
             x:DataType="vm:AdvancedDrawerViewModel">

  <!--
    Rest of the quality group, drawered.
    Every row is a control of the resolved form and is edited here rather than printed: the
    value, the bounds the spinner enforces, the greying and the sentence beside it all arrive
    in the message (docs/ipc-api.md).

    The last column answers why anybody would touch the row, the question an expert arrives
    with. The field's own help, keyed by the field, not a gloss written per row.

    A setting's name takes the label role and its value the identifier one, the name being the
    one thing in a row a person reads as words (docs/design-language.md).
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.settingname">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="{StaticResource FontSizeMinor}" />
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
      <Setter Property="Margin" Value="14,7" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasRows}">
    <StackPanel>

      <Border Background="{StaticResource ControlBrush}" Padding="14,7">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Theme="{StaticResource LinkButton}" Command="{Binding ToggleOpenCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <ti:TablerIcon Icon="{Binding CaretGlyph}"
                             Brush="{StaticResource MutedBrush}" />
              <TextBlock Classes="heading" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock Grid.Column="2"
                     Classes="muted"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"
                     Text="{Binding CountLabel}" />
        </Grid>
      </Border>

      <StackPanel IsVisible="{Binding IsOpen}">
        <!-- Fixed widths: columns that moved as values changed would be a table nobody can scan. -->
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="196,168,64,*">
            <TextBlock Grid.Column="0" Classes="colhead" Text="{Binding SettingColumn}" />
            <TextBlock Grid.Column="1" Classes="colhead" Text="{Binding ValueColumn}" />
            <TextBlock Grid.Column="2" Classes="colhead" Text="{Binding UnitColumn}" />
            <TextBlock Grid.Column="3" Classes="colhead" Text="{Binding NoteColumn}" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="fields:FieldViewModel">
              <Border BorderBrush="{StaticResource HairlineBrush}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="196,168,64,*">
                  <TextBlock Grid.Column="0"
                             Classes="settingname"
                             Margin="14,7"
                             TextWrapping="Wrap"
                             Text="{Binding Label}" />

                  <!--
                    One widget per control kind the drawer can be handed.
                    A disabled row greys rather than disappearing, and its reason is printed in
                    the last column.

                    Which kinds arrive is QualityLayout's partition rather than a list kept
                    here, so every kind the step above places nowhere has to be drawable here:
                    one neither of them draws is a setting the backend offered that nobody can
                    reach.
                  -->
                  <Panel Grid.Column="1" Margin="14,7" HorizontalAlignment="Left">
                    <TextBox IsVisible="{Binding IsText}"
                             IsEnabled="{Binding IsEnabled}"
                             MinWidth="140"
                             Text="{Binding Text, Mode=TwoWay}" />

                    <NumericUpDown IsVisible="{Binding IsNumber}"
                                   IsEnabled="{Binding IsEnabled}"
                                   Value="{Binding Number, Mode=TwoWay}"
                                   Minimum="{Binding NumberMinimum}"
                                   Maximum="{Binding NumberMaximum}"
                                   Increment="{Binding NumberStep}"
                                   FormatString="0"
                                   MinWidth="140" />

                    <!-- Box and ladder write one setting (Controls/NumberSelect). -->
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsNumberSelect}">
                      <NumericUpDown Theme="{StaticResource NumberSelectInput}"
                                     IsEnabled="{Binding IsEnabled}"
                                     Value="{Binding Number, Mode=TwoWay}"
                                     Minimum="{Binding NumberMinimum}"
                                     Maximum="{Binding NumberMaximum}"
                                     Increment="{Binding NumberStep}"
                                     FormatString="0"
                                     MinWidth="140" />
                      <Button Theme="{StaticResource NumberSelectCaret}"
                              IsEnabled="{Binding IsEnabled}">
                        <ti:TablerIcon Icon="IconChevronDown" Brush="{StaticResource MutedBrush}" />
                        <Button.Flyout>
                          <MenuFlyout ItemsSource="{Binding MenuRows}"
                                      ItemTemplate="{StaticResource SelectEntry}"
                                      ItemContainerTheme="{StaticResource SelectMenuItem}"
                                      Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                      </Button>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSlider}" Width="140">
                      <controls:SweepSlider Grid.Column="0"
                              IsEnabled="{Binding IsEnabled}"
                              Minimum="{Binding Minimum}"
                              Maximum="{Binding Maximum}"
                              Ticks="{Binding Ticks}"
                              TickFrequency="{Binding Step}"
                              IsSnapToTickEnabled="True"
                              SmallChange="{Binding Step}"
                              LargeChange="{Binding PageStep}"
                              Sweeping="{Binding IsSweeping}"
                              Value="{Binding Slide, Mode=TwoWay}" />
                      <TextBlock Grid.Column="1"
                                 Classes="ident"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding Readback}" />
                    </Grid>

                    <ToggleButton IsVisible="{Binding IsToggle}"
                                  Theme="{StaticResource SwitchTheme}"
                                  IsEnabled="{Binding IsEnabled}"
                                  IsChecked="{Binding Flag, Mode=TwoWay}" />

                    <TextBlock IsVisible="{Binding IsReadonly}"
                               Classes="ident"
                               VerticalAlignment="Center"
                               Text="{Binding Readback}" />
                  </Panel>

                  <TextBlock Grid.Column="2"
                             Classes="figure"
                             Foreground="{StaticResource HintBrush}"
                             Margin="14,7"
                             IsVisible="{Binding HasUnit}"
                             Text="{Binding Unit}" />

                  <StackPanel Grid.Column="3" Margin="14,7" Spacing="4">
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               IsVisible="{Binding HasHelp}"
                               Text="{Binding Help}" />

                    <TextBlock Classes="reason"
                               IsVisible="{Binding HasReason}"
                               Text="{Binding Reason}" />

                    <!-- A note, not a greying: the row is live and the value reaches the encoder. -->
                    <TextBlock Classes="hint"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               IsVisible="{Binding HasNote}"
                               Text="{Binding Note}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
