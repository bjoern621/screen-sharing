<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:vm="using:ScreenShare.App.Features.Setup.AdvancedDrawer.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.AdvancedDrawer.View.AdvancedDrawerView"
             x:DataType="vm:AdvancedDrawerViewModel">

  <!--
    The rest of the quality group, drawered. Every row is a control of the resolved form, so
    it is edited here rather than printed: the value, the bounds the spinner enforces, the
    greying and the sentence beside it all arrive in the message (docs/ipc-api.md).

    The fourth column is the point of the table: the note says why anybody would touch the
    row, which is the question an expert arrives with. It is the form's own help text, not a
    gloss written here.

    Two columns this table used to have are gone with the mockup that seeded them. There is
    no default column, because the form reports no defaults, and no changed marking or reset,
    because nothing says which rows depart from one.

    Setting names take the label role while the values take the identifier one. That is
    deliberate and not an oversight: the name is the one thing in the row a person reads as
    words, and it is the colour and the size that say so now rather than a second face.
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.settingname">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="{StaticResource FontSizeMinor}" />
      <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
      <Setter Property="Margin" Value="14,7" />
    </Style>
  </UserControl.Styles>

  <!-- A group that left this drawer nothing is not drawn at all. -->
  <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasRows}">
    <StackPanel>

      <!-- Header. Clicking it is the one write that opens and closes the drawer. -->
      <Border Background="{StaticResource ControlBrush}" Padding="14,7">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Theme="{StaticResource LinkButton}" Command="{Binding ToggleOpenCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <ti:TablerIcon Icon="{Binding CaretGlyph}"
                             Brush="{StaticResource MutedBrush}" />
              <TextBlock Classes="heading" Text="Advanced" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock Grid.Column="2"
                     Classes="muted"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"
                     Text="{Binding CountLabel}" />
        </Grid>
      </Border>

      <StackPanel IsVisible="{Binding IsOpen}">
        <!--
          Fixed columns, because a table whose columns move as values change is a table
          nobody can scan.
        -->
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="196,168,64,*">
            <TextBlock Grid.Column="0" Classes="colhead" Text="setting" />
            <TextBlock Grid.Column="1" Classes="colhead" Text="value" />
            <TextBlock Grid.Column="2" Classes="colhead" Text="unit" />
            <TextBlock Grid.Column="3" Classes="colhead" Text="note — why you would touch it" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="fields:FieldViewModel">
              <Border BorderBrush="{StaticResource HairlineBrush}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="196,168,64,*">
                  <TextBlock Grid.Column="0"
                             Classes="settingname"
                             Margin="14,7"
                             TextWrapping="Wrap"
                             Text="{Binding Label}" />

                  <!--
                    One widget per control kind the drawer can be handed, the same ones the
                    generic renderer draws. A row the form disabled greys rather than
                    disappearing, and the reason it carries is printed in the note column
                    beside it.

                    Which kinds arrive here is QualityLayout's partition and not a list kept
                    here, so a kind the step above places nowhere must be drawable here -
                    a kind neither of them draws is a setting the backend offered and nobody
                    can reach.
                  -->
                  <Panel Grid.Column="1" Margin="14,7" HorizontalAlignment="Left">
                    <TextBox IsVisible="{Binding IsText}"
                             IsEnabled="{Binding IsEnabled}"
                             MinWidth="140"
                             Text="{Binding Text, Mode=TwoWay}" />

                    <NumericUpDown IsVisible="{Binding IsNumber}"
                                   IsEnabled="{Binding IsEnabled}"
                                   Value="{Binding Number, Mode=TwoWay}"
                                   Minimum="{Binding NumberMinimum}"
                                   Maximum="{Binding NumberMaximum}"
                                   Increment="{Binding NumberStep}"
                                   FormatString="0"
                                   MinWidth="140" />

                    <!-- The typed box and its ladder, glued (Controls/NumberSelect). -->
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsNumberSelect}">
                      <NumericUpDown Theme="{StaticResource NumberSelectInput}"
                                     IsEnabled="{Binding IsEnabled}"
                                     Value="{Binding Number, Mode=TwoWay}"
                                     Minimum="{Binding NumberMinimum}"
                                     Maximum="{Binding NumberMaximum}"
                                     Increment="{Binding NumberStep}"
                                     FormatString="0"
                                     MinWidth="140" />
                      <Button Theme="{StaticResource NumberSelectCaret}"
                              IsEnabled="{Binding IsEnabled}">
                        <ti:TablerIcon Icon="IconChevronDown" Brush="{StaticResource MutedBrush}" />
                        <Button.Flyout>
                          <MenuFlyout ItemsSource="{Binding Options}"
                                      ItemTemplate="{StaticResource SelectEntry}"
                                      ItemContainerTheme="{StaticResource SelectMenuItem}"
                                      Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                      </Button>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSlider}" Width="140">
                      <Slider Grid.Column="0"
                              IsEnabled="{Binding IsEnabled}"
                              Minimum="{Binding Minimum}"
                              Maximum="{Binding Maximum}"
                              TickFrequency="{Binding Step}"
                              Value="{Binding Slide, Mode=TwoWay}" />
                      <TextBlock Grid.Column="1"
                                 Classes="ident"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding Readback}" />
                    </Grid>

                    <ToggleButton IsVisible="{Binding IsToggle}"
                                  Theme="{StaticResource SwitchTheme}"
                                  IsEnabled="{Binding IsEnabled}"
                                  IsChecked="{Binding Flag, Mode=TwoWay}" />

                    <TextBlock IsVisible="{Binding IsReadonly}"
                               Classes="ident"
                               VerticalAlignment="Center"
                               Text="{Binding Readback}" />
                  </Panel>

                  <TextBlock Grid.Column="2"
                             Classes="figure"
                             Foreground="{StaticResource HintBrush}"
                             Margin="14,7"
                             IsVisible="{Binding HasUnit}"
                             Text="{Binding Unit}" />

                  <StackPanel Grid.Column="3" Margin="14,7" Spacing="4">
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               IsVisible="{Binding HasHelp}"
                               Text="{Binding Help}" />

                    <!-- Why the control is inert, in its place rather than in a log line. -->
                    <TextBlock Classes="hint"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               IsVisible="{Binding HasReason}"
                               Text="{Binding Reason}" />

                    <!-- A live row that means something here its label does not describe. -->
                    <TextBlock Classes="hint"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               IsVisible="{Binding HasNote}"
                               Text="{Binding Note}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
