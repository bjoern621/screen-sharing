<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    A quantizer slider paints no track: the form behind it draws the coloured zones, so both
    halves stay blank and the zones show through (Setup/QualityStep/View/QualityStepView.axaml).
    The thumb and the blank halves are the shared ones from Design/Inputs.axaml, a grip being
    the design's answer rather than this step's.

    Merged by the one view that uses it, so nothing is registered in App.axaml.
  -->

  <ControlTheme x:Key="QuantizerSliderTheme" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Track Name="PART_Track"
                 Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderTrackBlank}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderTrackBlank}" />
            </Track.IncreaseButton>
            <Thumb Theme="{StaticResource SliderThumb}" Width="14" Height="14" />
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
