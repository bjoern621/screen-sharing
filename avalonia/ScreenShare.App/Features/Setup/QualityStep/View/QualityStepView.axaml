<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:vm="using:ScreenShare.App.Features.Setup.QualityStep.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.QualityStep.View.QualityStepView"
             x:DataType="vm:QualityStepViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Setup/QualityStep/View/QuantizerSlider.axaml" />
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Ellipse.radiodot">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stroke" Value="{StaticResource HintBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.picked Ellipse.radiodot">
      <Setter Property="Stroke" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="4" />
    </Style>

    <!--
      Closed dropdown's two columns, and their disabled treatment, stated by the caller, not in the face's theme:
      a ControlTheme carries no descendant selector, so the only rule reaching this text is in the file writing it.
    -->
    <Style Selector="TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button:disabled TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
    </Style>
    <Style Selector="Button:disabled ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource DisabledBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    Nothing before the first resolve, and nothing for a backend that does not describe this step:
    the unreachable backend already says so once above the column, and a card is not drawn empty to repeat it.
  -->
  <Border Classes="card" Padding="16,14" IsVisible="{Binding IsResolved}">
    <StackPanel>
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Margin="0,3,0,16"
                 Text="{Binding Help}" />

      <ItemsControl IsVisible="{Binding HasMode}"
                    IsEnabled="{Binding Mode.IsEnabled}"
                    ItemsSource="{Binding Mode.Shown}"
                    Margin="-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ModeColumns}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:OptionViewModel">
            <!--
              A refused card states its reason under the title, so nothing opens over it
              (docs/tooltips.md, "An availability note is a line").
            -->
            <Button Theme="{StaticResource OptionCard}"
                    Classes.picked="{Binding IsSelected}"
                    Margin="5,0,5,10"
                    IsEnabled="{Binding IsEnabled}"
                    Command="{Binding Choose}">
              <StackPanel>
                <!--
                  A grid and not a horizontal stack: a stack measures its children against infinite width,
                  so the title neither wraps nor trims and runs past the card's edge.
                  The starred column is the width it wraps into.
                -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                  <Ellipse Grid.Column="0" Classes="radiodot" />
                  <TextBlock Grid.Column="1"
                             Classes="cardtitle"
                             Text="{Binding Label}"
                             Margin="7,0,0,0"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             VerticalAlignment="Center" />
                </Grid>
                <!-- Gap rides on the refusal, so a card carrying only the description carries none. -->
                <TextBlock Classes="reason"
                           Margin="0,0,0,6"
                           IsVisible="{Binding HasReason}"
                           Text="{Binding Reason}" />
                <TextBlock Classes="cardbody"
                           IsVisible="{Binding HasDetail}"
                           Text="{Binding Detail}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Theme="{StaticResource LinkButton}"
              HorizontalAlignment="Left"
              IsVisible="{Binding Mode.HasRefused}"
              Command="{Binding Mode.RevealCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ti:TablerIcon Icon="{Binding Mode.RefusedGlyph}"
                         Brush="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{Binding Mode.RefusedTitle}" VerticalAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding Mode.RefusedCount}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <StackPanel IsVisible="{Binding HasQuantizer}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
          <TextBlock Grid.Column="0" Classes="heading" Text="{Binding Quantizer.Label}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="muted" Text="lower keeps more detail" Margin="10,0,0,0" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="3" Classes="promoted" Text="{Binding Quantizer.Readback}" VerticalAlignment="Bottom" />
        </Grid>

        <!--
          Three zones and one deliberate gap, drawn behind the slider: below the recommended band, the band,
          bare track, then the tail where the picture stops being usable.
          The theme paints no track of its own, so the zones show through under the thumb.
        -->
        <Panel Height="14" Margin="0,9,0,0" IsEnabled="{Binding Quantizer.IsEnabled}">
          <Border Height="6"
                  CornerRadius="{StaticResource RadiusSegment}"
                  ClipToBounds="True"
                  VerticalAlignment="Center"
                  Background="{StaticResource DividerBrush}">
            <!--
              Shares of the scale and not of the H.26x numbers: the track's ends are the codec's,
              and the band sits at the same fraction of every one of them
              (Setup/Model/QualityLayout.cs, which states the same two edges for the labels below).
            -->
            <Grid ColumnDefinitions="35*,12*,16*,37*">
              <Border Grid.Column="0" Background="{StaticResource ChipBorderBrush}" />
              <Border Grid.Column="1" Background="{StaticResource ForegroundBrush}" />
              <Border Grid.Column="3" Background="{StaticResource CautionBrush}" Opacity="0.25" />
            </Grid>
          </Border>

          <!--
            A quantizer is a whole number of the codec's own scale, so the thumb stops on one and never between two
            (Features/Fields/View/FieldGroupView.axaml, which snaps every other slider the same way).
          -->
          <controls:SweepSlider Theme="{StaticResource QuantizerSliderTheme}"
                  Minimum="{Binding Quantizer.Minimum}"
                  Maximum="{Binding Quantizer.Maximum}"
                  Ticks="{Binding Quantizer.Ticks}"
                  TickFrequency="{Binding Quantizer.Step}"
                  IsSnapToTickEnabled="True"
                  SmallChange="{Binding Quantizer.Step}"
                  LargeChange="{Binding Quantizer.PageStep}"
                  Sweeping="{Binding Quantizer.IsSweeping}"
                  Value="{Binding Quantizer.Slide, Mode=TwoWay}" />
        </Panel>

        <!--
          The track's own ratios, repeated rather than one column per label,
          a starred column being a share of the whole row and not of what is left over:
          a lone `*` beside the first band's 29 is a thirtieth of the width.
        -->
        <Grid ColumnDefinitions="35*,12*,16*,37*" Margin="0,6,0,0">
          <TextBlock Grid.Column="0" Classes="figure" Foreground="{StaticResource HintBrush}" Text="{Binding QuantizerFloorLabel}" />
          <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Classes="figure" Foreground="{StaticResource ForegroundBrush}" Text="{Binding QuantizerBandLabel}" />
          <TextBlock Grid.Column="3" HorizontalAlignment="Right" Classes="figure" Foreground="{StaticResource CautionBrush}" Text="{Binding QuantizerCeilingLabel}" />
        </Grid>

        <TextBlock Classes="reason"
                   Margin="0,6,0,0"
                   IsVisible="{Binding Quantizer.HasReason}"
                   Text="{Binding Quantizer.Reason}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Selects}" Margin="-5,16,-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:FieldViewModel">
            <StackPanel Margin="5,0,5,12">
              <TextBlock Classes="secondary" Text="{Binding Label}" Margin="0,0,0,6" />

              <Button Theme="{StaticResource SelectFace}"
                      IsEnabled="{Binding IsEnabled}"
                      ToolTip.Tip="{Binding Help}">
                <!--
                  The held value takes the starred column so it trims inside the face.
                  An Auto column measures against infinite width,
                  which pushes the caret out of the button on a long codec name.
                -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0"
                             Classes="ident facevalue"
                             VerticalAlignment="Center"
                             Text="{Binding PickedLabel}" />
                  <ti:TablerIcon Grid.Column="1"
                                 Classes="facecaret"
                                 Icon="IconChevronDown"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="figure"
                             Foreground="{StaticResource HintBrush}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasPickedNote}"
                             Text="{Binding PickedNote}" />
                </Grid>

                <Button.Flyout>
                  <!--
                    A refused entry's reason is a line in the shared entry row rather than a tip
                    (Features/Fields/View/SelectEntry.axaml):
                    the row is a disabled MenuItem wherever there is something to explain,
                    and a disabled control takes no pointer events.
                  -->
                  <MenuFlyout ItemsSource="{Binding MenuRows}"
                              ItemTemplate="{StaticResource SelectEntry}"
                              ItemContainerTheme="{StaticResource SelectMenuItem}"
                              Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>

              <TextBlock Classes="reason"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasReason}"
                         Text="{Binding Reason}" />
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasNote}"
                         Text="{Binding Note}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>

</UserControl>
