<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:vm="using:ScreenShare.App.Features.Setup.QualityStep.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.QualityStep.View.QualityStepView"
             x:DataType="vm:QualityStepViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Setup/QualityStep/View/QuantizerSlider.axaml" />
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Ellipse.radiodot">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stroke" Value="{StaticResource HintBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.picked Ellipse.radiodot">
      <Setter Property="Stroke" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="4" />
    </Style>

    <!--
      The closed dropdown's two columns, and their disabled treatment, stated by the caller
      rather than in the face's theme: a ControlTheme carries no descendant selector, so the
      only rule that reaches this text is in the file that writes it.
    -->
    <Style Selector="TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button:disabled TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
    </Style>
    <Style Selector="Button:disabled ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource DisabledBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    Nothing before the first resolve, and nothing for a backend that does not describe this
    step: the unreachable backend already says so once above the column, and a card is not
    drawn empty to repeat it.
  -->
  <Border Classes="card" Padding="16,14" IsVisible="{Binding IsResolved}">
    <StackPanel>
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Margin="0,3,0,16"
                 Text="{Binding Help}" />

      <ItemsControl IsVisible="{Binding HasMode}"
                    IsEnabled="{Binding Mode.IsEnabled}"
                    ItemsSource="{Binding Mode.Options}"
                    Margin="-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ModeColumns}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:OptionViewModel">
            <!--
              The refusal rides on the wrapper: a disabled control takes no pointer events, so
              a tip on the card would open on every entry except the ones with something to
              say.
            -->
            <Border Background="Transparent" Margin="5,0,5,10" ToolTip.Tip="{Binding Refusal}">
              <Button Theme="{StaticResource OptionCard}"
                      Classes.picked="{Binding IsSelected}"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding Choose}">
                <StackPanel>
                  <!--
                    A grid and not a horizontal stack: a stack measures its children against
                    infinite width, so the title neither wraps nor trims and runs past the
                    card's edge. The starred column is the width it wraps into.
                  -->
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                    <Ellipse Grid.Column="0" Classes="radiodot" />
                    <TextBlock Grid.Column="1"
                               Classes="cardtitle"
                               Text="{Binding Label}"
                               Margin="7,0,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center" />
                  </Grid>
                  <!-- The gap rides on the refusal, so a card carrying only the description carries none. -->
                  <TextBlock Classes="cardbody"
                             Margin="0,0,0,6"
                             IsVisible="{Binding HasReason}"
                             Text="{Binding Reason}" />
                  <TextBlock Classes="cardbody"
                             IsVisible="{Binding HasDetail}"
                             Text="{Binding Detail}" />
                </StackPanel>
              </Button>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasQuantizer}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
          <TextBlock Grid.Column="0" Classes="heading" Text="{Binding Quantizer.Label}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="muted" Text="lower keeps more detail" Margin="10,0,0,0" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="3" Classes="promoted" Text="{Binding Quantizer.Readback}" VerticalAlignment="Bottom" />
        </Grid>

        <!--
          Three zones and one deliberate gap, drawn behind the slider: below the recommended
          band, the band, bare track, then the tail where the picture stops being usable. The
          theme paints no track of its own, so the zones show through under the thumb.
        -->
        <Panel Height="14" Margin="0,9,0,0" IsEnabled="{Binding Quantizer.IsEnabled}">
          <Border Height="6"
                  CornerRadius="{StaticResource RadiusSegment}"
                  ClipToBounds="True"
                  VerticalAlignment="Center"
                  Background="{StaticResource DividerBrush}">
            <!--
              Shares of the scale and not of the H.26x numbers: the track's ends are the codec's, and the
              band sits at the same fraction of every one of them (Setup/Model/QualityLayout.cs, which
              states the same two edges for the labels below).
            -->
            <Grid ColumnDefinitions="35*,12*,16*,37*">
              <Border Grid.Column="0" Background="{StaticResource ChipBorderBrush}" />
              <Border Grid.Column="1" Background="{StaticResource ForegroundBrush}" />
              <Border Grid.Column="3" Background="{StaticResource AttentionBrush}" Opacity="0.25" />
            </Grid>
          </Border>

          <Slider Theme="{StaticResource QuantizerSliderTheme}"
                  Minimum="{Binding Quantizer.Minimum}"
                  Maximum="{Binding Quantizer.Maximum}"
                  Value="{Binding Quantizer.Slide, Mode=TwoWay}" />
        </Panel>

        <!--
          The track's own ratios, repeated rather than one column per label, because a starred
          column is a share of the whole row and not of what is left over: a lone `*` beside
          the first band's 29 is a thirtieth of the width.
        -->
        <Grid ColumnDefinitions="35*,12*,16*,37*" Margin="0,6,0,0">
          <TextBlock Grid.Column="0" Classes="figure" Foreground="{StaticResource HintBrush}" Text="{Binding QuantizerFloorLabel}" />
          <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Classes="figure" Foreground="{StaticResource ForegroundBrush}" Text="{Binding QuantizerBandLabel}" />
          <TextBlock Grid.Column="3" HorizontalAlignment="Right" Classes="figure" Foreground="{StaticResource AttentionBrush}" Text="{Binding QuantizerCeilingLabel}" />
        </Grid>

        <TextBlock Classes="hint"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Margin="0,6,0,0"
                   IsVisible="{Binding Quantizer.HasReason}"
                   Text="{Binding Quantizer.Reason}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Selects}" Margin="-5,16,-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:FieldViewModel">
            <StackPanel Margin="5,0,5,12">
              <TextBlock Classes="secondary" Text="{Binding Label}" Margin="0,0,0,6" />

              <Button Theme="{StaticResource SelectFace}"
                      IsEnabled="{Binding IsEnabled}"
                      ToolTip.Tip="{Binding Help}">
                <!--
                  The held value takes the starred column so it trims inside the face. An Auto
                  column measures against infinite width, which pushes the caret out of the
                  button on a long codec name.
                -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0"
                             Classes="ident facevalue"
                             VerticalAlignment="Center"
                             Text="{Binding PickedLabel}" />
                  <ti:TablerIcon Grid.Column="1"
                                 Classes="facecaret"
                                 Icon="IconChevronDown"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="figure"
                             Foreground="{StaticResource HintBrush}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasPickedNote}"
                             Text="{Binding PickedNote}" />
                </Grid>

                <Button.Flyout>
                  <!--
                    The shared entry row (Features/Fields/View/SelectEntry.axaml) carries a
                    refused entry's reason as a line rather than a tip: the row is a disabled
                    MenuItem wherever there is something to explain, and a disabled control
                    takes no pointer events.
                  -->
                  <MenuFlyout ItemsSource="{Binding Options}"
                              ItemTemplate="{StaticResource SelectEntry}"
                              ItemContainerTheme="{StaticResource SelectMenuItem}"
                              Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>

              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasReason}"
                         Text="{Binding Reason}" />
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasNote}"
                         Text="{Binding Note}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>

</UserControl>
