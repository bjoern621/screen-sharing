<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fields="using:ScreenShare.App.Features.Fields.ViewModel"
             xmlns:vm="using:ScreenShare.App.Features.Setup.QualityStep.ViewModel"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.QualityStep.View.QualityStepView"
             x:DataType="vm:QualityStepViewModel">

  <!--
    The quality form. Two controls the reader moves - the rate-control card and the quantizer
    - and the read-back row beneath them.

    Every string on this screen arrives in the resolved form. The layout is this file's: cards
    for the choice whose options carry a paragraph each, a banded track for the scale with
    named ends, and a row of dropdowns for the values read back from the source. Which fields
    those are is not written down here - the row draws whatever the group offers as a select
    (docs/ipc-api.md, "The rule").
  -->

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Features/Setup/QualityStep/View/QuantizerSlider.axaml" />
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The radio glyph is a ring that thickens into a dot; there is no second colour in it. -->
    <Style Selector="Ellipse.radiodot">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stroke" Value="{StaticResource HintBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.picked Ellipse.radiodot">
      <Setter Property="Stroke" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="4" />
    </Style>

    <!--
      The closed dropdown's two columns. Stated here rather than in the face's theme because
      the caller supplies them: a ControlTheme may not carry a descendant selector, so the
      only place a rule can reach this text is the file that writes it.
    -->
    <Style Selector="TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
    </Style>
    <Style Selector="ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- The unavailable treatment, on the face's own text: a colour change and nothing else. -->
    <Style Selector="Button:disabled TextBlock.facevalue">
      <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
    </Style>
    <Style Selector="Button:disabled ti|TablerIcon.facecaret">
      <Setter Property="Brush" Value="{DynamicResource DisabledBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    Nothing is drawn before the first resolve, or for a backend that does not describe this
    step. The unreachable backend already says so once, above the column, and a card saying
    it a second time in its own words is the same news twice - the five generic steps hide
    on the same binding (Fields/View/FieldGroupView.axaml).
  -->
  <Border Classes="card" Padding="16,14" IsVisible="{Binding IsResolved}">
    <StackPanel>
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Margin="0,3,0,16"
                 Text="{Binding Help}" />

      <!--
        Rate control. Cards, because each option carries a paragraph the reader compares.

        The grid is left to choose its own shape rather than pinned to one row. Five modes
        across a single row gave each paragraph about a sixth of the column, and a
        three-sentence explanation set thirty characters wide is a paragraph nobody
        compares - it is read as a column of fragments. Unpinned, UniformGrid squares the
        count off, so five modes are three across and two below and each card is wide
        enough to set prose in.

        The card is wrapped, and the wrapper carries the refusal: a disabled control takes
        no pointer events, so a tooltip on the card itself would open on every entry except
        the ones that have something to say.
      -->
      <ItemsControl IsVisible="{Binding HasMode}"
                    IsEnabled="{Binding Mode.IsEnabled}"
                    ItemsSource="{Binding Mode.Options}"
                    Margin="-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:OptionViewModel">
            <Border Background="Transparent" Margin="5,0,5,10" ToolTip.Tip="{Binding Refusal}">
              <Button Theme="{StaticResource OptionCard}"
                      Classes.picked="{Binding IsSelected}"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding Choose}">
                <StackPanel>
                  <!--
                    A grid rather than a horizontal stack, because a stack measures its
                    children against infinite width: the title neither wrapped nor trimmed
                    and simply ran past the card's edge, which is what cut "bit-exact" off
                    mid-word. The starred column is what gives it a width to wrap into.
                  -->
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                    <Ellipse Grid.Column="0" Classes="radiodot" />
                    <TextBlock Grid.Column="1"
                               Classes="cardtitle"
                               Text="{Binding Label}"
                               Margin="7,0,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Classes="cardbody" Text="{Binding Body}" />
                </StackPanel>
              </Button>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Quantizer. The figure is promoted because it is the number the reader is moving. -->
      <StackPanel IsVisible="{Binding HasQuantizer}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
          <TextBlock Grid.Column="0" Classes="heading" Text="{Binding Quantizer.Label}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="muted" Text="lower keeps more detail" Margin="10,0,0,0" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="3" Classes="promoted" Text="{Binding Quantizer.Readback}" VerticalAlignment="Bottom" />
        </Grid>

        <!--
          The track is three zones and one deliberate gap: below the band, the band itself,
          bare track, then the tail where the picture stops being usable. The slider paints no
          track of its own, so the zones show through under the thumb.
        -->
        <Panel Height="14" Margin="0,9,0,0" IsEnabled="{Binding Quantizer.IsEnabled}">
          <Border Height="6"
                  CornerRadius="{StaticResource RadiusSegment}"
                  ClipToBounds="True"
                  VerticalAlignment="Center"
                  Background="{StaticResource DividerBrush}">
            <Grid ColumnDefinitions="29*,12*,22*,37*">
              <Border Grid.Column="0" Background="{StaticResource ChipBorderBrush}" />
              <Border Grid.Column="1" Background="{StaticResource ForegroundBrush}" />
              <Border Grid.Column="3" Background="{StaticResource OnAirBrush}" Opacity="0.25" />
            </Grid>
          </Border>

          <Slider Theme="{StaticResource QuantizerSliderTheme}"
                  Minimum="{Binding Quantizer.Minimum}"
                  Maximum="{Binding Quantizer.Maximum}"
                  Value="{Binding Quantizer.Slide, Mode=TwoWay}" />
        </Panel>

        <Grid ColumnDefinitions="29*,*,Auto" Margin="0,6,0,0">
          <TextBlock Grid.Column="0" Classes="figure" Foreground="{StaticResource HintBrush}" Text="0 — visually lossless, huge" />
          <TextBlock Grid.Column="1" Classes="figure" Foreground="{StaticResource ForegroundBrush}" Text="18–24 recommended for screen content" />
          <TextBlock Grid.Column="2" Classes="figure" Foreground="{StaticResource OnAirBrush}" Text="51 — unusable" />
        </Grid>

        <!-- Why the control is inert, in its place rather than in a log line. -->
        <TextBlock Classes="hint"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Margin="0,6,0,0"
                   IsVisible="{Binding Quantizer.HasReason}"
                   Text="{Binding Quantizer.Reason}" />
      </StackPanel>

      <!--
        The values read back from the source. Each opens: the entries, their trailing
        provenance and the greying of the ones this configuration rules out all arrive in the
        form, so the control offers exactly what the backend would accept.
      -->
      <ItemsControl ItemsSource="{Binding Selects}" Margin="-5,16,-5,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--
              Two across rather than however many the group happens to carry. A label like
              "Colour quantization range" and a value like "HEVC / H.265 (NVIDIA NVENC)"
              both need most of half the column; four of them abreast trimmed every one of
              them to an ellipsis.
            -->
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fields:FieldViewModel">
            <StackPanel Margin="5,0,5,12">
              <TextBlock Classes="secondary" Text="{Binding Label}" Margin="0,0,0,6" />

              <Button Theme="{StaticResource SelectFace}"
                      IsEnabled="{Binding IsEnabled}"
                      ToolTip.Tip="{Binding Help}">
                <!--
                  The held value takes the starred column so it trims inside the face. It
                  used to sit in an Auto column beside the caret, which measures against
                  infinite width: a long codec name pushed the caret out of the button
                  instead of ending in an ellipsis.
                -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0"
                             Classes="ident facevalue"
                             VerticalAlignment="Center"
                             Text="{Binding PickedLabel}" />
                  <ti:TablerIcon Grid.Column="1"
                                 Classes="facecaret"
                                 Icon="IconChevronDown"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="figure"
                             Foreground="{StaticResource HintBrush}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasPickedNote}"
                             Text="{Binding PickedNote}" />
                </Grid>

                <Button.Flyout>
                  <!--
                    The entry, and why it is out where it is out. The row is shared
                    (Features/Fields/View/SelectEntry.axaml): the refusal is a line in it rather than
                    a tooltip on it, because the row is a disabled MenuItem wherever there is
                    something to explain, a disabled control takes no pointer events, and a
                    tooltip that can only open on the entries with nothing to say is worse
                    than none.
                  -->
                  <MenuFlyout ItemsSource="{Binding Options}"
                              ItemTemplate="{StaticResource SelectEntry}"
                              ItemContainerTheme="{StaticResource SelectMenuItem}"
                              FlyoutPresenterTheme="{StaticResource SelectMenu}"
                              Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>

              <!-- Why the control is inert, and what a live one means here that its label does not say. -->
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasReason}"
                         Text="{Binding Reason}" />
              <TextBlock Classes="hint"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,6,0,0"
                         IsVisible="{Binding HasNote}"
                         Text="{Binding Note}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>

</UserControl>
