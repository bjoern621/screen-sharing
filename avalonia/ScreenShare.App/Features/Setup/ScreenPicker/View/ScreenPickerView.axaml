<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ScreenPicker.ViewModel"
             xmlns:model="using:ScreenShare.App.Features.Setup.ScreenPicker.Model"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:tiles="using:ScreenShare.App.Features.Viewer.Tile.View"
             x:Class="ScreenShare.App.Features.Setup.ScreenPicker.View.ScreenPickerView"
             x:DataType="vm:ScreenPickerViewModel">

  <!--
    Picking a screen writes the setting the dropdown below writes, so this is a second way to one value
    rather than a second value.
    Each tile is 216 by 121, the 16:9 a desktop is and the shape the backend scales its previews to:
    Avalonia has no aspect ratio, so both sides are stated.
  -->

  <controls:CardColumn Spacing="{StaticResource GapTight}">

    <ItemsControl ItemsSource="{Binding Screens}" IsVisible="{Binding IsVisible}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="model:ScreenChoice">
          <Button Classes="bare"
                  Command="{Binding Select}"
                  IsEnabled="{Binding IsEnabled}"
                  Margin="0,0,10,10"
                  Padding="0">
            <StackPanel Width="216" Spacing="5">

              <Panel>
                <Border Classes="tile" Height="121">
                  <Panel>
                    <tiles:StreamTile Source="{Binding Tile}" IsVisible="{Binding HasTile}" />

                    <!--
                      Two sentences for a dark tile, from opposite sides.
                      Before there is a tile the row says why:
                      the screen is opening, or the backend refused to read it.
                      Once there is one, the tile's own three take over:
                      read with no picture yet, the reading ended, or this window could not draw what it was handed.
                    -->
                    <SelectableTextBlock Classes="hint"
                                         Text="{Binding Placeholder}"
                                         IsVisible="{Binding HasPlaceholder}"
                                         TextAlignment="Center"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="12" />

                    <SelectableTextBlock Classes="hint"
                                         Text="{Binding Tile.Notice}"
                                         IsVisible="{Binding Tile.HasNotice, FallbackValue=False}"
                                         TextAlignment="Center"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="12" />
                  </Panel>
                </Border>

                <!-- Selection is an outline over the picture: a fill under a filled tile is invisible. -->
                <Border BorderBrush="{StaticResource SelectedBrush}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource RadiusTile}"
                        IsVisible="{Binding IsSelected}" />
              </Panel>

              <TextBlock Classes="caption"
                         Text="{Binding Label}"
                         TextTrimming="CharacterEllipsis" />

              <!-- Under the card and not a tip: a screen that cannot be picked takes no pointer. -->
              <SelectableTextBlock Classes="reason"
                                   IsVisible="{Binding HasReason}"
                                   Text="{Binding Reason}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="hint"
               Text="{Binding Notice}"
               IsVisible="{Binding HasNotice}"
               TextWrapping="Wrap"
               TextTrimming="None" />

  </controls:CardColumn>
</UserControl>
