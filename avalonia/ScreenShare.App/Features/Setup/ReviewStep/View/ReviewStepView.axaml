<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ReviewStep.ViewModel"
             x:Class="ScreenShare.App.Features.Setup.ReviewStep.View.ReviewStepView"
             x:DataType="vm:ReviewStepViewModel">

  <!--
    The terminal step's own column, and only that: the checks, the presets and the commit stand in the rail
    every step draws (Setup/View/SetupView.axaml).
  -->

  <Border Classes="card" Padding="16,14" VerticalAlignment="Top">
    <StackPanel>
      <TextBlock Classes="heading" Text="Review" />
      <TextBlock Classes="secondary"
                 Margin="0,3,0,15"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Text="Everything resolved. Click any row to jump back to the step that owns it." />

      <ItemsControl ItemsSource="{Binding Tiles}" Margin="-5">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReviewTile">
            <Border Classes="panel"
                    BorderBrush="{StaticResource DividerBrush}"
                    CornerRadius="{StaticResource RadiusStrip}"
                    Padding="{StaticResource InsetPanel}"
                    Margin="5">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Classes="caption" Text="{Binding Heading}" />
                  <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Content="Edit" Command="{Binding Edit}" />
                </Grid>
                <TextBlock Classes="ident"
                           LineHeight="{StaticResource LineHeightBody}"
                           TextTrimming="None"
                           Text="{Binding Lines}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>

</UserControl>
