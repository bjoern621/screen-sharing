<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:model="using:ScreenShare.App.Features.Setup.Model"
             xmlns:presets="using:ScreenShare.App.Features.Setup.Presets.View"
             xmlns:view="using:ScreenShare.App.Features.Setup.CostRail.View"
             xmlns:vm="using:ScreenShare.App.Features.Setup.CostRail.ViewModel"
             x:Class="ScreenShare.App.Features.Setup.CostRail.View.CostRailView"
             x:DataType="vm:CostRailViewModel">

  <UserControl.Styles>
    <!-- Ordinary fill hue set here and not on the element: an inline value is a LocalValue outranking every
         style setter, so the overrun below would never paint. -->
    <Style Selector="view|MeterBar">
      <Setter Property="FillBrush" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <!--
      Over the limit the whole fill takes the caution hue: MeterBar clamps nothing at the marker.
      Amber and not red, a setting asking for more than the line measured still publishing.
    -->
    <Style Selector="view|MeterBar.over">
      <Setter Property="FillBrush" Value="{StaticResource CautionBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    One gap for every seam in this column, and the same one the page is inset by, so the cards keep a rhythm
    with the edge they stand against.
    The panel between the cards is what the footer under the rail is set off by too (Setup/View/SetupView.axaml).

    The same column the step forms stack in, so the first card here and the first card there start on one line
    whatever either of them drew (Controls/CardColumn).
  -->
  <controls:CardColumn Spacing="{StaticResource GapPanel}">

    <Border Classes="card" Padding="{StaticResource InsetPanel}" IsVisible="{Binding IsResolved}">
      <StackPanel>
        <TextBlock Classes="caption" Text="Estimated cost" Margin="0,0,0,10" />

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Classes="promoted" Text="{Binding Bitrate}" />
          <TextBlock Grid.Column="1"
                     Classes="secondary"
                     Margin="8,0,0,0"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     VerticalAlignment="Bottom"
                     Text="{Binding BitrateCaption}" />
        </Grid>

        <view:MeterBar Height="11"
                       Margin="0,0,0,6"
                       Classes.over="{Binding IsOverUplink}"
                       Fill="{Binding FillShare}"
                       Limit="{Binding UplinkShare}"
                       TrackHeight="5"
                       TrackBrush="{StaticResource DividerBrush}"
                       LimitBrush="{StaticResource CautionBrush}" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="figure" Foreground="{StaticResource HintBrush}" Text="0" />
          <TextBlock Grid.Column="1" Classes="figure" Foreground="{StaticResource CautionBrush}" Text="{Binding UplinkCaption}" />
        </Grid>

        <Border Classes="dividerh" Margin="0,12" />

        <ItemsControl ItemsSource="{Binding Metrics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CostMetricRow">
              <Grid ColumnDefinitions="*,Auto" Height="{StaticResource TextRowHeight}">
                <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center" Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="ident"
                           Foreground="{StaticResource SecondaryBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasUplink}">
          <Border Classes="dividerh" Margin="0,12" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Classes="secondary"
                       VerticalAlignment="Center"
                       Text="{Binding UplinkLabel}" />
            <TextBlock Grid.Column="1"
                       Classes="ident"
                       Foreground="{StaticResource SecondaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding UplinkFigure}" />
          </Grid>

          <TextBlock Classes="hint"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     Text="{Binding UplinkHint}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="{StaticResource InsetPanel}">
      <StackPanel>
        <TextBlock Classes="caption" Text="Checks before sharing" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="model:PreflightCheckRow">
              <controls:CheckItem Margin="0,0,0,9"
                                  Text="{Binding Text}"
                                  State="{Binding State}"
                                  FixedInStep="{Binding FixedInStep}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          Why no pipeline builds, under the line saying one does not.
          The backend's own sentence and the string a reader has to get into a bug report, so it is selectable
          and wraps rather than trimming (CLAUDE.md, "Every error message is selectable and copyable").
        -->
        <SelectableTextBlock Classes="hint danger"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             LineHeight="{StaticResource LineHeightSmall}"
                             Margin="0,3,0,0"
                             IsVisible="{Binding HasRefusal}"
                             Text="{Binding Refusal}" />
      </StackPanel>
    </Border>

    <presets:PresetsView DataContext="{Binding Presets}" />

  </controls:CardColumn>

</UserControl>
