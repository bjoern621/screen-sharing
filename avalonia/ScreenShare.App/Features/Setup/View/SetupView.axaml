<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ViewModel"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:strip="using:ScreenShare.App.Features.Setup.StepStrip.View"
             xmlns:quality="using:ScreenShare.App.Features.Setup.QualityStep.View"
             xmlns:audio="using:ScreenShare.App.Features.Setup.AudioStep.View"
             xmlns:advanced="using:ScreenShare.App.Features.Setup.AdvancedGroup.View"
             xmlns:rail="using:ScreenShare.App.Features.Setup.CostRail.View"
             xmlns:review="using:ScreenShare.App.Features.Setup.ReviewStep.View"
             xmlns:screens="using:ScreenShare.App.Features.Setup.ScreenPicker.View"
             xmlns:relaycheck="using:ScreenShare.App.Features.Setup.RelayCheck.View"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             xmlns:ti="using:TablerIcons"
             x:Class="ScreenShare.App.Features.Setup.View.SetupView"
             x:DataType="vm:SetupViewModel"
             Background="{StaticResource SurfaceBrush}">

  <DockPanel>

    <!--
      The strip, and the control opening the rail on a window that draws it over the form.
      In the strip's row rather than the footer: it stands on every step, the terminal one included,
      whose footer is the commit card (docs/design-language.md, "Narrow windows").
    -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12,12,0">
      <strip:StepStripView Grid.Column="0" />

      <Button Grid.Column="1"
              Theme="{StaticResource IconButton}"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              IsVisible="{Binding RailColumn.ShowsToggle}"
              Command="{Binding RailColumn.Toggle}"
              ToolTip.Tip="{Binding RailColumn.ToggleTip}">
        <ti:TablerIcon Classes="button" Icon="{Binding RailColumn.ToggleGlyph}" />
      </Button>
    </Grid>

    <!--
      What the backend said when it could not describe the screen,
      so no step can be drawn from anything newer.
      No form is invented in its place (docs/ipc-api.md, "What each side owes").
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,12,12,0"
            IsVisible="{Binding IsUnavailable}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <SelectableTextBlock Grid.Column="0"
                             Classes="hint danger"
                             VerticalAlignment="Center"
                             Text="{Binding Unavailable}" />

        <!--
          The same turning arc a pressed control wears: connecting speaks one vocabulary across this app
          (docs/design-language.md, "Status language").
          The transparent fill is the pointer target the tip opens from, the arc itself taking none.
          Foreground stated and not inherited: an arc outside a templated control has none to inherit,
          and the hue is the sentence's own.
        -->
        <Border Grid.Column="1"
                Background="Transparent"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding IsDialling}"
                ToolTip.Tip="{x:Static copy:Cards.Redialling}">
          <controls:Spinner Foreground="{StaticResource AttentionBrush}" />
        </Border>

        <Button Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Look again"
                Command="{Binding RetryCommand}"
                controls:Pending.IsActive="{Binding RetryCommand.IsRunning}" />
      </Grid>
    </Border>

    <!--
      What the backend said when a setting could not be stored, separate news from the banner above:
      a read that failed leaves an older answer on screen,
      a write that failed leaves what was typed on screen while the backend runs on the value before it.
      Nothing to look again at, so no button (Backend/FormSession.cs).
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,12,12,0"
            IsVisible="{Binding HasUnsaved}">
      <SelectableTextBlock Classes="hint danger" Text="{Binding Unsaved}" />
    </Border>

    <controls:SideColumnPanel Margin="{StaticResource InsetPanel}"
                              Beside="{Binding RailColumn.IsBeside}"
                              SideOnLeft="{Binding RailColumn.IsOnLeft}"
                              SideWidth="{Binding RailColumn.Width}"
                              Gap="{StaticResource GapPanel}">

      <!--
        Every step's form stacks in the one column, and the gap falls between the children that drew something
        (Controls/CardColumn).
        A step placing a component that draws on its own terms above its form is otherwise a step
        whose first card sits a gap lower than the rail beside it.
      -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <controls:CardColumn Spacing="{StaticResource GapPanel}">
          <controls:CardColumn Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsQuality}">
            <quality:QualityStepView DataContext="{Binding Quality}" />
            <advanced:AdvancedGroupView DataContext="{Binding Advanced}" />
          </controls:CardColumn>

          <!--
            The audio group's own layout: one row per source,
            rather than the four controls of every entry drawn with their copy repeated (Setup/AudioStep).
            The wrapper is load-bearing, as on the review step below.
          -->
          <Panel IsVisible="{Binding ShowsAudio}">
            <audio:AudioStepView DataContext="{Binding Audio}" />
          </Panel>

          <!--
            Terminal step's read-back, in the same column every other step's form draws in,
            so the rail beside it is one column rather than a second one per step.
            The wrapper is load-bearing: IsVisible reads this view's model,
            so it cannot sit on the element that hands its DataContext to the child.
          -->
          <Panel IsVisible="{Binding ShowsReview}">
            <review:ReviewStepView DataContext="{Binding Review}" />
          </Panel>

          <!--
            One renderer instanced per group, and the group decides everything on it.
            A hand-written capture screen beside a hand-written encode screen would write down, in this shell,
            what a capture and an encode are (docs/ipc-api.md).
            What the form says about the settings as a whole is in the rail,
            on the card already asking what stands between these settings and sharing
            (CostRail/View/CostRailView.axaml).
          -->
          <controls:CardColumn Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsFields}">

            <!--
              Placed unconditionally and visible on its own terms:
              it draws only on the step holding the screen setting,
              and only where one screen can be read apart from another (Setup/ScreenPicker/ViewModel).
              Above the group rather than in it, the renderer drawing a group in the backend's own order,
              and a picture wedged mid-list would reach into a rendering this view does not own.
            -->
            <screens:ScreenPickerView DataContext="{Binding Screens}" />

            <!--
              No group, no card:
              a form that never arrived leaves the step column empty rather than drawing a frame around nothing.
              The wrapper is load-bearing, as on the review step above.
            -->
            <Panel IsVisible="{Binding CurrentGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
              <fields:FieldGroupView DataContext="{Binding CurrentGroup}" />
            </Panel>

            <!--
              What answers on the relay, placed unconditionally and visible on its own terms like the picker above:
              it draws on the step holding the relay's address and ports,
              which is where a leg nothing reaches is corrected (Setup/RelayCheck).
              Below the group rather than above it, the check being about the values on the card.
            -->
            <relaycheck:RelayCheckView DataContext="{Binding RelayCheck}" />
          </controls:CardColumn>
        </controls:CardColumn>
      </ScrollViewer>

      <!--
        The rail, on every step and in the same order on each: what the draft costs,
        what stands between it and going live, and the saved ways of publishing.
        A column that changed panels per step would make the reader look for the checks again on each one.

        Fixed width beside the form, because the rail prices it:
        a column that reflowed would move the figure being watched while the setting behind it changes.
        Over the form on a window with the width for one column, opened from the strip's control,
        and carrying the footer with it: the two are the column beside the form.
      -->
      <Border Classes.overbody="{Binding !RailColumn.IsBeside}"
              IsVisible="{Binding RailColumn.IsShowing}">

        <!--
          Scrolls on its own, the rail running as long as the settings raise checks,
          and a short window would otherwise push the commit off the bottom.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <rail:CostRailView DataContext="{Binding Rail}" />
        </ScrollViewer>
      </Border>

      <!--
        Foot of the rail: moving between steps, and on the terminal one the commit instead.
        One row for both, so the button that ends the flow stands where the button that walks it does.
        The panel never covers it, an opened rail otherwise taking away the way on
        (Controls/SideColumn/SideColumnPanel.cs).
      -->
      <Panel Margin="0,12,0,0">
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !ShowsReview}">
          <Button Grid.Column="0"
                  Theme="{StaticResource FooterButton}"
                  Content="Back"
                  Command="{Binding BackCommand}"
                  IsVisible="{Binding CanGoBack}" />

          <Button Grid.Column="1"
                  Theme="{StaticResource PrimaryButton}"
                  Height="{StaticResource FooterButtonHeight}"
                  Margin="8,0,0,0"
                  Content="{Binding ContinueLabel}"
                  Command="{Binding ContinueCommand}"
                  IsVisible="{Binding CanContinue}" />
        </Grid>

        <Panel IsVisible="{Binding ShowsReview}">
          <review:CommitCardView DataContext="{Binding Review}" />
        </Panel>
      </Panel>
    </controls:SideColumnPanel>
  </DockPanel>

</UserControl>
