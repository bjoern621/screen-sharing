<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ViewModel"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:strip="using:ScreenShare.App.Features.Setup.StepStrip.View"
             xmlns:quality="using:ScreenShare.App.Features.Setup.QualityStep.View"
             xmlns:drawer="using:ScreenShare.App.Features.Setup.AdvancedDrawer.View"
             xmlns:rail="using:ScreenShare.App.Features.Setup.CostRail.View"
             xmlns:review="using:ScreenShare.App.Features.Setup.ReviewStep.View"
             xmlns:screens="using:ScreenShare.App.Features.Setup.ScreenPicker.View"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             x:Class="ScreenShare.App.Features.Setup.View.SetupView"
             x:DataType="vm:SetupViewModel"
             Background="{StaticResource SurfaceBrush}">

  <DockPanel>
    <strip:StepStripView DockPanel.Dock="Top" Margin="12,12,12,0" />

    <!--
      What the backend said when it could not describe the screen, which is why no step can be
      drawn from anything newer.
      No form is invented in its place (docs/ipc-api.md, "What each side owes").
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,12,12,0"
            IsVisible="{Binding IsUnavailable}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <SelectableTextBlock Grid.Column="0"
                             Classes="hint danger"
                             VerticalAlignment="Center"
                             Text="{Binding Unavailable}" />

        <!--
          The same turning arc a pressed control wears: connecting speaks one vocabulary across this app
          (docs/design-language.md, "Status language").
          The transparent fill is the pointer target the tip opens from, the arc itself taking none.
          Foreground stated and not inherited: an arc outside a templated control has none to inherit, and the
          hue is the sentence's own.
        -->
        <Border Grid.Column="1"
                Background="Transparent"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding IsDialling}"
                ToolTip.Tip="{x:Static copy:Cards.Redialling}">
          <controls:Spinner Foreground="{StaticResource AttentionBrush}" />
        </Border>

        <Button Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Look again"
                Command="{Binding RetryCommand}"
                controls:Pending.IsActive="{Binding RetryCommand.IsRunning}" />
      </Grid>
    </Border>

    <!--
      What the backend said when a setting could not be stored, which is separate news from the
      banner above: a read that failed leaves an older answer on screen, a write that failed
      leaves what was typed on screen while the backend runs on the value before it.
      Nothing to look again at, so no button (Backend/FormSession.cs).
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,12,12,0"
            IsVisible="{Binding HasUnsaved}">
      <SelectableTextBlock Classes="hint danger" Text="{Binding Unsaved}" />
    </Border>

    <Grid Margin="{StaticResource InsetPanel}" ColumnDefinitions="*,Auto">

      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <Panel>
          <StackPanel Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsQuality}">
            <quality:QualityStepView DataContext="{Binding Quality}" />
            <drawer:AdvancedDrawerView DataContext="{Binding Advanced}" />
          </StackPanel>

          <!--
            The terminal step's read-back, in the same column every other step's form draws in, so the rail
            beside it is one column rather than a second one per step.
            The wrapper is load-bearing: IsVisible reads this view's model, so it cannot sit on the element
            that hands its DataContext to the child.
          -->
          <Panel IsVisible="{Binding ShowsReview}">
            <review:ReviewStepView DataContext="{Binding Review}" />
          </Panel>

          <!--
            One renderer instanced per group, and the group decides everything on it.
            A hand-written capture screen beside a hand-written encode screen would be this shell
            writing down what a capture and an encode are (docs/ipc-api.md).
            What the form says about the settings as a whole is in the rail, on the card that
            already asks what stands between these settings and sharing
            (CostRail/View/CostRailView.axaml).
          -->
          <StackPanel Spacing="{StaticResource GapPanel}" IsVisible="{Binding ShowsFields}">

            <!--
              Placed unconditionally and visible on its own terms: it draws only on the step
              holding the screen setting, and only where one screen can be read apart from
              another (Setup/ScreenPicker/ViewModel).
              Above the group rather than in it, since the renderer draws a group in the backend's
              own order and a picture wedged mid-list would reach into a rendering this view does
              not own.
            -->
            <screens:ScreenPickerView DataContext="{Binding Screens}" />

            <!--
              No group, no card: a form that never arrived leaves the step column empty rather than
              drawing a frame around nothing.
              The wrapper is load-bearing, as on the review step above.
            -->
            <Panel IsVisible="{Binding CurrentGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
              <fields:FieldGroupView DataContext="{Binding CurrentGroup}" />
            </Panel>
          </StackPanel>
        </Panel>
      </ScrollViewer>

      <!--
        The rail, on every step and in the same order on each: what the draft costs, what stands between it
        and going live, and the saved ways of publishing.
        A column that changed panels per step would make the reader look for the checks again on each one.

        Fixed width because the rail prices the form beside it: a column that reflowed would move the figure
        being watched while the setting behind it changes.
      -->
      <Grid Grid.Column="1"
            Width="330"
            Margin="12,0,0,0"
            RowDefinitions="*,Auto">

        <!--
          Scrolls on its own, since the rail runs as long as the settings raise checks and a short
          window would otherwise push the commit off the bottom.
        -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
          <rail:CostRailView DataContext="{Binding Rail}" />
        </ScrollViewer>

        <!--
          The foot of the rail: moving between steps, and on the terminal one the commit instead.
          One row for both, so the button that ends the flow stands where the button that walks it does.
        -->
        <Panel Grid.Row="1" Margin="0,12,0,0">
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !ShowsReview}">
            <Button Grid.Column="0"
                    Theme="{StaticResource FooterButton}"
                    Content="Back"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}" />

            <Button Grid.Column="1"
                    Theme="{StaticResource PrimaryButton}"
                    Height="{StaticResource FooterButtonHeight}"
                    Margin="8,0,0,0"
                    Content="{Binding ContinueLabel}"
                    Command="{Binding ContinueCommand}"
                    IsVisible="{Binding CanContinue}" />
          </Grid>

          <Panel IsVisible="{Binding ShowsReview}">
            <review:CommitCardView DataContext="{Binding Review}" />
          </Panel>
        </Panel>
      </Grid>
    </Grid>
  </DockPanel>

</UserControl>
