<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenShare.App.Features.Setup.ViewModel"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:strip="using:ScreenShare.App.Features.Setup.StepStrip.View"
             xmlns:quality="using:ScreenShare.App.Features.Setup.QualityStep.View"
             xmlns:drawer="using:ScreenShare.App.Features.Setup.AdvancedDrawer.View"
             xmlns:rail="using:ScreenShare.App.Features.Setup.CostRail.View"
             xmlns:review="using:ScreenShare.App.Features.Setup.ReviewStep.View"
             xmlns:screens="using:ScreenShare.App.Features.Setup.ScreenPicker.View"
             xmlns:fields="using:ScreenShare.App.Features.Fields.View"
             x:Class="ScreenShare.App.Features.Setup.View.SetupView"
             x:DataType="vm:SetupViewModel"
             Background="{StaticResource SurfaceBrush}">

  <DockPanel>
    <strip:StepStripView DockPanel.Dock="Top" Margin="12,12,12,0" />

    <!--
      What the backend said when it could not describe the screen, which is why no step can be
      drawn from anything newer.
      No form is invented in its place (docs/ipc-api.md, "What each side owes").
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,10,12,0"
            IsVisible="{Binding IsUnavailable}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Classes="hint danger"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="{Binding Unavailable}" />

        <Button Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Look again"
                Command="{Binding RetryCommand}"
                controls:Pending.IsActive="{Binding RetryCommand.IsRunning}" />
      </Grid>
    </Border>

    <!--
      What the backend said when a setting could not be stored, which is separate news from the
      banner above: a read that failed leaves an older answer on screen, a write that failed
      leaves what was typed on screen while the backend runs on the value before it.
      Nothing to look again at, so no button (Backend/FormSession.cs).
    -->
    <Border DockPanel.Dock="Top"
            Classes="panel"
            Padding="12,10"
            Margin="12,10,12,0"
            IsVisible="{Binding HasUnsaved}">
      <TextBlock Classes="hint danger"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Text="{Binding Unsaved}" />
    </Border>

    <Grid Margin="{StaticResource InsetPanel}" ColumnDefinitions="*,Auto">

      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <Panel>
          <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding ShowsQuality}">
            <quality:QualityStepView DataContext="{Binding Quality}" />
            <drawer:AdvancedDrawerView DataContext="{Binding Advanced}" />
          </StackPanel>

          <!--
            One renderer instanced per group, and the group decides everything on it.
            A hand-written capture screen beside a hand-written encode screen would be this shell
            writing down what a capture and an encode are (docs/ipc-api.md).
            What the form says about the settings as a whole is in the rail, on the card that
            already asks what stands between these settings and sharing
            (CostRail/View/CostRailView.axaml).
          -->
          <StackPanel Spacing="{StaticResource GapControl}" IsVisible="{Binding ShowsFields}">

            <!--
              Placed unconditionally and visible on its own terms: it draws only on the step
              holding the screen setting, and only where one screen can be read apart from
              another (Setup/ScreenPicker/ViewModel).
              Above the group rather than in it, since the renderer draws a group in the backend's
              own order and a picture wedged mid-list would reach into a rendering this view does
              not own.
            -->
            <screens:ScreenPickerView DataContext="{Binding Screens}" />

            <fields:FieldGroupView DataContext="{Binding CurrentGroup}" />

            <!-- Why no command preview could be built, in the sentence that would refuse the publish. -->
            <Border Classes="panel" Padding="12,10" IsVisible="{Binding HasCommandError}">
              <TextBlock Classes="hint" TextWrapping="Wrap" TextTrimming="None" Text="{Binding CommandError}" />
            </Border>
          </StackPanel>
        </Panel>
      </ScrollViewer>

      <!--
        Outside the scroller and across both columns, because the review scrolls its own columns
        separately to keep the commit on screen.
        The wrapper is load-bearing: IsVisible reads this view's model, so it cannot sit on the
        element that hands its DataContext to the child.
      -->
      <Panel Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding ShowsReview}">
        <review:ReviewStepView DataContext="{Binding Review}" />
      </Panel>

      <!--
        Fixed width because the rail prices the form beside it: a column that reflowed would move
        the figure being watched while the setting behind it changes.
        It stands aside on the review, which carries its own checks and its own commit.
      -->
      <Grid Grid.Column="1"
            Width="330"
            Margin="10,0,0,0"
            RowDefinitions="*,Auto"
            IsVisible="{Binding IsRailVisible}">

        <!--
          Scrolls on its own, since the rail runs as long as the settings raise checks and a short
          window would otherwise push the commit buttons off the bottom.
        -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
          <rail:CostRailView DataContext="{Binding Rail}" />
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
          <Button Grid.Column="0"
                  Theme="{StaticResource FooterButton}"
                  Content="Back"
                  Command="{Binding BackCommand}"
                  IsVisible="{Binding CanGoBack}" />

          <Button Grid.Column="1"
                  Theme="{StaticResource PrimaryButton}"
                  Height="{StaticResource FooterButtonHeight}"
                  Margin="8,0,0,0"
                  Content="{Binding ContinueLabel}"
                  Command="{Binding ContinueCommand}"
                  IsVisible="{Binding CanContinue}" />
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>

</UserControl>
