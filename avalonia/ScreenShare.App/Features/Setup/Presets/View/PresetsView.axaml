<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:copy="using:ScreenShare.App.Copy"
             xmlns:ti="using:TablerIcons"
             xmlns:vm="using:ScreenShare.App.Features.Setup.Presets.ViewModel"
             x:Class="ScreenShare.App.Features.Setup.Presets.View.PresetsView"
             x:DataType="vm:PresetsViewModel">

  <Border Classes="card" Padding="{StaticResource InsetPanel}">
    <StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="caption" Text="Presets" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Theme="{StaticResource IconButton}"
                Command="{Binding RereadCommand}"
                ToolTip.Tip="{Binding RereadTip}"
                controls:Pending.IsActive="{Binding RereadCommand.IsRunning}">
          <ti:TablerIcon Classes="button" Icon="IconRefresh" />
        </Button>
      </Grid>

      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 LineHeight="{StaticResource LineHeightSmall}"
                 Margin="0,0,0,10"
                 Text="{Binding Covers}" />

      <ItemsControl ItemsSource="{Binding Builtin}" Margin="0,0,0,10">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BuiltinPresetRow">
            <StackPanel Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{StaticResource GapTight}"
                    Height="{StaticResource ControlHeight}">
                <Ellipse Grid.Column="0"
                         Width="{StaticResource DotSize}"
                         Height="{StaticResource DotSize}"
                         VerticalAlignment="Center"
                         Fill="{StaticResource ForegroundBrush}"
                         IsVisible="{Binding IsCurrent}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsEnabled="{Binding IsReachable}"
                           Text="{Binding Name}" />

                <Button Grid.Column="2"
                        Theme="{StaticResource LinkButton}"
                        Content="Apply"
                        IsEnabled="{Binding IsReachable}"
                        Command="{Binding Apply}" />
              </Grid>

              <!-- In the row and not a tip: a disabled control takes no pointer, so a tip on it never opens. -->
              <SelectableTextBlock Classes="hint"
                                   LineHeight="{StaticResource LineHeightSmall}"
                                   IsVisible="{Binding !IsReachable}"
                                   Text="{Binding Reason}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="caption" Text="Saved" Margin="0,0,0,6" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PresetRow">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="{StaticResource GapTight}"
                  Height="{StaticResource ControlHeight}">
              <Ellipse Grid.Column="0"
                       Width="{StaticResource DotSize}"
                       Height="{StaticResource DotSize}"
                       VerticalAlignment="Center"
                       Fill="{StaticResource ForegroundBrush}"
                       IsVisible="{Binding IsCurrent}" />

              <TextBlock Grid.Column="1"
                         Classes="ident"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Name}" />

              <Button Grid.Column="2"
                      Theme="{StaticResource LinkButton}"
                      Content="Apply"
                      Command="{Binding Apply}" />

              <Button Grid.Column="3"
                      Theme="{StaticResource IconButton}"
                      Command="{Binding Delete}"
                      ToolTip.Tip="Delete this preset"
                      controls:Pending.IsActive="{Binding Delete.IsRunning}">
                <ti:TablerIcon Classes="button" Icon="IconTrash" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="hint"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 LineHeight="{StaticResource LineHeightSmall}"
                 IsVisible="{Binding IsEmpty}"
                 Text="{Binding Empty}" />

      <SelectableTextBlock Classes="hint"
                           LineHeight="{StaticResource LineHeightSmall}"
                           Margin="0,6,0,0"
                           IsVisible="{Binding HasNotice}"
                           Text="{Binding Notice}" />

      <SelectableTextBlock Classes="hint danger"
                           LineHeight="{StaticResource LineHeightSmall}"
                           Margin="0,6,0,0"
                           IsVisible="{Binding HasRefusal}"
                           Text="{Binding Refusal}" />

      <!--
        That the window is still dialling, under the refusal saying it could not be reached.
        Under and left-aligned rather than beside: the card is a rail's width and the sentence wraps over it.
        The transparent fill is the pointer target the tip opens from, the arc itself taking none.
      -->
      <Border Background="Transparent"
              HorizontalAlignment="Left"
              Margin="0,6,0,0"
              IsVisible="{Binding IsDialling}"
              ToolTip.Tip="{x:Static copy:Cards.Redialling}">
        <controls:Spinner Foreground="{StaticResource AttentionBrush}" />
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBox Grid.Column="0"
                 PlaceholderText="Name this configuration"
                 Text="{Binding Name, Mode=TwoWay}" />

        <Button Grid.Column="1"
                Margin="8,0,0,0"
                Theme="{StaticResource ActionButton}"
                Content="{Binding SaveLabel}"
                Command="{Binding SaveCommand}"
                controls:Pending.IsActive="{Binding SaveCommand.IsRunning}" />
      </Grid>

    </StackPanel>
  </Border>

</UserControl>
