<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fields="using:ScreenShare.App.Features.Setup.Fields.ViewModel"
                    xmlns:ti="using:TablerIcons">

  <!--
    One row of an opened dropdown: what the entry is called, whether it is the one held, what
    it was derived from, and the paragraph behind it where it has one.

    It sits here rather than in Controls/Select because it is not part of the control. The
    select's themes are written against no item type at all - deliberately, so a dropdown is
    a dropdown whatever it lists - and this row is written against the form's option, which
    is this feature's. Naming that type from a generic control would point the design system
    at a screen.

    It is one template and not one per caller for the reason the switch is one control: the
    quality step's read-back row, the generic renderer's ladder and the advanced table's all
    list the same thing, and three copies of a row drift into three rows.

    Merged into the application's resources (App.axaml) rather than included by each of the
    three, because all three reach it from inside a DataTemplate: what a template resolves
    against is the scope above the control it is instantiated on, and the only scope above
    all three is the application's.
  -->

  <DataTemplate x:Key="SelectEntry" x:DataType="fields:OptionViewModel">
    <StackPanel MinWidth="260" MaxWidth="380" Spacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0"
                   Classes="ident"
                   Text="{Binding Label}"
                   VerticalAlignment="Center" />
        <ti:TablerIcon Grid.Column="1"
                       Icon="IconCheck"
                       Brush="{StaticResource ForegroundBrush}"
                       Margin="8,0,0,0"
                       IsVisible="{Binding IsSelected}"
                       VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Classes="figure"
                   Foreground="{StaticResource HintBrush}"
                   Margin="16,0,0,0"
                   IsVisible="{Binding HasNote}"
                   Text="{Binding Note}"
                   VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="cardbody"
                 IsVisible="{Binding HasBody}"
                 Text="{Binding Body}" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
