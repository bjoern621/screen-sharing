<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScreenShare.App.Controls"
             xmlns:model="using:ScreenShare.App.Features.Insights.HeaderStats.Model"
             xmlns:vm="using:ScreenShare.App.Features.Insights.HeaderStats.ViewModel"
             x:Class="ScreenShare.App.Features.Insights.HeaderStats.View.HeaderStatsView"
             x:DataType="vm:HeaderStatsViewModel">

  <DockPanel VerticalAlignment="Center">

    <controls:StatusPill DockPanel.Dock="Left"
                         Label="Sharing"
                         Detail="{Binding Elapsed}"
                         IsVisible="{Binding IsSharing}"
                         VerticalAlignment="Center" />

    <!--
      Which promise and which leg the stream is on, "Balanced over SRT".
      The relaunch walks a followed preset's transports, so the leg in use is a real question,
      and it is answered here rather than left to the settings screen.
    -->
    <TextBlock DockPanel.Dock="Left"
               Classes="hint"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               IsVisible="{Binding HasWay}"
               Text="{Binding Way}" />

    <!--
      A stream between attempts keeps the pill, so this is what tells it apart from one carrying frames.
      In the red rather than the caution hue: a relaunch is a stream that stopped, on its way back.

      The counter says which attempt and the two lines under it say why,
      in this app's words and then in the pipeline's own.
      Both wrap and both are selectable: the raw line is what a reader takes to a search box,
      and trimming would cut away the characters they came for.

      A ceiling on the width, because this block shares the band with the promoted figures
      and a pipeline's last words run long.
    -->
    <StackPanel DockPanel.Dock="Left"
                MaxWidth="330"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Spacing="{StaticResource GapTight}"
                IsVisible="{Binding IsRetrying}">
      <TextBlock Classes="figure"
                 Foreground="{StaticResource AttentionBrush}"
                 Text="{Binding Retry}" />
      <SelectableTextBlock Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasRetryCause}"
                           Text="{Binding RetryCause}" />
      <SelectableTextBlock Classes="transcript hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasRetryMessage}"
                           Text="{Binding RetryMessage}" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Figures}" Margin="6,0,0,0" VerticalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <!--
            Wrapped rather than stacked: this control gets whatever width the live actions leave over.
            The full row is wider than that near the window's smallest size, and stacked figures land off the edge.
          -->
          <WrapPanel ItemSpacing="{StaticResource GapControl}"
                     LineSpacing="{StaticResource GapTight}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="model:StatFigure">
          <!--
            Transparent fill is the pointer target the tip opens from, and a null note opens nothing.
            Bottom alignment stands in for baseline alignment, which Avalonia's stack panels do not offer.
          -->
          <Border Background="Transparent" ToolTip.Tip="{Binding Note}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapTight}">
              <TextBlock Classes="promoted" Text="{Binding Value}" VerticalAlignment="Bottom" />
              <TextBlock Classes="unit" Text="{Binding Unit}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </DockPanel>
</UserControl>
