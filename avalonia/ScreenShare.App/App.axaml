<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScreenShare.App.App"
             RequestedThemeVariant="Dark">

  <!--
    Order is load-bearing: the token dictionaries define the values every theme below them
    asks for, so the control themes come after them.

    Nothing outside Design/ states a colour, a size or a font.
    A component names the role it wants, which keeps a light variant a second Palette rather
    than a sweep through every view (docs/design-language.md).
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Design/Palette.axaml" />
        <ResourceInclude Source="/Design/Typography.axaml" />
        <ResourceInclude Source="/Design/Metrics.axaml" />
        <ResourceInclude Source="/Design/Buttons.axaml" />
        <ResourceInclude Source="/Design/Inputs.axaml" />
        <ResourceInclude Source="/Design/Menus.axaml" />
        <ResourceInclude Source="/Design/Scrolling.axaml" />
        <ResourceInclude Source="/Design/Tooltips.axaml" />
        <ResourceInclude Source="/Controls/Chip/Chip.axaml" />
        <ResourceInclude Source="/Controls/Spinner/Spinner.axaml" />
        <ResourceInclude Source="/Controls/StatusPill/StatusPill.axaml" />
        <ResourceInclude Source="/Controls/CheckItem/CheckItem.axaml" />
        <ResourceInclude Source="/Controls/Segmented/Segmented.axaml" />
        <ResourceInclude Source="/Controls/Select/Select.axaml" />
        <ResourceInclude Source="/Controls/NumberSelect/NumberSelect.axaml" />
        <ResourceInclude Source="/Controls/Toggle/Toggle.axaml" />
        <!--
          The form's option row rather than design.
          A resource a DataTemplate instantiates against has to sit above every view that
          instantiates it, and this is the one scope above all three views that list options.
        -->
        <ResourceInclude Source="/Features/Fields/View/SelectEntry.axaml" />
        <!-- One control of the form, drawn by the whole group and by the advanced part of the quality group. -->
        <ResourceInclude Source="/Features/Fields/View/FieldRow.axaml" />
        <!-- One row of the audio source list draws it twice, and a row is itself a DataTemplate. -->
        <ResourceInclude Source="/Features/Setup/AudioStep/View/AudioSelect.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--
      Fluent underneath, so a control this design has not restyled still behaves and still
      looks like it belongs.
      Everything the design states overrides it below.
    -->
    <FluentTheme />
    <StyleInclude Source="/Design/Text.axaml" />
    <StyleInclude Source="/Design/Surfaces.axaml" />
    <StyleInclude Source="/Design/Icons.axaml" />
    <StyleInclude Source="/Design/Pointer.axaml" />
    <!--
      Last of the design styles: it overrides a control's own content while a call that
      control started is in flight (Controls/Pending/Pending.cs).
    -->
    <StyleInclude Source="/Design/Pending.axaml" />
  </Application.Styles>

</Application>
