# Maintainer: Björn Blessin <blessin.bjoern@gmail.com>
#
# ffmpeg and GStreamer are declared dependencies rather than bundled copies,
# what docs/packaging.md picks for every channel with a package manager behind it,
# and what pacman expects.
# The kmsgrab capability is not granted here:
# it is close to root and belongs to the user's decision rather than to an install
# (the note at the end).

pkgname=screen-sharing
pkgver=0.5.0
pkgrel=1
pkgdesc="Self-hosted, high-quality group screen sharing"
arch=('x86_64')
url="https://github.com/bjoern621/screen-sharing"
license=('Apache-2.0')
depends=(
  # Capture, encode and publish on the ffmpeg engine, and the single-stream viewer.
  # One package carries both programs the app spawns, ffmpeg and ffplay.
  'ffmpeg'
  # The shell is a framework-dependent build, so the runtime is the machine's.
  'dotnet-runtime-10.0'
  # The GStreamer publish engine spawns gst-launch-1.0,
  # and the tile grid decodes through the libraries the backend links.
  # Both read the same plugin set.
  'gstreamer'
  'gst-plugins-base'    # videoconvert, and the glupload chain a tile renders through
  'gst-plugins-good'    # rtspsrc, pulsesrc, vp8enc/vp9enc
  'gst-plugins-bad'     # srtsrc/srtsink, mpegtsmux, nvcodec, va, qsv
  'gst-plugins-ugly'    # x264enc, which the publish engine and the encode probe need
  'gst-rtsp-server'     # rtspclientsink: every RTSP publish and test stream
  'gst-libav'           # avdec_h264/avdec_h265: the only decoders for 4:4:4 H.264 and RGB HEVC
  'gst-plugin-rswebrtc'   # whipclientsink: the WHIP publish leg
  'gst-plugin-webrtchttp' # whepsrc: the WHEP watch leg
  'gst-plugin-rsrtp'    # rtpav1pay, which is how AV1 rides RTSP
  'gst-plugin-rav1e'    # rav1enc
  'gst-plugin-pipewire' # pipewiresrc: the portal capture backend
  'libnice'             # ICE for webrtcbin, under both WebRTC legs
  # libEGL and libGL, which the shell's render path resolves by soname rather than links,
  # and which the frame channel imports decoded frames through.
  'libglvnd'
  # The monitor enumerators the backend spawns, one per session type
  # (backend/internal/display, listX11 and listWlrRandr).
  # Without them the enumeration answers one placeholder carrying no geometry,
  # so the setup screen offers a single nameless screen
  # and every monitor past the first is refused.
  # Both are named because either session can be the one running.
  'xorg-xrandr'
  'wlr-randr'
)
# The development files are in the same packages as the runtime,
# so what the cgo build compiles against comes from depends.
# Only the two toolchains are build-only.
# imagemagick draws the icon down to the sizes hicolor's index declares (package()).
makedepends=('go' 'dotnet-sdk-10.0' 'imagemagick')
# No split debug package.
# Half of what is installed here is a .NET publish output carrying no DWARF to split out,
# and the Fedora spec disables its debuginfo package for the same reason.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The release tarball is generated by the tag,
# so its checksum is unknown while this file is written.
# `updpkgsums` fills it in against a published release.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"

  # backend/internal/receive links GStreamer through cgo.
  # Go turns cgo off by itself when it finds no C compiler,
  # which surfaces as "build constraints exclude all Go files"
  # in packages that look unrelated to the compiler;
  # asking for it outright names the missing compiler instead.
  export CGO_ENABLED=1
  # -buildvcs=false because the source here is a release tarball carrying no revision to stamp.
  # Left on, the compiler looks for one anyway
  # and finds whatever repository the tarball was extracted inside:
  # a build from a checkout, which the release workflow and `makepkg` in a clone both are,
  # then fails outright,
  # makepkg building as its own user and git refusing to read a repository owned by another.
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

  go build -C backend -ldflags "-X main.version=$pkgver" \
    -o ../dist/screenshare-backend ./cmd/backend

  # Framework-dependent: the runtime is a dependency of this package,
  # so the build carries no second copy of it.
  # Both binaries land in one directory, the shell starting the backend from beside itself.
  dotnet publish avalonia/ScreenShare.App/ScreenShare.App.csproj \
    --configuration Release \
    --runtime linux-x64 \
    --self-contained false \
    --output dist
}

package() {
  cd "$pkgname-$pkgver"

  install -dm755 "$pkgdir/usr/lib/$pkgname"
  cp -r dist/. "$pkgdir/usr/lib/$pkgname/"
  chmod 755 "$pkgdir/usr/lib/$pkgname/screenshare-backend" \
            "$pkgdir/usr/lib/$pkgname/screenshare-avalonia"

  # A launcher rather than a symlink into /usr/lib:
  # the shell resolves the backend against its own directory,
  # and a symlinked entry point would answer /usr/bin.
  install -dm755 "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /usr/lib/%s/screenshare-avalonia "$@"\n' "$pkgname" \
    > "$pkgdir/usr/bin/screenshare-avalonia"
  chmod 755 "$pkgdir/usr/bin/screenshare-avalonia"

  install -Dm644 packaging/linux/screen-sharing.desktop \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  # The master is 1024px and hicolor's index declares 48 through 512.
  # A size the index does not name is a directory no lookup walks,
  # so an icon installed at 1024 alone is one a launcher answers with its placeholder.
  for size in 48 64 128 256 512; do
    install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    magick build/appicon.png -resize "${size}x${size}" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
    chmod 644 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done
  install -Dm644 docs/install.md \
    "$pkgdir/usr/share/doc/$pkgname/install.md"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # What the two binaries carry inside them, compiled-in libraries alone:
  # every program this package depends on comes from pacman under its own terms.
  install -Dm644 THIRD-PARTY-NOTICES.md \
    "$pkgdir/usr/share/doc/$pkgname/THIRD-PARTY-NOTICES.md"
}

# Wayland capture goes through the desktop portal and needs no privilege.
# The kmsgrab backend reads the scanout framebuffer straight from DRM,
# which the kernel gates behind CAP_SYS_ADMIN;
# granting that to the shared /usr/bin/ffmpeg would hand every local user
# a capability close to root, so this package grants nothing.
# docs/install.md states the two ways to capture a Wayland desktop without it.
