meta {
  name: Issue member token
  type: http
  seq: 1
}

post {
  url: {{groupService}}/tokens
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "{{groupKey}}",
    "member": "{{memberName}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("memberToken", res.body.token);
  }
}

tests {
  test("answers a token whose subject is the member and whose grant is the group", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.token).to.be.a("string");

    const claims = JSON.parse(atob(res.body.token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")));
    expect(claims.sub).to.be.a("string");
    expect(claims.mediamtx_permissions[0].path).to.contain(bru.getEnvVar("groupPrefix"));
  });
}

docs {
  # Issue member token

  The same trade as `Issue token`, naming a member.

  What moves is the subject, from the group's id to a keyed digest of the member's name under the group's key.
  The relay writes that subject into its session listings and its log lines, which is what lets a roster tell one member's connections from another's, and it carries neither the name nor anything about the key.

  What does not move is the grant. Membership decides who may connect, never what they may reach: a member's token grants publish and read on the group's prefix like any other.

  A member named without a key is refused with 400, a member belonging to a group.
}
