meta {
  name: List public streams
  type: http
  seq: 4
}

get {
  url: {{groupService}}/streams
  body: none
  auth: none
}

tests {
  test("answers the public prefix and the streams under it", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.prefix).to.equal("public/");
    expect(res.body.streams).to.be.an("array");
  });
}

docs {
  # List public streams

  The same index with no key, which answers the public prefix.

  A stream anybody may watch lives under `public/`: the relay grants reading on that prefix to everyone, and this is where a caller holding no key is answered from.
  It has a group id's shape without being one, since no key derives it, so no group's listing can include it and holding a key cannot publish into it.
}
