meta {
  name: RTSP conns
  type: http
  seq: 3
}

get {
  url: {{relayApi}}/v3/rtspconns/list
  body: none
  auth: none
}

tests {
  test("answers a list, or 404 where the listener is off", function () {
    if (res.getStatus() === 404) {
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}

docs {
  # RTSP conns

  The TCP connections on the RTSP listener, which carry the bytes sent and nothing else.

  A reader the path list names as `rtspConn` is described here, and one named `rtspSession` is described by `RTSP sessions`.
  The two are the same viewer seen from either side of the protocol, and the session is the half with packet counters on it.
}
