# direnv / nix dev shell cache
.direnv/

# local logs / binaries
*.log
bin/
# extracted ffmpeg binary distributions (e.g. ffmpeg-7.x-essentials_build/),
# NOT the desktop/internal/ffmpeg source package
ffmpeg-*/

# Wails bindings, regenerated from the Go app by `wails dev` / `wails build`
desktop/frontend/wailsjs/

# MediaMTX's MoQ listener generates a self-signed pair in whatever directory the relay
# runs from, which for `task relay` is this one. Regenerated whenever it is absent, and
# auto.key is a private key, so neither belongs in a commit.
auto.crt
auto.key

# The pre-restructure module directory, which the "restructure" commit replaced with
# desktop/ and left behind untracked. What survives in it is the ffmpeg package as it
# stood then, kept only because two of its files were never committed anywhere.
#
# Anchored to the repository root: an unanchored "app/" matches a directory of that
# name at any depth, which silently swallowed desktop/internal/app.
/app/
